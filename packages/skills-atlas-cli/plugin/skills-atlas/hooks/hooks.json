{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "if command -v skills-atlas >/dev/null 2>&1; then skills-atlas suggest; fi", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/welcome.js\"", "timeout": 10 }
        ]
      }
    ]
  }
}
