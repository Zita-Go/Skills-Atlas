function setupScrollSpy(){
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if(e.isIntersecting){
        const id = e.target.id;
        document.querySelectorAll('.nav-h2').forEach(a => {
          a.classList.toggle('active', a.dataset.target === id);
        });
        // expand parent h1
        const navH2 = document.querySelector(`.nav-h2[data-target="${id}"]`);
        if(navH2){
          const section = navH2.closest('.nav-section');
          if(section && !section.classList.contains('expanded')){
            // 不自动展开，只标记
          }
        }
      }
    });
  }, {rootMargin: '-30% 0px -60% 0px'});
  document.querySelectorAll('.section-h2').forEach(h => observer.observe(h));
}

function drawHeroChart(){
  const svg = document.getElementById('heroChart');
  if(!svg) return;
  // 统计每大类的 group 数
  const slices = DATA.sections.map(h1 => ({
    title: h1.title,
    count: h1.subsections.reduce((sum, h2) => sum + h2.rows.length, 0)
  }));
  const total = slices.reduce((s, x) => s + x.count, 0);
  if(total === 0) return;

  // 13 大类的渐变色（HSL 平均分布）
  const hues = [220, 250, 280, 310, 340, 10, 40, 70, 100, 130, 160, 190, 205];
  const cx=100, cy=100, r=78, ringW=18;
  const TAU = Math.PI * 2;
  let acc = -Math.PI / 2;  // 从 12 点钟开始
  const arcs = [];

  slices.forEach((s, i) => {
    const frac = s.count / total;
    const angle = frac * TAU;
    if(frac < 0.005) { acc += angle; return; }
    const start = acc;
    const end = acc + angle;
    const large = angle > Math.PI ? 1 : 0;
    const x1 = cx + r * Math.cos(start);
    const y1 = cy + r * Math.sin(start);
    const x2 = cx + r * Math.cos(end);
    const y2 = cy + r * Math.sin(end);
    const r2 = r - ringW;
    const x3 = cx + r2 * Math.cos(end);
    const y3 = cy + r2 * Math.sin(end);
    const x4 = cx + r2 * Math.cos(start);
    const y4 = cy + r2 * Math.sin(start);
    const d = `M ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2}`
          + ` L ${x3} ${y3} A ${r2} ${r2} 0 ${large} 0 ${x4} ${y4} Z`;
    const hue = hues[i % hues.length];
    arcs.push(`<path d="${d}" fill="hsl(${hue}, 70%, 65%)" opacity="0.85">
      <title>${s.title}: ${s.count}</title></path>`);
    acc = end;
  });

  // 中心数字
  arcs.push(`<text x="${cx}" y="${cy-6}" text-anchor="middle"
    fill="var(--fg)" font-family="var(--font-sans)" font-size="32" font-weight="700"
    style="letter-spacing:-0.02em">${total}</text>`);
  arcs.push(`<text x="${cx}" y="${cy+14}" text-anchor="middle"
    fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="9" font-weight="500"
    style="letter-spacing:0.1em;text-transform:uppercase">groups</text>`);

  svg.innerHTML = arcs.join('');
}

