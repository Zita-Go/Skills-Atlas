// 落地"从哪开始"三入口
document.querySelectorAll('.start-chip').forEach(c => c.addEventListener('click', () => {
  const a = c.dataset.start;
  if(a === 'ai'){ const b = document.getElementById('aiBtn'); if(b) b.click(); }
  else if(a === 'browse'){ const el = document.getElementById('content'); if(el) el.scrollIntoView({ behavior:'smooth' }); }
  else { const i = document.getElementById('search'); if(i){ i.focus(); i.scrollIntoView({ block:'center' }); } }
}));
setupJumpOffset();

// 让锚点跳转留白 = sticky toolbar 实际高度 + 16（toolbar 换行变高时也不会挡住小节标题）
function setupJumpOffset(){
  const toolbar = document.querySelector('.toolbar');
  if(!toolbar) return;
  const sync = () => {
    const h = toolbar.offsetHeight || 60;
    document.documentElement.style.setProperty('--jump-offset', (h + 16) + 'px');
  };
  sync();
  window.addEventListener('resize', sync);
  // toolbar 自身换行也会改高度（如 filter pills 折行），用 ResizeObserver 兜住
  if(window.ResizeObserver){ new ResizeObserver(sync).observe(toolbar); }
}


// 默认全部展开（让所有子分组立刻可见）
document.querySelectorAll('.nav-section').forEach(s => s.classList.add('expanded'));

// === 锚点跳转 / 浏览器历史 ===
// hash 里是 URL 编码的中文 slug，必须 decode 才能匹配元素 id / data-target
function hashId(){
  try{ return decodeURIComponent((location.hash || '').slice(1)); }
  catch(_){ return (location.hash || '').slice(1); }
}
// 把一次跳转写入浏览器历史（同一目标不重复入栈），供 nav / spotlight 调用
function pushHash(id){
  if(hashId() !== id){ history.pushState(null, '', '#' + id); }
}
// 滚到当前 hash 对应的小节（前进/后退、深链都走这里）
function scrollToHashTarget(behavior){
  const id = hashId();
  if(!id){ window.scrollTo({top:0, behavior: behavior || 'auto'}); return; }
  const el = document.getElementById(id);
  if(!el) return;
  const navH2 = document.querySelector(`.nav-h2[data-target="${id}"]`);
  if(navH2){
    const section = navH2.closest('.nav-section');
    if(section) section.classList.add('expanded');
  }
  el.scrollIntoView({behavior: behavior || 'auto', block:'start'});
}
// 自己管理滚动，避免浏览器默认恢复跟 JS 平滑滚动打架
if('scrollRestoration' in history){ history.scrollRestoration = 'manual'; }
// 前进/后退：滚回对应小节（这就是"按后退回到刚才看的小节"）
window.addEventListener('popstate', () => scrollToHashTarget('smooth'));
// 深链 / 刷新：进页面后定位到 hash 小节
if(location.hash){ requestAnimationFrame(() => scrollToHashTarget('auto')); }
</script>
