// === 力导向图 ===
function buildGraph(){
  const container = document.getElementById('graphView');
  if(container.dataset.built) return;  // 只构建一次
  container.dataset.built = '1';

  const rows = getAllRows();
  // 节点：每个 unique skill；边：同一 row 内所有 skill 两两相连（chain 用红线）
  const nodeMap = new Map();
  const links = [];
  const accentHues = [220, 250, 280, 310, 340, 10, 40, 70, 100, 130, 160, 190, 205];
  const catIdx = new Map(DATA.sections.map((s, i) => [s.title, i]));

  rows.forEach(row => {
    const catI = catIdx.get(row._h1) || 0;
    const hue = accentHues[catI % accentHues.length];
    row.skills.forEach(sk => {
      if(!nodeMap.has(sk)) nodeMap.set(sk, {
        id: sk, count: 0, hue, h1: row._h1, chain: false, sources: row.sources
      });
      const n = nodeMap.get(sk);
      n.count++;
      if(row.chain) n.chain = true;
    });
    // 同 row 内连边
    for(let i=0;i<row.skills.length;i++){
      for(let j=i+1;j<row.skills.length;j++){
        links.push({source: row.skills[i], target: row.skills[j], chain: row.chain});
      }
    }
  });

  const nodes = [...nodeMap.values()];
  const W = container.clientWidth || 1000;
  const H = container.clientHeight || 600;

  // 简化的力导向：随机初始化 + 几次迭代（无 d3，纯 vanilla）
  nodes.forEach(n => {
    n.x = W/2 + (Math.random()-.5)*W*.6;
    n.y = H/2 + (Math.random()-.5)*H*.6;
    n.vx = 0; n.vy = 0;
  });

  function iterate(steps=300){
    const k = 0.012;
    for(let step=0; step<steps; step++){
      // 排斥
      for(let i=0;i<nodes.length;i++){
        for(let j=i+1;j<nodes.length;j++){
          const a = nodes[i], b = nodes[j];
          const dx = a.x-b.x, dy = a.y-b.y;
          const d2 = dx*dx + dy*dy + 0.01;
          const d = Math.sqrt(d2);
          const f = 800 / d2;
          a.vx += dx/d*f; a.vy += dy/d*f;
          b.vx -= dx/d*f; b.vy -= dy/d*f;
        }
      }
      // 吸引（边）
      links.forEach(l => {
        const a = nodeMap.get(l.source), b = nodeMap.get(l.target);
        if(!a || !b) return;
        const dx = b.x-a.x, dy = b.y-a.y;
        const d = Math.sqrt(dx*dx+dy*dy)+.01;
        const f = (d - 60) * (l.chain ? 0.04 : 0.02);
        a.vx += dx/d*f; a.vy += dy/d*f;
        b.vx -= dx/d*f; b.vy -= dy/d*f;
      });
      // 中心引力 + 阻尼
      nodes.forEach(n => {
        n.vx += (W/2 - n.x) * 0.001;
        n.vy += (H/2 - n.y) * 0.001;
        n.vx *= 0.85; n.vy *= 0.85;
        n.x += n.vx * k * 50; n.y += n.vy * k * 50;
        n.x = Math.max(20, Math.min(W-20, n.x));
        n.y = Math.max(20, Math.min(H-20, n.y));
      });
    }
  }
  iterate(250);

  const svgNS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(svgNS, 'svg');
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);

  // 边
  const linkGroup = document.createElementNS(svgNS, 'g');
  links.forEach(l => {
    const a = nodeMap.get(l.source), b = nodeMap.get(l.target);
    if(!a || !b) return;
    const line = document.createElementNS(svgNS, 'line');
    line.setAttribute('x1', a.x); line.setAttribute('y1', a.y);
    line.setAttribute('x2', b.x); line.setAttribute('y2', b.y);
    line.setAttribute('stroke', l.chain ? 'var(--chain)' : 'var(--border-strong)');
    line.setAttribute('stroke-width', l.chain ? 1.5 : 0.8);
    line.classList.add('link');
    if(l.chain) line.classList.add('chain');
    linkGroup.appendChild(line);
  });
  svg.appendChild(linkGroup);

  // 节点
  const nodeGroup = document.createElementNS(svgNS, 'g');
  const tooltip = document.createElement('div');
  tooltip.className = 'tooltip';
  tooltip.style.display = 'none';
  container.appendChild(tooltip);

  nodes.forEach(n => {
    const g = document.createElementNS(svgNS, 'g');
    g.classList.add('node');
    g.setAttribute('transform', `translate(${n.x},${n.y})`);
    const r = 4 + Math.min(8, n.count * 1.5);
    const c = document.createElementNS(svgNS, 'circle');
    c.setAttribute('r', r);
    c.setAttribute('fill', `hsl(${n.hue}, 70%, 65%)`);
    c.setAttribute('stroke', n.chain ? 'var(--chain)' : 'transparent');
    c.setAttribute('stroke-width', '2');
    g.appendChild(c);
    if(n.count >= 2 || n.id.length <= 16){
      const t = document.createElementNS(svgNS, 'text');
      t.classList.add('label');
      t.setAttribute('y', r + 10);
      t.setAttribute('text-anchor', 'middle');
      t.textContent = n.id;
      g.appendChild(t);
    }
    g.addEventListener('mouseenter', e => {
      tooltip.innerHTML = `<b>${escapeHtml(n.id)}</b><br>
        <span style="color:var(--fg-muted)">${escapeHtml(n.h1)}</span><br>
        分组数: ${n.count} ${n.chain ? '· ⛓' : ''}`;
      tooltip.style.display = 'block';
    });
    g.addEventListener('mousemove', e => {
      const rect = container.getBoundingClientRect();
      tooltip.style.left = (e.clientX - rect.left + 12) + 'px';
      tooltip.style.top = (e.clientY - rect.top + 12) + 'px';
    });
    g.addEventListener('mouseleave', () => tooltip.style.display = 'none');
    g.addEventListener('click', () => {
      // 跳回 cards 视图并搜索这个 skill
      document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
      const inp = document.getElementById('search');
      inp.value = n.id; currentSearch = n.id;
      document.getElementById('clearBtn').style.display = 'block';
      const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none';
      applyFilter();
    });
    nodeGroup.appendChild(g);
  });
  svg.appendChild(nodeGroup);

  // 图例
  const legend = document.createElement('div');
  legend.className = 'legend';
  legend.innerHTML = `<b>网络视图</b><br>
    · 节点 = skill，大小按出现次数<br>
    · 颜色 = 所属大类（13 色）<br>
    · 红边 = ⛓ 强绑定关系<br>
    · 点击节点回卡片视图查看`;
  container.appendChild(svg);
  container.appendChild(legend);
}

// === AI 推荐（轻量 TF-IDF + 同义词扩展） ===
const SYNONYMS = {
  'gtm': ['go-to-market','launch','release','发布'],
  '发布': ['launch','gtm','release','上线'],
  '推广': ['marketing','growth','营销','增长'],
  '原型': ['prototype','mockup','原型','实验'],
  '面试': ['interview','面试','candidate','简历'],
  '简历': ['resume','cv','简历'],
  '招聘': ['hire','recruit','招聘'],
  '需求': ['prd','spec','需求文档'],
  'prd': ['spec','需求','requirement'],
  '调试': ['debug','调试','bug','故障'],
  '测试': ['test','tdd','testing','测试'],
  '安全': ['security','audit','审计','漏洞'],
  '部署': ['deploy','部署','上线','ship'],
  '记忆': ['memory','记忆','上下文'],
  '上下文': ['context','memory','context engineering'],
  '抓取': ['scrape','crawl','fetch','抓取'],
  '翻译': ['translate','translation','翻译'],
  '简介': ['readme','文档','documentation'],
  '会议': ['meeting','纪要','transcript'],
  '产品经理': ['pm','product manager','产品'],
  '客户': ['customer','user','user research','用户'],
  '设计': ['design','ui','ux','视觉'],
  'logo': ['logo','brand','identity','品牌'],
};
function expandQuery(q){
  q = q.toLowerCase();
  const tokens = new Set(q.split(/[\s,，。、/]+/).filter(Boolean));
  for(const [k, syns] of Object.entries(SYNONYMS)){
    if(q.includes(k)) syns.forEach(s => tokens.add(s.toLowerCase()));
    syns.forEach(s => { if(q.includes(s.toLowerCase())) tokens.add(k); });
  }
  return [...tokens];
}
function scoreRow(row, queryTokens){
  const text = (row.skills.join(' ') + ' ' + row.group + ' ' + row.description + ' ' +
                row._h1 + ' ' + row._h2).toLowerCase();
  let score = 0;
  queryTokens.forEach(t => {
    if(!t || t.length < 2) return;
    // 完整匹配 group: 高分
    if(row.group.toLowerCase().includes(t)) score += 5;
    // skill 名匹配
    if(row.skills.some(s => s.toLowerCase().includes(t))) score += 4;
    // 描述匹配
    const occurrences = (text.match(new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'g'))||[]).length;
    score += occurrences * 1.5;
    // h1/h2 标题匹配（弱）
    if(row._h1.toLowerCase().includes(t)) score += 1;
    if(row._h2.toLowerCase().includes(t)) score += 1.5;
  });
  // ⛓ 强绑定加成
  if(row.chain) score *= 1.15;
  // star 加权（log 缩放）
  const maxStars = row.sources.reduce((m,s)=> Math.max(m, s.stars||0), 0);
  if(maxStars > 0) score *= (1 + Math.log10(maxStars+1) * 0.04);
  return score;
}
// === LLM BYOK 配置 ===
const LLM_PRESETS = {
  openai:   { baseUrl: 'https://api.openai.com/v1',          model: 'gpt-4o-mini' },
  deepseek: { baseUrl: 'https://api.deepseek.com/v1',        model: 'deepseek-chat' },
  moonshot: { baseUrl: 'https://api.moonshot.cn/v1',         model: 'moonshot-v1-8k' },
  ollama:   { baseUrl: 'http://localhost:11434/v1',          model: 'llama3.1' },
};
const LLM_CFG_KEY = 'skills-atlas:llm-cfg';
function getLLMConfig(){
  try{
    const raw = localStorage.getItem(LLM_CFG_KEY);
    if(!raw) return null;
    const cfg = JSON.parse(raw);
    if(!cfg.apiKey || !cfg.baseUrl || !cfg.model) return null;
    return cfg;
  }catch(e){ return null; }
}
function saveLLMConfig(cfg){
  localStorage.setItem(LLM_CFG_KEY, JSON.stringify(cfg));
}
function clearLLMConfig(){ localStorage.removeItem(LLM_CFG_KEY); }

function buildLLMPrompt(query, candidates){
  const lines = candidates.map((r, i) => {
    const skills = r.skills.join(' / ');
    const desc = (r.description || '').slice(0, 140);
    return `${i+1}. [${r._h1.split('、').slice(-1)[0]} / ${r._h2}] ${r.group} — ${skills}${desc?' :: '+desc:''}`;
  }).join('\n');
  return [
    {role: 'system', content: '你是一个 skill 推荐助手。用户给出一个目标，你从候选列表里挑出最相关的 6-12 个 skill 组合，按相关性从高到低排序，并给每个解释一句为什么。**严格只输出 JSON**，不要 markdown，不要前后缀文字。格式：{"results":[{"index":<候选序号 1-based>,"reason":"<10-30 字中文解释>"}]}。如果完全找不到相关项，返回 {"results":[]}。'},
    {role: 'user', content: `目标：${query}\n\n候选 skill 组合：\n${lines}\n\n返回 JSON。`}
  ];
}

async function callLLMRerank(query, candidates, cfg){
  const url = cfg.baseUrl.replace(/\/+$/,'') + '/chat/completions';
  const body = {
    model: cfg.model,
    messages: buildLLMPrompt(query, candidates),
    temperature: 0.2,
    response_format: { type: 'json_object' }
  };
  const ctrl = new AbortController();
  const timer = setTimeout(() => ctrl.abort(), 30000);
  let resp;
  try{
    resp = await fetch(url, {
      method: 'POST',
      headers: { 'Content-Type':'application/json', 'Authorization':'Bearer '+cfg.apiKey },
      body: JSON.stringify(body),
      signal: ctrl.signal
    });
  } finally { clearTimeout(timer); }
  if(!resp.ok){
    const text = await resp.text().catch(() => '');
    throw new Error(`HTTP ${resp.status}: ${text.slice(0,200)}`);
  }
  const data = await resp.json();
  const content = data.choices?.[0]?.message?.content || '';
  // 容错：有些模型不严格遵守 response_format
  const m = content.match(/\{[\s\S]*\}/);
  if(!m) throw new Error('LLM 返回非 JSON: ' + content.slice(0,120));
  let parsed;
  try{ parsed = JSON.parse(m[0]); }
  catch(e){ throw new Error('JSON 解析失败: ' + e.message); }
  const arr = parsed.results || parsed.recommendations || [];
  if(!Array.isArray(arr)) throw new Error('LLM 返回 results 不是数组');
  // 把 LLM 给的 1-based index 映射回 candidates
  return arr.map(r => {
    const idx = (typeof r.index === 'number' ? r.index : parseInt(r.index, 10)) - 1;
    if(isNaN(idx) || idx < 0 || idx >= candidates.length) return null;
    return { ...candidates[idx], _llmReason: r.reason || '' };
  }).filter(Boolean);
}

