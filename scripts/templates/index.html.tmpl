<script>
const DATA = {{DATA_JSON}};
const H1_ICONS = {"一、软件开发与工程": "⚙️", "二、文档与知识管理": "📄", "三、产品管理（PM）": "🎯", "四、营销 / 增长 / 销售": "📣", "五、设计 / 视觉 / 前端": "🎨", "六、媒体生产": "🎬", "七、数据 / 抓取 / 情报": "🔍", "八、求职 / 个人办公": "💼", "九、通信 / 工具集成": "🔗", "十、创业 / 财务 / 合规": "💰", "十一、学术 / 科研 / 长跑研究": "🔬", "十二、Agent 架构 / Context Engineering": "🧠", "十三、元能力 / Skill 治理": "🛠️"};

// 各大类色温（hue 0-360）：暖色端（橙/红）= 营销 / 创业 / 求职 / 媒体；冷色端（蓝/青/紫）= 工程 / 数据 / Agent
const CAT_HUE = {
  "一、软件开发与工程": 215,        // cool blue
  "二、文档与知识管理": 195,        // cool teal
  "三、产品管理（PM）": 175,        // teal-green
  "四、营销 / 增长 / 销售": 18,     // warm orange
  "五、设计 / 视觉 / 前端": 320,    // warm magenta
  "六、媒体生产": 350,              // warm rose
  "七、数据 / 抓取 / 情报": 235,    // cool indigo
  "八、求职 / 个人办公": 35,        // warm amber
  "九、通信 / 工具集成": 280,       // cool violet
  "十、创业 / 财务 / 合规": 45,     // warm gold
  "十一、学术 / 科研 / 长跑研究": 155, // cool green
  "十二、Agent 架构 / Context Engineering": 255, // cool purple
  "十三、元能力 / Skill 治理": 200  // cool steel
};
const CAT_TONE = {
  "一、软件开发与工程": "cool",
  "二、文档与知识管理": "cool",
  "三、产品管理（PM）": "neutral",
  "四、营销 / 增长 / 销售": "warm",
  "五、设计 / 视觉 / 前端": "warm",
  "六、媒体生产": "warm",
  "七、数据 / 抓取 / 情报": "cool",
  "八、求职 / 个人办公": "warm",
  "九、通信 / 工具集成": "cool",
  "十、创业 / 财务 / 合规": "warm",
  "十一、学术 / 科研 / 长跑研究": "cool",
  "十二、Agent 架构 / Context Engineering": "cool",
  "十三、元能力 / Skill 治理": "cool"
};
function hueOf(h1Title){ return CAT_HUE[h1Title] != null ? CAT_HUE[h1Title] : 220; }
function toneOf(h1Title){ return CAT_TONE[h1Title] || "neutral"; }

function slugify(s){
  return s.replace(/[^\w\u4e00-\u9fff]+/g,'-').replace(/^-|-$/g,'');
}
function escapeHtml(s){
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function escapeAttr(s){
  return escapeHtml(s).replace(/"/g,'&quot;');
}
function formatStars(n){
  if(n == null) return '';
  if(n < 1000) return n.toString();
  if(n < 10000) return (n/1000).toFixed(1).replace(/\.0$/, '') + 'k';
  if(n < 1000000) return Math.round(n/1000) + 'k';
  return (n/1000000).toFixed(1) + 'M';
}
function highlightText(text, query){
  if(!query) return escapeHtml(text);
  const re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')','gi');
  return escapeHtml(text).replace(re, '<span class="highlight">$1</span>');
}

const githubIcon = '<svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2 .37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>';
// GitHub 同款 octicon star-fill (16x16)
const starIcon = '<svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>';

let currentFilter = 'all';
let currentSearch = '';

function buildNav(){
  const nav = document.getElementById('nav');
  let html = '';
  DATA.sections.forEach((h1, i) => {
    const icon = H1_ICONS[h1.title] || '📌';
    const slug = slugify(h1.title);
    const totalRows = h1.subsections.reduce((sum, h2) => sum + h2.rows.length, 0);
    html += `<div class="nav-section" data-h1="${escapeAttr(slug)}">`;
    html += `<div class="nav-h1" data-target="${slug}">`;
    html += `<span class="caret" onclick="event.stopPropagation();toggleNav(this.parentElement.parentElement)">▸</span>`;
    html += `<span class="icon">${icon}</span><span class="nav-h1-title">${escapeHtml(h1.title)}</span>`;
    html += `<span class="count">${totalRows}</span></div>`;
    html += '<div class="nav-h2-wrap">';
    h1.subsections.forEach(h2 => {
      const subSlug = slugify(h2.title);
      html += `<a href="#${slug}--${subSlug}" class="nav-h2" data-target="${slug}--${subSlug}">${escapeHtml(h2.title)}</a>`;
    });
    html += '</div></div>';
  });
  nav.innerHTML = html;

  // 大类点击：跳转 + 自动展开自己 + 折叠其它
  nav.querySelectorAll('.nav-h1').forEach(el => {
    el.addEventListener('click', () => {
      const target = el.dataset.target;
      const targetEl = document.getElementById(target);
      if(targetEl){
        targetEl.scrollIntoView({behavior:'smooth', block:'start'});
        history.replaceState(null, '', '#' + target);
      }
      // 展开自己（不折叠别人——避免用户已经展开的被关掉）
      const section = el.parentElement;
      section.classList.add('expanded');
      // 高亮
      nav.querySelectorAll('.nav-h1').forEach(x => x.classList.remove('active'));
      el.classList.add('active');
      // mobile auto-close
      if(window.innerWidth < 900){
        document.getElementById('sidebar').classList.remove('open');
      }
    });
  });

  // 子项点击：平滑滚动 + 高亮
  nav.querySelectorAll('.nav-h2').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = a.dataset.target;
      const targetEl = document.getElementById(target);
      if(targetEl){
        targetEl.scrollIntoView({behavior:'smooth', block:'start'});
        history.replaceState(null, '', '#' + target);
      }
      nav.querySelectorAll('.nav-h2').forEach(x => x.classList.remove('active'));
      a.classList.add('active');
      if(window.innerWidth < 900){
        document.getElementById('sidebar').classList.remove('open');
      }
    });
  });
}

function toggleNav(section){
  section.classList.toggle('expanded');
}

function buildContent(){
  const root = document.getElementById('content');
  let html = '';
  let totalSkills = 0, totalGroups = 0, totalChains = 0;
  const vendorSet = new Set();

  DATA.sections.forEach(h1 => {
    const icon = H1_ICONS[h1.title] || '📌';
    const slug = slugify(h1.title);
    const hue = hueOf(h1.title);
    const tone = toneOf(h1.title);
    // 统计该大类的 chain 卡片数；>=2 时此 wrapper 标记 has-chain 用于绘连线
    const chainCount = h1.subsections.reduce((s, h2) => s + h2.rows.filter(r => r.chain).length, 0);
    const wrapClass = chainCount >= 2 ? 'h1-wrap has-chain' : 'h1-wrap';
    html += `<section class="${wrapClass}" data-h1-slug="${escapeAttr(slug)}" style="--cat-hue:${hue}" data-chain-count="${chainCount}">`;
    html += `<h2 class="section-h1" id="${slug}"><span class="h1-icon">${icon}</span><span>${escapeHtml(h1.title)}</span><span class="h1-tone" title="色温：${tone}">${tone}</span></h2>`;
    h1.subsections.forEach(h2 => {
      const subSlug = slugify(h2.title);
      const fullId = slug + '--' + subSlug;
      html += `<h3 class="section-h2" id="${fullId}">${escapeHtml(h2.title)} <a class="anchor" href="#${fullId}">#</a></h3>`;
      html += `<div class="cards">`;
      h2.rows.forEach(row => {
        totalGroups++;
        if(row.chain) totalChains++;
        totalSkills += row.skills.length;
        row.sources.forEach(s => vendorSet.add(s.name));

        const skillsHtml = row.skills.map(sk => `<span class="skill-tag">${escapeHtml(sk)}</span>`).join('');
        const sourceCount = row.sources.length;
        const sortedSources = [...row.sources].sort((a,b) => (b.stars||0) - (a.stars||0));
        const sourcesHtml = sortedSources.map(s => {
          const starHtml = (s.stars != null && s.stars > 0)
            ? `<span class="source-stars">${starIcon}${formatStars(s.stars)}</span>` : '';
          return `<a class="source-link" href="${escapeAttr(s.url)}" target="_blank" rel="noopener">${githubIcon}<span>${escapeHtml(s.name)}</span>${starHtml}</a>`;
        }).join('');

        const chainBadge = row.chain ? '<span class="chain-badge">⛓ 强绑定</span>' : '';

        const maxStars = row.sources.reduce((m, s) => Math.max(m, s.stars || 0), 0);
        // data attributes for filtering
        const searchText = (row.skills.join(' ') + ' ' + row.group + ' ' + row.description + ' ' +
                            row.sources.map(s=>s.name).join(' ')).toLowerCase();
        html += `<div class="card${row.chain?' chain':''}"
          data-search="${escapeAttr(searchText)}"
          data-chain="${row.chain}"
          data-skills="${row.skills.length}"
          data-sources="${sourceCount}"
          data-stars="${maxStars}">`;
        html += `<div class="card-head">`;
        html += `<div class="card-skills">${skillsHtml}</div>`;
        html += `<div class="card-group">${chainBadge}<span>${escapeHtml(row.group)}</span></div>`;
        html += `</div>`;
        html += `<div class="card-desc">${escapeHtml(row.description)}</div>`;
        html += `<div class="card-sources">${sourcesHtml}</div>`;
        html += `</div>`;
      });
      html += '</div>';
    });
    html += '</section>';   // /.h1-wrap
  });
  root.innerHTML = html;

  document.getElementById('heroSkillCount').textContent = totalSkills;
  document.getElementById('heroGroupCount').textContent = totalGroups;
  document.getElementById('heroVendorCount').textContent = vendorSet.size;
  document.getElementById('heroChainCount').textContent = totalChains;

  const sr = document.getElementById('statRow');
  sr.innerHTML = `<span class="stat"><b>${totalGroups}</b> 分组</span>
    <span class="stat"><b>${totalSkills}</b> skill</span>
    <span class="stat"><b>${vendorSet.size}</b> 源</span>`;

  // 渲染完后画 ⛓ 连线
  drawChainConnections();
}

// 在每个 has-chain 的 .h1-wrap 容器内，给该大类下所有 chain 卡片绘制左侧 SVG 连线
function drawChainConnections(){
  document.querySelectorAll('.h1-wrap.has-chain').forEach(wrap => {
    // 清掉旧的（重新 layout 时复用）
    wrap.querySelector(':scope > .connection-svg')?.remove();
    const cards = [...wrap.querySelectorAll('.card.chain:not(.hidden)')];
    if(cards.length < 2) return;

    const wrapRect = wrap.getBoundingClientRect();
    const points = cards.map(c => {
      const r = c.getBoundingClientRect();
      return r.top - wrapRect.top + r.height / 2;
    });

    const svgNS = 'http://www.w3.org/2000/svg';
    const svg = document.createElementNS(svgNS, 'svg');
    svg.classList.add('connection-svg');
    svg.setAttribute('viewBox', `0 0 24 ${wrap.scrollHeight}`);
    svg.setAttribute('preserveAspectRatio', 'none');
    svg.setAttribute('aria-hidden', 'true');

    // 主干曲线
    const cx = 12;
    let path = `M ${cx} ${points[0]}`;
    for(let i = 1; i < points.length; i++){
      const prev = points[i-1], cur = points[i];
      const mid = (prev + cur) / 2;
      path += ` C ${cx + 6} ${mid}, ${cx - 6} ${mid}, ${cx} ${cur}`;
    }
    const trunk = document.createElementNS(svgNS, 'path');
    trunk.setAttribute('d', path);
    trunk.classList.add('connection-line');
    svg.appendChild(trunk);

    // 节点圆点
    points.forEach(y => {
      const outer = document.createElementNS(svgNS, 'circle');
      outer.setAttribute('cx', cx); outer.setAttribute('cy', y);
      outer.setAttribute('r', 7); outer.classList.add('connection-node-outer');
      svg.appendChild(outer);
      const c = document.createElementNS(svgNS, 'circle');
      c.setAttribute('cx', cx); c.setAttribute('cy', y);
      c.setAttribute('r', 3.5); c.classList.add('connection-node');
      svg.appendChild(c);
    });
    wrap.insertBefore(svg, wrap.firstChild);
  });
}

// 窗口尺寸变化时重画
let _chainResizeTimer = null;
window.addEventListener('resize', () => {
  clearTimeout(_chainResizeTimer);
  _chainResizeTimer = setTimeout(drawChainConnections, 150);
});

function applyFilter(){
  const cards = document.querySelectorAll('.card');
  const q = currentSearch.toLowerCase();
  let visibleCount = 0;
  cards.forEach(c => {
    let visible = true;
    // filter
    if(currentFilter === 'chain' && c.dataset.chain !== 'true') visible = false;
    if(currentFilter === 'multi-source' && parseInt(c.dataset.sources) < 2) visible = false;
    if(currentFilter === 'single-skill' && parseInt(c.dataset.skills) > 1) visible = false;
    // search
    if(visible && q && !c.dataset.search.includes(q)) visible = false;
    c.classList.toggle('hidden', !visible);
    if(visible) visibleCount++;
  });
  // hide empty subsections
  document.querySelectorAll('.section-h2').forEach(h2 => {
    const cardsWrap = h2.nextElementSibling;
    if(!cardsWrap || !cardsWrap.classList.contains('cards')) return;
    const anyVisible = cardsWrap.querySelector('.card:not(.hidden)');
    h2.classList.toggle('hidden', !anyVisible);
    cardsWrap.classList.toggle('hidden', !anyVisible);
  });
  // hide empty h1
  document.querySelectorAll('.section-h1').forEach(h1 => {
    let next = h1.nextElementSibling;
    let anyVisible = false;
    while(next && !next.classList.contains('section-h1')){
      if(next.classList.contains('section-h2') && !next.classList.contains('hidden')){
        anyVisible = true; break;
      }
      next = next.nextElementSibling;
    }
    h1.classList.toggle('hidden', !anyVisible);
  });
  document.getElementById('emptyState').classList.toggle('hidden', visibleCount > 0);

  // 搜索激活时按 star 排序：在每个 subsection 内重排可见卡片
  if(currentSearch){
    document.querySelectorAll('.cards').forEach(wrap => {
      const visible = [...wrap.querySelectorAll('.card:not(.hidden)')];
      visible.sort((a,b) => (parseInt(b.dataset.stars)||0) - (parseInt(a.dataset.stars)||0));
      visible.forEach(c => wrap.appendChild(c));
    });
  }

  // 更新结果计数
  const countEl = document.getElementById('searchResultCount');
  if(countEl){
    const total = cards.length;
    if(currentSearch || currentFilter !== 'all'){
      countEl.textContent = `${visibleCount} / ${total} 条结果`;
      countEl.style.color = visibleCount > 0 ? 'var(--fg-muted)' : 'var(--warn)';
    } else {
      countEl.textContent = '';
    }
  }

  // 过滤改变可见卡片后重画 ⛓ 连线
  drawChainConnections();
}

function setupSearch(){
  const inp = document.getElementById('search');
  const clearBtn = document.getElementById('clearBtn');
  const kbdHint = document.getElementById('kbdHint');
  const updateUI = () => {
    const has = inp.value.length > 0;
    clearBtn.style.display = has ? 'block' : 'none';
    if(kbdHint) kbdHint.style.display = has ? 'none' : 'block';
  };
  inp.addEventListener('input', e => {
    currentSearch = e.target.value;
    updateUI();
    applyFilter();
  });
  inp.addEventListener('keydown', e => {
    if(e.key === 'Escape'){ inp.value=''; currentSearch=''; updateUI(); applyFilter(); inp.blur(); }
  });
  clearBtn.addEventListener('click', () => {
    inp.value = '';
    currentSearch = '';
    updateUI();
    applyFilter();
    inp.focus();
  });
  // 全局 / 快捷键聚焦
  document.addEventListener('keydown', e => {
    if(e.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){
      e.preventDefault();
      inp.focus();
      inp.select();
    }
  });
}

function setupFilters(){
  document.querySelectorAll('.toolbar .pill').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.toolbar .pill').forEach(x => x.classList.remove('active'));
      p.classList.add('active');
      currentFilter = p.dataset.filter;
      applyFilter();
    });
  });
}

// 收集所有 row（扁平），用于 graph 和 AI 检索
function getAllRows(){
  const rows = [];
  DATA.sections.forEach(h1 => {
    h1.subsections.forEach(h2 => {
      h2.rows.forEach(r => {
        rows.push({...r, _h1: h1.title, _h2: h2.title});
      });
    });
  });
  return rows;
}

// === 视图切换 ===
let currentView = 'cards';
function setupViewSwitch(){
  document.querySelectorAll('#viewSwitch .view-btn').forEach(b => {
    b.addEventListener('click', () => {
      const v = b.dataset.view;
      if(v === currentView) return;
      currentView = v;
      document.querySelectorAll('#viewSwitch .view-btn').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      const isCards = v === 'cards';
      const isRepo = v === 'repo';
      const isGraph = v === 'graph';
      document.getElementById('content').classList.toggle('hidden', !isCards);
      document.querySelector('.hero').classList.toggle('hidden', !isCards);
      document.getElementById('repoView').classList.toggle('hidden', !isRepo);
      document.getElementById('graphView').classList.toggle('hidden', !isGraph);
      // 切回卡片视图时重画连线（容器尺寸可能变了）
      if(isCards) requestAnimationFrame(drawChainConnections);
      if(isRepo) buildRepoView();
      if(isGraph) buildGraph();
      syncSidebarForView();
    });
  });
}

// === 按仓库视图 ===
function buildRepoView(){
  const container = document.getElementById('repoView');
  if(container.dataset.built) return;
  container.dataset.built = '1';

  // 从 DATA.vendors 收集；同时统计每个仓库被引用的 skill row / group
  const repoStats = {};   // id -> {rows: Set, groupNames: Set, h1Set: Set}
  getAllRows().forEach(row => {
    row.sources.forEach(s => {
      if(!repoStats[s.name]) repoStats[s.name] = {rows: 0, groups: new Set(), h1s: new Set()};
      repoStats[s.name].rows += 1;
      repoStats[s.name].groups.add(row.group);
      repoStats[s.name].h1s.add(row._h1);
    });
  });

  // 按 type 分组
  const byType = {};
  Object.entries(DATA.vendors).forEach(([id, v]) => {
    const t = v.type || 'skill';
    if(!byType[t]) byType[t] = [];
    const stats = repoStats[id] || {rows: 0, groups: new Set(), h1s: new Set()};
    byType[t].push({id, ...v, _rows: stats.rows, _groups: stats.groups.size, _h1s: stats.h1s.size});
  });

  // 排序 type：先按数量倒序，再字母序
  const typeOrder = Object.keys(byType).sort((a, b) => {
    const da = byType[a].length, db = byType[b].length;
    return db - da || a.localeCompare(b);
  });

  // 类型 → 中文标签 + 色温 hue（继承类别色温思路：暖工具暖色，工程冷色）
  const TYPE_LABEL = {
    'skill': 'Skill 包',
    'skill-pack': 'Skill 套装',
    'multi-skill-suite': '多 skill 套件',
    'plugin': '插件',
    'cli': 'CLI 工具',
    'cli-framework': 'CLI 框架',
    'cli-mcp': 'CLI / MCP',
    'sdd-framework': 'SDD 框架',
    'python-library': 'Python 库',
    'desktop-app': '桌面应用',
    'video-engine': '视频引擎',
    'extraction-engine': '抽取引擎',
    'marketplace': 'Marketplace',
    'claude-md-template': 'Claude.md 模板'
  };
  const TYPE_HUE = {
    'skill': 215, 'skill-pack': 220, 'multi-skill-suite': 230,
    'plugin': 280, 'cli': 195, 'cli-framework': 200, 'cli-mcp': 205,
    'sdd-framework': 175, 'python-library': 155,
    'desktop-app': 240, 'video-engine': 350, 'extraction-engine': 35,
    'marketplace': 320, 'claude-md-template': 45
  };

  let html = '';
  typeOrder.forEach(t => {
    const repos = byType[t].sort((a, b) => (b.stars || 0) - (a.stars || 0) || a.id.localeCompare(b.id));
    const label = TYPE_LABEL[t] || t;
    const hue = TYPE_HUE[t] != null ? TYPE_HUE[t] : 220;
    const slug = 'repotype-' + slugify(t);
    html += `<section class="repo-type-group" id="${slug}" style="--cat-hue:${hue}">`;
    html += `<h3 class="repo-type-head">`;
    html += `<span>${escapeHtml(label)}</span>`;
    html += `<span class="type-badge">${escapeHtml(t)}</span>`;
    html += `<span class="type-count">${repos.length} 个</span>`;
    html += `</h3>`;
    html += `<div class="repo-grid">`;
    repos.forEach(r => {
      const star = (r.stars != null && r.stars > 0)
        ? `<span class="repo-card-stars">${starIcon}${formatStars(r.stars)}</span>` : '';
      const tags = [
        r._groups > 0 ? `<span class="repo-card-tag">${r._groups} 分组</span>` : '',
        r._h1s > 0 ? `<span class="repo-card-tag">${r._h1s} 大类</span>` : '',
        r.skill_group_count ? `<span class="repo-card-tag">${r.skill_group_count} skill</span>` : ''
      ].filter(Boolean).join('');
      const author = r.author ? `<span class="author">${escapeHtml(r.author)}/</span>` : '';
      const repoName = r.repo || r.id;
      html += `<div class="repo-card" data-repo="${escapeAttr(r.id)}" style="--cat-hue:${hue}">`;
      html += `<div class="repo-card-head">`;
      html += `<div class="repo-card-name">${author}${escapeHtml(repoName)}</div>`;
      html += star;
      html += `</div>`;
      if(tags) html += `<div class="repo-card-meta">${tags}</div>`;
      html += `<a class="repo-card-link" href="${escapeAttr(r.url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">${githubIcon}<span>查看仓库</span></a>`;
      html += `</div>`;
    });
    html += `</div></section>`;
  });

  container.innerHTML = html;

  // 点击仓库卡片：切回功能视图并把搜索锁到该仓库 id
  container.querySelectorAll('.repo-card').forEach(c => {
    c.addEventListener('click', () => {
      const repoId = c.dataset.repo;
      // 切到 cards 视图
      document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
      const inp = document.getElementById('search');
      inp.value = repoId;
      currentSearch = repoId;
      document.getElementById('clearBtn').style.display = 'block';
      const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none';
      applyFilter();
      window.scrollTo({top: 0, behavior: 'smooth'});
    });
  });

  // 同步侧边栏导航
  buildRepoNav(typeOrder, byType, TYPE_LABEL);
}

// 在切到 repo 视图时把侧边栏 nav 切成仓库列表（单独一个 nav 容器，叠在原 nav 上方/替换）
function buildRepoNav(typeOrder, byType, TYPE_LABEL){
  // 直接复用 #nav；用一个内部容器 #navRepo 表示 repo 模式
  const nav = document.getElementById('nav');
  if(nav.dataset.repoBuilt) return;
  nav.dataset.repoBuilt = '1';
  // 创建 navRepo 容器并追加（默认 hidden）
  let navRepo = document.getElementById('navRepo');
  if(!navRepo){
    navRepo = document.createElement('div');
    navRepo.id = 'navRepo';
    navRepo.className = 'hidden';
    nav.parentElement.appendChild(navRepo);
  }
  let html = '';
  typeOrder.forEach(t => {
    const label = TYPE_LABEL[t] || t;
    const slug = 'repotype-' + slugify(t);
    html += `<div class="nav-repo-type expanded" data-target="${slug}">`;
    html += `<div class="nav-repo-type-head">`;
    html += `<span class="caret">▸</span>`;
    html += `<span>${escapeHtml(label)}</span>`;
    html += `<span class="badge">${byType[t].length}</span>`;
    html += `</div>`;
    html += `<div class="nav-repo-list">`;
    byType[t].slice(0, 30).forEach(r => {
      html += `<a class="nav-repo-item" data-repo="${escapeAttr(r.id)}" data-target="${slug}" title="${escapeAttr(r.author + '/' + (r.repo || r.id))}">${escapeHtml(r.id)}</a>`;
    });
    html += `</div></div>`;
  });
  navRepo.innerHTML = html;

  // 折叠/展开
  navRepo.querySelectorAll('.nav-repo-type-head').forEach(h => {
    h.addEventListener('click', () => h.parentElement.classList.toggle('expanded'));
  });
  // 单条点击：滚到对应 type group
  navRepo.querySelectorAll('.nav-repo-item').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = a.dataset.target;
      const el = document.getElementById(target);
      if(el) el.scrollIntoView({behavior:'smooth', block:'start'});
      navRepo.querySelectorAll('.nav-repo-item').forEach(x => x.classList.remove('active'));
      a.classList.add('active');
    });
  });
}

