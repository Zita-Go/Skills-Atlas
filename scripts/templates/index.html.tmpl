function buildNav(){
  const nav = document.getElementById('nav');
  let html = '';
  DATA.sections.forEach((h1, i) => {
    const icon = h1.icon || H1_ICONS[h1.title] || '📌';
    const slug = slugify(h1.title);
    const totalRows = h1.subsections.reduce((sum, h2) => sum + h2.rows.length, 0);
    html += `<div class="nav-section" data-h1="${escapeAttr(slug)}">`;
    html += `<div class="nav-h1" data-target="${slug}">`;
    html += `<span class="caret" onclick="event.stopPropagation();toggleNav(this.parentElement.parentElement)">▸</span>`;
    html += `<span class="icon">${icon}</span><span class="nav-h1-title">${escapeHtml(pickT(h1.title_en, h1.title))}</span>`;
    html += `<span class="count">${totalRows}</span></div>`;
    html += '<div class="nav-h2-wrap">';
    h1.subsections.forEach(h2 => {
      const subSlug = slugify(h2.title);
      const subName = pickT(h2.title_en, h2.title);
      html += `<a href="#${slug}--${subSlug}" class="nav-h2" data-target="${slug}--${subSlug}" title="${escapeAttr(subName)}"><span class="nav-h2-name">${escapeHtml(subName)}</span><span class="nav-h2-count">${h2.rows.length}</span></a>`;
    });
    html += '</div></div>';
  });
  nav.innerHTML = html;

  // 大类点击：跳转 + 自动展开自己 + 折叠其它
  nav.querySelectorAll('.nav-h1').forEach(el => {
    el.addEventListener('click', () => {
      const target = el.dataset.target;
      const targetEl = document.getElementById(target);
      if(targetEl){
        smoothScrollToEl(targetEl);
        pushHash(target);
      }
      // 展开自己（不折叠别人——避免用户已经展开的被关掉）
      const section = el.parentElement;
      section.classList.add('expanded');
      // 高亮
      nav.querySelectorAll('.nav-h1').forEach(x => x.classList.remove('active'));
      el.classList.add('active');
      // mobile auto-close
      if(window.innerWidth < 900){
        document.getElementById('sidebar').classList.remove('open');
      }
    });
  });

  // 子项点击：平滑滚动 + 高亮
  nav.querySelectorAll('.nav-h2').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = a.dataset.target;
      const targetEl = document.getElementById(target);
      if(targetEl){
        smoothScrollToEl(targetEl);
        pushHash(target);
      }
      nav.querySelectorAll('.nav-h2').forEach(x => x.classList.remove('active'));
      a.classList.add('active');
      if(window.innerWidth < 900){
        document.getElementById('sidebar').classList.remove('open');
      }
    });
  });
}

function toggleNav(section){
  section.classList.toggle('expanded');
}

// 许可证分级：宽松 / copyleft / 限制性(商用受限·非商用) / 未声明 —— 决定徽章样式与提示
const LIC_COPYLEFT = ['GPL-3.0','GPL-2.0','AGPL-3.0','LGPL-3.0','MPL-2.0','CC-BY-SA-4.0'];
const LIC_RESTRICT = ['Elastic-2.0','BUSL-1.1','SSPL-1.0','CC-BY-NC-4.0','CC-BY-NC-SA-4.0','PolyForm-Noncommercial-1.0.0','Remotion License','MIT + Commons Clause'];
const PERSONA_EN = {'工程':'Engineering','PM':'PM','设计':'Design','营销':'Marketing','创始人':'Founder','研究':'Research','运营':'Ops','求职':'Job-seeker','通用':'General'};
function personaLabel(p){ return (LANG === 'en' && PERSONA_EN[p]) ? PERSONA_EN[p] : p; }
function licMeta(spdx){
  const en = LANG === 'en';
  if(!spdx) return { cls:'unknown', label: en?'unknown':'未声明', note: en?'No upstream license declared; check the repo before use':'上游未声明许可证，使用前请到仓库确认' };
  if(LIC_RESTRICT.includes(spdx)) return { cls:'restrict', label:spdx, note: en?(/NC|PolyForm/.test(spdx)?'⚠ Non-commercial only':'⚠ Commercial use restricted'):(/NC|PolyForm/.test(spdx)?'⚠ 非商用许可':'⚠ 商用受限') };
  if(LIC_COPYLEFT.includes(spdx)) return { cls:'copyleft', label:spdx, note: en?'copyleft: derivatives must stay same license':'copyleft：衍生作品需以同协议开源' };
  return { cls:'ok', label:spdx, note: en?'permissive open-source':'宽松开源协议' };
}
function installPrereq(cmd){
  if(!cmd) return '';
  const en = LANG === 'en';
  if(cmd.startsWith('npx ')) return en?'Needs Node.js ≥18. Open a terminal and paste the command; it installs to ~/.claude/skills/.':'需 Node.js ≥18。在终端粘贴运行；会装到 ~/.claude/skills/。';
  if(cmd.startsWith('npm ')) return en?'Needs Node.js + npm. Paste in a terminal.':'需 Node.js + npm。粘到终端运行。';
  if(cmd.startsWith('pip ')) return en?'Needs Python 3 + pip. Paste in a terminal.':'需 Python 3 + pip。粘到终端运行。';
  if(cmd.startsWith('/plugin')) return en?'Run this slash command inside Claude Code (add the marketplace, then /plugin install).':'在 Claude Code 里运行此斜杠命令（先加 marketplace，再 /plugin install 选具体插件）。';
  if(cmd.startsWith('git clone')) return en?'Needs git. After cloning, follow the repo README.':'需 git。clone 后按仓库 README 使用。';
  if(cmd.startsWith('#')) return en?'Follow the instruction manually.':'按提示手动操作。';
  return en?'Paste in a terminal.':'粘到终端运行。';
}
function daysSince(iso){ try{ return Math.floor((Date.now() - new Date(iso).getTime())/864e5); }catch(_){ return null; } }
// 过滤框搜索：每个词需子串命中（多词 AND）。
// 不用模糊子序列——它会让「prd」这类 3 字母词命中几乎所有卡片（180/185），过滤失效；
// 模糊/容错检索交给 ⌘K 聚光（fuzzyScore 排序），过滤框要可预期地收窄。
function matchSearch(hay, q){
  if(!q) return true;
  return q.split(/\s+/).filter(Boolean).every(t => hay.includes(t));
}

function buildContent(){
  const root = document.getElementById('content');
  let html = '';
  let _ord = 0;   // 卡片原始（策展）顺序，用于「默认」排序复位
  let totalSkills = 0, totalGroups = 0, totalChains = 0;
  const vendorSet = new Set();

  DATA.sections.forEach(h1 => {
    const icon = h1.icon || H1_ICONS[h1.title] || '📌';
    const slug = slugify(h1.title);
    const hue = hueOf(h1.title);
    const tone = toneOf(h1.title);
    // 统计该大类的 chain 卡片数（仅用于信息展示，不再绘制连线）
    const chainCount = h1.subsections.reduce((s, h2) => s + h2.rows.filter(r => r.chain).length, 0);
    html += `<section class="h1-wrap" data-h1-slug="${escapeAttr(slug)}" style="--cat-hue:${hue}" data-chain-count="${chainCount}">`;
    html += `<h2 class="section-h1" id="${slug}"><span class="h1-icon" aria-hidden="true">${icon}</span><span>${escapeHtml(pickT(h1.title_en, h1.title))}</span><span class="h1-tone" title="${t('tone_label')}: ${tone}">${tone}</span></h2>`;
    h1.subsections.forEach(h2 => {
      const subSlug = slugify(h2.title);
      const fullId = slug + '--' + subSlug;
      html += `<h3 class="section-h2" id="${fullId}">${escapeHtml(pickT(h2.title_en, h2.title))} <a class="anchor" href="#${fullId}">#</a></h3>`;
      html += `<div class="cards">`;
      h2.rows.forEach(row => {
        totalGroups++;
        if(row.chain) totalChains++;
        totalSkills += row.skills.length;
        row.sources.forEach(s => vendorSet.add(s.name));

        const skillsHtml = row.skills.map(sk => {
          // Phase 2：若该 skill 有自己的 SKILL.md（扫本行各来源仓库的 skill_docs），标签可点开查看
          let hit = null;
          for(const s of row.sources){
            const v = DATA.vendors[s.name];
            const p = v && v.skill_docs && v.skill_docs[sk];
            if(p){ hit = { v, name: s.name, path: p }; break; }
          }
          if(hit){
            const lic = (hit.v.skill_licenses && hit.v.skill_licenses[sk]) || hit.v.license || '';
            return `<span class="skill-tag has-doc" tabindex="0" role="button" data-act="usage" data-author="${escapeAttr(hit.v.author)}" data-repo="${escapeAttr(hit.v.repo)}" data-branch="${escapeAttr(hit.v.default_branch||'main')}" data-docpath="${escapeAttr(hit.path)}" data-url="${escapeAttr(hit.v.url)}" data-name="${escapeAttr(hit.name)}" data-skill="${escapeAttr(sk)}" data-license="${escapeAttr(lic)}" title="${escapeAttr(LANG === 'en' ? `View SKILL.md for ${sk} (license: ${lic||'unknown'})` : `查看 ${sk} 的 SKILL.md（协议：${lic||'未知'}）`)}">${escapeHtml(sk)}<span class="doc-cue" aria-hidden="true">📖</span></span>`;
          }
          return `<span class="skill-tag">${escapeHtml(sk)}</span>`;
        }).join('');
        const sourceCount = row.sources.length;
        const sortedSources = [...row.sources].sort((a,b) => (b.stars||0) - (a.stars||0));
        const sourcesHtml = sortedSources.map(s => {
          const starHtml = (s.stars != null && s.stars > 0)
            ? `<span class="source-stars">${starIcon}${formatStars(s.stars)}</span>` : '';
          const link = `<a class="source-link" href="${escapeAttr(s.url)}" target="_blank" rel="noopener">${githubIcon}<span>${escapeHtml(s.name)}</span>${starHtml}</a>`;
          const usageBtn = (s.author && s.repo)
            ? `<button class="src-act" data-act="usage" data-author="${escapeAttr(s.author)}" data-repo="${escapeAttr(s.repo)}" data-branch="${escapeAttr(s.default_branch||'main')}" data-docpath="${escapeAttr(s.doc_path||'')}" data-url="${escapeAttr(s.url)}" data-name="${escapeAttr(s.name)}" data-license="${escapeAttr(s.license||'')}" title="${escapeAttr(LANG === 'en' ? `View ${s.name} usage (no GitHub redirect)` : `查看 ${s.name} 的用法（不跳转 GitHub）`)}">${t('usage_btn')}</button>`
            : '';
          const cmd = (s.install && s.install.command) ? s.install.command : '';
          const copyBtn = cmd
            ? `<button class="src-act" data-act="copy" data-cmd="${escapeAttr(cmd)}" title="${escapeAttr(LANG === 'en' ? `Copy install command: ${cmd}` : `复制安装命令：${cmd}`)}">${t('install_btn')}</button>`
            : '';
          const lm = licMeta(s.license);
          const lic = s.license
            ? `<a class="license-badge ${lm.cls}" href="${escapeAttr(s.url)}/blob/${escapeAttr(s.default_branch||'main')}/LICENSE" target="_blank" rel="noopener" title="${escapeAttr(lm.label + '：' + lm.note)}">${escapeHtml(s.license)}${lm.cls==='restrict'?' ⚠':''}</a>`
            : `<span class="license-badge unknown" title="${escapeAttr(LANG === 'en' ? 'No upstream license declared — check the repo before use' : '上游未声明许可证 / 待同步，使用前请到仓库确认')}">${LANG === 'en' ? 'unknown' : '未声明'}</span>`;
          const days = s.last_commit ? daysSince(s.last_commit) : null;
          const staleHtml = (days != null && days > 90)
            ? `<span class="stale-badge" title="${escapeAttr(LANG === 'en' ? `last updated ${days}d ago` : `最后更新 ${days} 天前，可能已停止维护`)}"><span aria-hidden="true">⏳</span> ${Math.round(days/30)}${LANG === 'en' ? 'mo' : '个月未更新'}</span>` : '';
          return `<span class="source-row">${link}${usageBtn}${copyBtn}<span class="source-meta">${lic}${staleHtml}</span></span>`;
        }).join('');

        const chainBadge = row.chain ? `<span class="chain-badge" title="${escapeAttr(t('tt_chain'))}">${t('chain_badge')}</span>` : '';

        const maxStars = row.sources.reduce((m, s) => Math.max(m, s.stars || 0), 0);
        const maxUpd = row.sources.reduce((m, s) => (s.last_commit && s.last_commit > m ? s.last_commit : m), '');
        // data attributes for filtering
        const searchText = (row.skills.join(' ') + ' ' + row.group + ' ' + (row.group_en||'') + ' ' + row.description + ' ' +
                            (row.use_case||'') + ' ' + (row.use_case_en||'') + ' ' + (row.py||'') + ' ' +
                            row.sources.map(s=>s.name).join(' ')).toLowerCase();
        // 整卡可点的"主用法"：第一个有独立 SKILL.md 的 skill；否则退到第一来源的仓库 README
        let cardP = null;
        for(const sk of row.skills){
          for(const s of row.sources){
            const v = DATA.vendors[s.name];
            const p = v && v.skill_docs && v.skill_docs[sk];
            if(p){ cardP = { author:v.author, repo:v.repo, branch:v.default_branch||'main', docpath:p, url:v.url, name:s.name, skill:sk, license:(v.skill_licenses&&v.skill_licenses[sk])||v.license||'' }; break; }
          }
          if(cardP) break;
        }
        if(!cardP){
          const s = sortedSources.find(x => x.author && x.repo);
          if(s) cardP = { author:s.author, repo:s.repo, branch:s.default_branch||'main', docpath:s.doc_path||'', url:s.url, name:s.name, skill:'', license:s.license||'' };
        }
        const cardAct = cardP
          ? ` data-act="usage" data-author="${escapeAttr(cardP.author)}" data-repo="${escapeAttr(cardP.repo)}" data-branch="${escapeAttr(cardP.branch)}" data-docpath="${escapeAttr(cardP.docpath)}" data-url="${escapeAttr(cardP.url)}" data-name="${escapeAttr(cardP.name)}" data-skill="${escapeAttr(cardP.skill)}" data-license="${escapeAttr(cardP.license)}"`
          : '';
        html += `<div class="card${row.chain?' chain':''}${cardP?' clickable':''}"${cardAct}
          data-search="${escapeAttr(searchText)}"
          data-chain="${row.chain}"
          data-skills="${row.skills.length}"
          data-sources="${sourceCount}"
          data-stars="${maxStars}"
          data-updated="${escapeAttr(maxUpd)}"
          data-ord="${_ord++}">`;
        html += `<div class="card-head">`;
        html += `<div class="card-group">${chainBadge}<span title="${escapeAttr(pickT(row.group_en, row.group))}">${escapeHtml(pickT(row.group_en, row.group))}</span></div>`;
        html += `<div class="card-skills">${skillsHtml}</div>`;
        html += `</div>`;
        const ucT = pickT(row.use_case_en, row.use_case);
        if(ucT){
          const pch = (row.personas||[]).map(p => `<span class="persona-chip">${escapeHtml(personaLabel(p))}</span>`).join('');
          const whenT = pickT(row.when_to_use_en, row.when_to_use);
          html += `<div class="card-uc"><span aria-hidden="true">💡</span> ${escapeHtml(ucT)}${whenT?` <span class="card-when">· ${escapeHtml(whenT)}</span>`:''}${pch}</div>`;
        }
        html += `<div class="card-desc">${escapeHtml(pickT(row.description_en, row.description))}</div>`;
        html += `<div class="card-sources">${sourcesHtml}</div>`;
        html += `</div>`;
      });
      html += '</div>';
    });
    html += '</section>';   // /.h1-wrap
  });
  root.innerHTML = html;

  document.getElementById('heroSkillCount').textContent = totalSkills;
  document.getElementById('heroGroupCount').textContent = totalGroups;
  document.getElementById('heroVendorCount').textContent = vendorSet.size;
  document.getElementById('heroChainCount').textContent = totalChains;

  const sr = document.getElementById('statRow');
  sr.innerHTML = `<span class="stat"><b>${totalGroups}</b> ${t('sr_groups')}</span>
    <span class="stat"><b>${totalSkills}</b> ${t('sr_skills')}</span>
    <span class="stat"><b>${vendorSet.size}</b> ${t('sr_sources')}</span>`;

  // 渲染完成（连线已删除）
}

function applyFilter(){
  const cards = document.querySelectorAll('.card');
  const q = currentSearch.toLowerCase();
  let visibleCount = 0;
  cards.forEach(c => {
    let visible = true;
    // filter
    if(currentFilter === 'chain' && c.dataset.chain !== 'true') visible = false;
    if(currentFilter === 'multi-source' && parseInt(c.dataset.sources) < 2) visible = false;
    if(currentFilter === 'single-skill' && parseInt(c.dataset.skills) > 1) visible = false;
    // search
    if(visible && q && !matchSearch(c.dataset.search, q)) visible = false;
    c.classList.toggle('hidden', !visible);
    if(visible) visibleCount++;
  });
  // hide empty subsections
  document.querySelectorAll('.section-h2').forEach(h2 => {
    const cardsWrap = h2.nextElementSibling;
    if(!cardsWrap || !cardsWrap.classList.contains('cards')) return;
    const anyVisible = cardsWrap.querySelector('.card:not(.hidden)');
    h2.classList.toggle('hidden', !anyVisible);
    cardsWrap.classList.toggle('hidden', !anyVisible);
  });
  // hide empty h1
  document.querySelectorAll('.section-h1').forEach(h1 => {
    let next = h1.nextElementSibling;
    let anyVisible = false;
    while(next && !next.classList.contains('section-h1')){
      if(next.classList.contains('section-h2') && !next.classList.contains('hidden')){
        anyVisible = true; break;
      }
      next = next.nextElementSibling;
    }
    h1.classList.toggle('hidden', !anyVisible);
  });
  document.getElementById('emptyState').classList.toggle('hidden', visibleCount > 0);

  // 搜索激活时按 star 排序：在每个 subsection 内重排可见卡片
  if(currentSearch){
    document.querySelectorAll('.cards').forEach(wrap => {
      const visible = [...wrap.querySelectorAll('.card:not(.hidden)')];
      visible.sort((a,b) => (parseInt(b.dataset.stars)||0) - (parseInt(a.dataset.stars)||0));
      visible.forEach(c => wrap.appendChild(c));
    });
  } else {
    applySort();   // 无搜索时按当前排序（默认/最热/最近）重排
  }

  // 更新结果计数
  const countEl = document.getElementById('searchResultCount');
  if(countEl){
    const total = cards.length;
    if(currentSearch || currentFilter !== 'all'){
      countEl.textContent = LANG === 'en' ? `${visibleCount} / ${total} results` : `${visibleCount} / ${total} 条结果`;
      countEl.style.color = visibleCount > 0 ? 'var(--fg-muted)' : 'var(--warn)';
    } else {
      countEl.textContent = '';
    }
  }
  // 有搜索/过滤时才显示「复制结果链接」
  const shareBtn = document.getElementById('shareLink');
  if(shareBtn) shareBtn.classList.toggle('hidden', !(currentSearch || currentFilter !== 'all'));
  if(window._heroUpdate) window._heroUpdate();
}

// 功能视图卡片排序：在每个小节内按所选键重排（default 复位到策展顺序）
function applySort(){
  document.querySelectorAll('.cards').forEach(wrap => {
    const cards = [...wrap.querySelectorAll('.card')];
    cards.sort((a, b) => {
      if(currentSort === 'stars') return (parseInt(b.dataset.stars)||0) - (parseInt(a.dataset.stars)||0) || ((parseInt(a.dataset.ord)||0) - (parseInt(b.dataset.ord)||0));
      if(currentSort === 'recent') return (b.dataset.updated||'').localeCompare(a.dataset.updated||'') || ((parseInt(a.dataset.ord)||0) - (parseInt(b.dataset.ord)||0));
      return (parseInt(a.dataset.ord)||0) - (parseInt(b.dataset.ord)||0);
    });
    cards.forEach(c => wrap.appendChild(c));
  });
}
function setupCardSort(){
  const bar = document.getElementById('cardSort');
  if(!bar) return;
  bar.querySelectorAll('.cs-btn').forEach(btn => btn.addEventListener('click', () => {
    if(btn.dataset.sort === currentSort) return;
    currentSort = btn.dataset.sort;
    bar.querySelectorAll('.cs-btn').forEach(b => b.classList.toggle('active', b === btn));
    applySort();
  }));
}

// 把当前 视图+过滤+搜索 串进 URL，便于把"筛选后的结果"分享给同事
function buildShareURL(){
  const u = new URL(location); u.search = '';
  if(currentView && currentView !== 'cards') u.searchParams.set('view', currentView);
  if(currentFilter && currentFilter !== 'all') u.searchParams.set('gfilter', currentFilter);
  if(currentSearch) u.searchParams.set('q', currentSearch);
  return u.toString();
}
function setupShareLink(){
  const btn = document.getElementById('shareLink');
  if(!btn) return;
  btn.addEventListener('click', () => {
    const url = buildShareURL();
    try{ navigator.clipboard.writeText(url); }catch(_){
      const ta = document.createElement('textarea'); ta.value = url; ta.style.position='fixed'; ta.style.opacity='0';
      document.body.appendChild(ta); ta.select(); try{ document.execCommand('copy'); }catch(e){} ta.remove();
    }
    flashBtn(btn, t('copied'));
  });
}

function setupHero(){
  const hero = document.querySelector('.hero');
  if(!hero) return;
  let manual = null;   // null = 自动；true/false = 手动覆盖（仅滚动回顶时清除）
  const apply = () => {
    const y = window.scrollY || document.documentElement.scrollTop || 0;
    const auto = y > 200 || !!currentSearch || currentFilter !== 'all';
    hero.classList.toggle('collapsed', manual === null ? auto : manual);
  };
  window._heroUpdate = apply;
  const btn = document.getElementById('heroToggle');
  if(btn) btn.addEventListener('click', () => { manual = !hero.classList.contains('collapsed'); apply(); });
  let ticking = false;
  window.addEventListener('scroll', () => {
    if(ticking) return; ticking = true;
    requestAnimationFrame(() => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      if(y < 20 && !currentSearch && currentFilter === 'all') manual = null;
      apply(); ticking = false;
    });
  }, { passive: true });
  apply();
}

// 回到顶部：cards/repo 视图向下滚动 >600px 时出现（图谱视图自身不滚动，不显示）
function setupBackToTop(){
  const btn = document.getElementById('toTop');
  if(!btn) return;
  if(typeof LANG !== 'undefined' && LANG === 'en'){ btn.title = btn.ariaLabel = 'Back to top'; }
  let ticking = false;
  const upd = () => {
    const y = window.scrollY || document.documentElement.scrollTop || 0;
    btn.classList.toggle('show', y > 600 && currentView !== 'graph');
    ticking = false;
  };
  window._toTopUpdate = upd;
  window.addEventListener('scroll', () => { if(!ticking){ ticking = true; requestAnimationFrame(upd); } }, { passive: true });
  btn.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
    // 清掉 hash，避免 scrollspy/深链把页面又拽回某个小节
    if(location.hash){ history.replaceState(null, '', location.pathname + location.search); }
  });
  upd();
}

function setupSearch(){
  const inp = document.getElementById('search');
  const clearBtn = document.getElementById('clearBtn');
  const kbdHint = document.getElementById('kbdHint');
  const updateUI = () => {
    const has = inp.value.length > 0;
    clearBtn.style.display = has ? 'block' : 'none';
    if(kbdHint) kbdHint.style.display = has ? 'none' : 'block';
  };
  const runSearch = (openTop) => {
    if(currentView === 'graph' && graphFindFn) graphFindFn(currentSearch, !!openTop);
    else applyFilter();
  };
  inp.addEventListener('input', e => {
    currentSearch = e.target.value;
    updateUI();
    runSearch(false);
  });
  inp.addEventListener('keydown', e => {
    if(e.key === 'Escape'){ inp.value=''; currentSearch=''; updateUI(); runSearch(false); inp.blur(); }
    else if(e.key === 'Enter' && currentView === 'graph'){ e.preventDefault(); runSearch(true); }  // 图视图：回车打开最佳匹配的详情
  });
  clearBtn.addEventListener('click', () => {
    inp.value = '';
    currentSearch = '';
    updateUI();
    runSearch(false);
    inp.focus();
  });
  // 全局 / 快捷键聚焦
  document.addEventListener('keydown', e => {
    if(e.key === '/' && !['INPUT','TEXTAREA'].includes(document.activeElement.tagName)){
      e.preventDefault();
      inp.focus();
      inp.select();
    }
  });
}

function setupFilters(){
  document.querySelectorAll('.toolbar .pill').forEach(p => {
    p.addEventListener('click', () => {
      document.querySelectorAll('.toolbar .pill').forEach(x => x.classList.remove('active'));
      p.classList.add('active');
      currentFilter = p.dataset.filter;
      // 在当前视图内就地过滤：网络图重绘只留匹配的 skill；功能视图过滤卡片。
      // （仓库视图按仓库聚合，类型过滤不适用 —— 切到仓库视图时这些 pill 已隐藏）
      if(currentView === 'graph') buildGraph();
      else applyFilter();
      syncGraphURL();
    });
  });
}

// 收集所有 row（扁平），用于 graph 和 AI 检索
function getAllRows(){
  const rows = [];
  DATA.sections.forEach(h1 => {
    h1.subsections.forEach(h2 => {
      h2.rows.forEach(r => {
        rows.push({...r, _h1: h1.title, _h2: h2.title, _h1en: h1.title_en, _h2en: h2.title_en});
      });
    });
  });
  return rows;
}

// === 视图切换 ===
let currentView = 'cards';
function setupViewSwitch(){
  document.querySelectorAll('#viewSwitch .view-btn').forEach(b => {
    b.addEventListener('click', () => {
      const v = b.dataset.view;
      if(v === currentView) return;
      currentView = v;
      document.querySelectorAll('#viewSwitch .view-btn').forEach(x => x.classList.remove('active'));
      b.classList.add('active');
      const isCards = v === 'cards';
      const isRepo = v === 'repo';
      const isGraph = v === 'graph';
      document.getElementById('content').classList.toggle('hidden', !isCards);
      document.querySelector('.hero').classList.toggle('hidden', !isCards);
      document.getElementById('repoView').classList.toggle('hidden', !isRepo);
      document.getElementById('graphView').classList.toggle('hidden', !isGraph);
      // 类型过滤（强绑定）只在功能/网络视图适用；仓库视图按仓库聚合，隐藏这些 pill
      document.querySelectorAll('.toolbar .pill, .toolbar .tb-divider').forEach(el => el.classList.toggle('hidden', isRepo));
      // 卡片排序只在功能视图显示
      const cardSort = document.getElementById('cardSort'); if(cardSort) cardSort.classList.toggle('hidden', !isCards);
      if(isRepo) buildRepoView();
      if(isGraph) buildGraph();
      syncSidebarForView();
      syncGraphURL();
      if(window._toTopUpdate) window._toTopUpdate();   // 切视图后立即重判「回到顶部」显隐
    });
  });
}

// === 按仓库视图 ===
function buildRepoView(){
  const container = document.getElementById('repoView');
  if(container.dataset.built) return;
  container.dataset.built = '1';

  // 从 DATA.vendors 收集；同时统计每个仓库被引用的 skill row / group
  const repoStats = {};   // id -> {rows: Set, groupNames: Set, h1Set: Set}
  getAllRows().forEach(row => {
    row.sources.forEach(s => {
      if(!repoStats[s.name]) repoStats[s.name] = {rows: 0, groups: new Set(), h1s: new Set()};
      repoStats[s.name].rows += 1;
      repoStats[s.name].groups.add(row.group);
      repoStats[s.name].h1s.add(row._h1);
    });
  });

  // 按 type 分组
  const byType = {};
  Object.entries(DATA.vendors).forEach(([id, v]) => {
    const t = v.type || 'skill';
    if(!byType[t]) byType[t] = [];
    const stats = repoStats[id] || {rows: 0, groups: new Set(), h1s: new Set()};
    byType[t].push({id, ...v, _rows: stats.rows, _groups: stats.groups.size, _h1s: stats.h1s.size});
  });

  // 排序 type：先按数量倒序，再字母序
  const typeOrder = Object.keys(byType).sort((a, b) => {
    const da = byType[a].length, db = byType[b].length;
    return db - da || a.localeCompare(b);
  });

  // 类型 → 中文标签 + 色温 hue（继承类别色温思路：暖工具暖色，工程冷色）
  const TYPE_LABEL = {
    'skill': 'Skill 包',
    'skill-pack': 'Skill 套装',
    'multi-skill-suite': '多 skill 套件',
    'plugin': '插件',
    'cli': 'CLI 工具',
    'cli-framework': 'CLI 框架',
    'cli-mcp': 'CLI / MCP',
    'sdd-framework': 'SDD 框架',
    'python-library': 'Python 库',
    'desktop-app': '桌面应用',
    'video-engine': '视频引擎',
    'extraction-engine': '抽取引擎',
    'marketplace': 'Marketplace',
    'claude-md-template': 'Claude.md 模板'
  };
  const TYPE_HUE = {
    'skill': 215, 'skill-pack': 220, 'multi-skill-suite': 230,
    'plugin': 280, 'cli': 195, 'cli-framework': 200, 'cli-mcp': 205,
    'sdd-framework': 175, 'python-library': 155,
    'desktop-app': 240, 'video-engine': 350, 'extraction-engine': 35,
    'marketplace': 320, 'claude-md-template': 45
  };
  // 英文类型标签（loop 变量名为 t，会遮蔽 i18n 的 t()，故这里用直取 I18N[LANG] 的 _L / _labels）
  const TYPE_LABEL_EN = {
    'skill': 'Skill pack', 'skill-pack': 'Skill bundle', 'multi-skill-suite': 'Multi-skill suite',
    'plugin': 'Plugin', 'cli': 'CLI tool', 'cli-framework': 'CLI framework', 'cli-mcp': 'CLI / MCP',
    'sdd-framework': 'SDD framework', 'python-library': 'Python library', 'desktop-app': 'Desktop app',
    'video-engine': 'Video engine', 'extraction-engine': 'Extraction engine', 'marketplace': 'Marketplace',
    'claude-md-template': 'Claude.md template'
  };
  const _labels = (LANG === 'en') ? TYPE_LABEL_EN : TYPE_LABEL;
  const _L = I18N[LANG] || I18N.zh;
  const _en = LANG === 'en';
  const clockIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
  // last_commit("YYYY-MM-DD") → 相对时间（运行时按访客时钟算）；近 30 天视为「活跃」
  const _daysSince = ds => { const d = new Date(ds); if(isNaN(d)) return null; const n = Math.floor((Date.now() - d.getTime()) / 86400000); return n < 0 ? 0 : n; };
  const relTimeShort = ds => {
    const n = _daysSince(ds); if(n === null) return '';
    if(n === 0) return _en ? 'today' : '今天';
    if(n < 7) return _en ? `${n}d ago` : `${n} 天前`;
    if(n < 30) { const w = Math.floor(n / 7); return _en ? `${w}w ago` : `${w} 周前`; }
    if(n < 365) { const m = Math.floor(n / 30); return _en ? `${m}mo ago` : `${m} 个月前`; }
    const y = Math.floor(n / 365); return _en ? `${y}y ago` : `${y} 年前`;
  };

  // ===== 顶部汇总条统计 =====
  const allRepos = typeOrder.flatMap(t => byType[t]);
  const totalRepos = allRepos.length;
  const totalStars = allRepos.reduce((s, r) => s + (r.stars || 0), 0);
  const catsCovered = new Set(getAllRows().map(r => r._h1)).size;

  // ===== 排序：组内按所选键重排（默认星标，存 localStorage）=====
  const SORTS = {
    stars:    (a, b) => (b.stars || 0) - (a.stars || 0) || a.id.localeCompare(b.id),
    recent:   (a, b) => { const la = a.last_commit || '', lb = b.last_commit || ''; if(la !== lb) return lb < la ? -1 : 1; return (b.stars || 0) - (a.stars || 0); },  // 新→旧（ISO 日期串较大者在前），无日期排最后
    coverage: (a, b) => (b._groups - a._groups) || (b._rows - a._rows) || (b.stars || 0) - (a.stars || 0),
  };
  let sortKey = 'stars';
  try{ const sv = localStorage.getItem('atlas:repo:sort'); if(sv && SORTS[sv]) sortKey = sv; }catch(_){}
  const gridIcon = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>';
  const SORT_DEFS = [
    { k: 'stars',    icon: starIcon,  label: _en ? 'Stars' : '星标' },
    { k: 'recent',   icon: clockIcon, label: _en ? 'Recent' : '最近更新' },
    { k: 'coverage', icon: gridIcon,  label: _en ? 'Coverage' : '覆盖最广' },
  ];

  let gridsEl = null;
  function renderGrids(){
    let html = '';
    typeOrder.forEach(t => {
      const repos = byType[t].slice().sort(SORTS[sortKey]);
      const label = _labels[t] || t;
      const hue = TYPE_HUE[t] != null ? TYPE_HUE[t] : 220;
      const slug = 'repotype-' + slugify(t);
      html += `<section class="repo-type-group" id="${slug}" style="--cat-hue:${hue}">`;
      html += `<h3 class="repo-type-head"><span>${escapeHtml(label)}</span>`;
      html += `<span class="type-badge">${escapeHtml(t)}</span>`;
      html += `<span class="type-count">${repos.length}${_L.count_unit}</span></h3>`;
      html += `<div class="repo-grid">`;
      repos.forEach(r => {
        const star = (r.stars != null && r.stars > 0)
          ? `<span class="repo-card-stars">${starIcon}${formatStars(r.stars)}</span>` : '';
        // 隐藏值为 1 的分组/大类标签（无信息量）
        const tags = [
          r._groups > 1 ? `<span class="repo-card-tag">${r._groups} ${_L.rc_groups}</span>` : '',
          r._h1s > 1 ? `<span class="repo-card-tag">${_en ? r._h1s + ' ' + _L.rc_cross : '跨 ' + r._h1s + ' ' + _L.rc_cross}</span>` : '',
          r.skill_group_count ? `<span class="repo-card-tag">${r.skill_group_count} ${_L.rc_skill}</span>` : '',
          r._groups >= 5 ? `<span class="repo-card-tag tag-hot">${_L.rc_versatile}</span>` : ''
        ].filter(Boolean).join('');
        const author = r.author ? `<span class="author">${escapeHtml(r.author)}/</span>` : '';
        const repoName = r.repo || r.id;
        const desc = pickT(r.description_en, r.description) || '';
        const lic = r.license ? `<span class="rc-lic">${escapeHtml(r.license)}</span>` : '';
        const upd = relTimeShort(r.last_commit);
        const fresh = (_daysSince(r.last_commit) ?? 999) < 30 ? ' fresh' : '';
        const updHtml = upd ? `<span class="rc-upd${fresh}" title="${escapeAttr((_en ? 'last commit ' : '最近提交 ') + (r.last_commit || ''))}">${clockIcon}${upd}</span>` : '';
        html += `<div class="repo-card" data-repo="${escapeAttr(r.id)}" style="--cat-hue:${hue}">`;
        html += `<div class="repo-card-head"><div class="repo-card-name">${author}${escapeHtml(repoName)}</div>${star}</div>`;
        if(desc) html += `<div class="repo-card-desc">${escapeHtml(desc)}</div>`;
        if(tags) html += `<div class="repo-card-meta">${tags}</div>`;
        html += `<div class="repo-card-foot">${lic}${updHtml}<a class="repo-card-link" href="${escapeAttr(r.url)}" target="_blank" rel="noopener" onclick="event.stopPropagation()">${githubIcon}<span>${_L.view_repo_link}</span></a></div>`;
        html += `</div>`;
      });
      html += `</div></section>`;
    });
    gridsEl.innerHTML = html;
  }

  const statsHtml = `<div class="rs-stats">` +
    `<span class="rs-stat"><b>${totalRepos}</b> ${_en ? 'repos' : '仓库'}</span>` +
    `<span class="rs-stat"><b>${formatStars(totalStars)}</b> <span class="rs-star">${starIcon}</span> ${_en ? 'stars' : '星标'}</span>` +
    `<span class="rs-stat"><b>${catsCovered}</b> ${_en ? 'categories' : '大类'}</span>` +
    `</div>`;
  const sortHtml = `<div class="rs-sort"><span class="rs-sort-label" id="rsSortLabel">${_en ? 'Sort' : '排序'}</span>` +
    `<div class="rs-sort-pills" role="group" aria-labelledby="rsSortLabel">${SORT_DEFS.map(d => `<button type="button" data-sort="${d.k}" class="${d.k === sortKey ? 'active' : ''}" aria-pressed="${d.k === sortKey}" title="${escapeAttr(d.label)}">${d.icon}<span>${d.label}</span></button>`).join('')}</div></div>`;
  container.innerHTML = `<div class="repo-summary">${statsHtml}${sortHtml}</div><div class="repo-grids"></div>`;
  gridsEl = container.querySelector('.repo-grids');
  renderGrids();

  // 排序切换：仅重排网格（不重建汇总条 / 侧栏）；段控件支持 ←/→ 方向键切换
  const sortBtns = [...container.querySelectorAll('.rs-sort-pills button')];
  sortBtns.forEach((btn, i) => {
    btn.addEventListener('click', () => {
      if(btn.dataset.sort === sortKey) return;
      sortKey = btn.dataset.sort;
      try{ localStorage.setItem('atlas:repo:sort', sortKey); }catch(_){}
      sortBtns.forEach(b => { const on = b === btn; b.classList.toggle('active', on); b.setAttribute('aria-pressed', on); });
      renderGrids();
    });
    btn.addEventListener('keydown', e => {
      let n = i;
      if(e.key === 'ArrowLeft' || e.key === 'ArrowUp') n = (i - 1 + sortBtns.length) % sortBtns.length;
      else if(e.key === 'ArrowRight' || e.key === 'ArrowDown') n = (i + 1) % sortBtns.length;
      else return;
      e.preventDefault(); sortBtns[n].focus(); sortBtns[n].click();
    });
  });

  // 点击仓库卡片：切回功能视图并锁定搜索到该仓库（事件委托，重排后仍生效）
  gridsEl.addEventListener('click', e => {
    const card = e.target.closest('.repo-card');
    if(!card) return;
    const repoId = card.dataset.repo;
    document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
    const inp = document.getElementById('search');
    inp.value = repoId; currentSearch = repoId;
    document.getElementById('clearBtn').style.display = 'block';
    const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none';
    applyFilter();
    window.scrollTo({top: 0, behavior: 'smooth'});
  });

  // 同步侧边栏导航
  buildRepoNav(typeOrder, byType, _labels);
}

// 在切到 repo 视图时把侧边栏 nav 切成仓库列表（单独一个 nav 容器，叠在原 nav 上方/替换）
function buildRepoNav(typeOrder, byType, TYPE_LABEL){
  // 直接复用 #nav；用一个内部容器 #navRepo 表示 repo 模式
  const nav = document.getElementById('nav');
  if(nav.dataset.repoBuilt) return;
  nav.dataset.repoBuilt = '1';
  // 创建 navRepo 容器并追加（默认 hidden）
  let navRepo = document.getElementById('navRepo');
  if(!navRepo){
    navRepo = document.createElement('div');
    navRepo.id = 'navRepo';
    navRepo.className = 'hidden';
    nav.parentElement.appendChild(navRepo);
  }
  let html = '';
  typeOrder.forEach(t => {
    const label = TYPE_LABEL[t] || t;
    const slug = 'repotype-' + slugify(t);
    html += `<div class="nav-repo-type expanded" data-target="${slug}">`;
    html += `<div class="nav-repo-type-head">`;
    html += `<span class="caret">▸</span>`;
    html += `<span>${escapeHtml(label)}</span>`;
    html += `<span class="badge">${byType[t].length}</span>`;
    html += `</div>`;
    html += `<div class="nav-repo-list">`;
    byType[t].slice(0, 30).forEach(r => {
      html += `<a class="nav-repo-item" data-repo="${escapeAttr(r.id)}" data-target="${slug}" title="${escapeAttr(r.author + '/' + (r.repo || r.id))}">${escapeHtml(r.id)}</a>`;
    });
    html += `</div></div>`;
  });
  navRepo.innerHTML = html;

  // 折叠/展开
  navRepo.querySelectorAll('.nav-repo-type-head').forEach(h => {
    h.addEventListener('click', () => h.parentElement.classList.toggle('expanded'));
  });
  // 单条点击：滚到对应 type group
  navRepo.querySelectorAll('.nav-repo-item').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const target = a.dataset.target;
      const el = document.getElementById(target);
      if(el) smoothScrollToEl(el);   // 走统一的逐帧重算平滑，避免原生 smooth 落点漂移
      navRepo.querySelectorAll('.nav-repo-item').forEach(x => x.classList.remove('active'));
      a.classList.add('active');
    });
  });
}

// 当切换视图时同步切换侧边栏 nav 模式
function syncSidebarForView(){
  const navRepo = document.getElementById('navRepo');
  const nav = document.getElementById('nav');
  if(!navRepo) return;
  const showRepo = currentView === 'repo';
  navRepo.classList.toggle('hidden', !showRepo);
  nav.classList.toggle('hidden', showRepo);
}

// === 力导向图（动态、可缩放、可拖拽） ===
let _graphAnim = null;
// 图视图的对外钩子（buildGraph 内部设置；搜索/深链从模块作用域调用）
let graphFindFn = null;       // (query, openTop) => 高亮+居中匹配节点；openTop 时打开其抽屉
let graphOpenNodeFn = null;   // (skillId) => 打开该节点抽屉（深链还原用）
let graphSelectedId = null;   // 当前选中节点 id（深链用）
// 把当前 视图/过滤/选中节点 同步进 URL query（保留 ?lang），用于可分享深链
function syncGraphURL(){
  try{
    const u = new URL(location);
    if(currentView === 'graph' || currentView === 'repo') u.searchParams.set('view', currentView);
    else u.searchParams.delete('view');
    if(currentView !== 'repo' && currentFilter && currentFilter !== 'all') u.searchParams.set('gfilter', currentFilter);
    else u.searchParams.delete('gfilter');
    if(currentView === 'graph' && graphSelectedId) u.searchParams.set('gnode', graphSelectedId);
    else u.searchParams.delete('gnode');
    history.replaceState(null, '', u);
  }catch(_){}
}
function buildGraph(){
  const container = document.getElementById('graphView');
  if(container.dataset.built === currentFilter) return;   // 已按当前过滤构建，避免重复重绘
  container.dataset.built = currentFilter;
  if(_graphAnim){ cancelAnimationFrame(_graphAnim); _graphAnim = null; }  // 停掉上一次力导向循环
  container.innerHTML = '';                                // 清旧 svg/tooltip/控件/图例，重建
  graphSelectedId = null;                                  // 重建后无选中节点

  // 按当前类型过滤：只保留匹配的 skill 组，图中即只剩对应类型的 skill
  const rows = getAllRows().filter(r => {
    if(currentFilter === 'chain') return r.chain;
    if(currentFilter === 'multi-source') return (r.sources && r.sources.length) >= 2;
    if(currentFilter === 'single-skill') return (r.skills && r.skills.length) === 1;
    return true;
  });

  // 节点：每个 unique skill；边：同一 row 内 skill 两两相连
  const nodeMap = new Map();
  const links = [];
  // 按大类数等距生成色相(任意类数都不重复;cat0 从蓝 220 起)
  const accentHues = DATA.sections.map((_, i) => Math.round((i * 360 / DATA.sections.length + 220) % 360));
  const catIdx = new Map(DATA.sections.map((s, i) => [s.title, i]));

  rows.forEach(row => {
    const catI = catIdx.get(row._h1) || 0;
    const hue = accentHues[catI % accentHues.length];
    row.skills.forEach(sk => {
      if(!nodeMap.has(sk)) nodeMap.set(sk, {
        id: sk, count: 0, hue, h1: row._h1, catI, chain: false, sources: row.sources
      });
      const n = nodeMap.get(sk);
      n.count++;
      if(row.chain) n.chain = true;
    });
    for(let i=0;i<row.skills.length;i++){
      for(let j=i+1;j<row.skills.length;j++){
        links.push({source: row.skills[i], target: row.skills[j], chain: row.chain});
      }
    }
  });

  const nodes = [...nodeMap.values()];
  // 邻接表（用于 hover 高亮 + 链路力）
  const neighbors = new Map(nodes.map(n => [n.id, new Set()]));
  links.forEach(l => {
    neighbors.get(l.source)?.add(l.target);
    neighbors.get(l.target)?.add(l.source);
  });

  // 视图坐标系：用一个固定大世界（W×H）和 viewport transform 配合
  const W = 2400, H = 1600;
  const cx = W/2, cy = H/2;

  // 类别中心：各大类沿圆周分布（增大半径，让类簇彼此分开）
  const catCount = DATA.sections.length;
  const clusterR = Math.min(W, H) * 0.36;
  const catCenter = new Map();
  DATA.sections.forEach((s, i) => {
    const ang = (i / catCount) * Math.PI * 2 - Math.PI/2;
    catCenter.set(s.title, {
      x: cx + Math.cos(ang) * clusterR,
      y: cy + Math.sin(ang) * clusterR
    });
  });

  // 初始位置：类簇中心 + 小扰动
  nodes.forEach(n => {
    const c = catCenter.get(n.h1) || {x: cx, y: cy};
    n.x = c.x + (Math.random()-.5) * 200;
    n.y = c.y + (Math.random()-.5) * 200;
    n.vx = 0; n.vy = 0;
    n.fx = null; n.fy = null;  // 拖动时锁定坐标
    n.r = 4 + Math.min(10, Math.sqrt(n.count) * 3.2);
  });

  // ==== SVG 构建 ====
  const svgNS = 'http://www.w3.org/2000/svg';
  const svg = document.createElementNS(svgNS, 'svg');
  svg.setAttribute('viewBox', `0 0 ${W} ${H}`);
  svg.setAttribute('preserveAspectRatio', 'xMidYMid meet');

  // 视觉系统 defs：节点高光(玻璃珠) + 发光 + 点阵背景
  const defs = document.createElementNS(svgNS, 'defs');
  defs.innerHTML =
    '<radialGradient id="orbHi" cx="34%" cy="28%" r="78%">' +
      '<stop offset="0%" stop-color="rgba(255,255,255,.55)"/>' +
      '<stop offset="42%" stop-color="rgba(255,255,255,.08)"/>' +
      '<stop offset="100%" stop-color="rgba(255,255,255,0)"/>' +
    '</radialGradient>' +
    '<filter id="nodeGlow" x="-70%" y="-70%" width="240%" height="240%">' +
      '<feGaussianBlur stdDeviation="3.2" result="b"/><feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge>' +
    '</filter>' +
    '<pattern id="dotgrid" width="48" height="48" patternUnits="userSpaceOnUse">' +
      '<circle cx="2" cy="2" r="1.1" fill="var(--graph-dot)"/>' +
    '</pattern>';
  svg.appendChild(defs);

  // viewport transform layer（zoom + pan 都施加在它身上）
  const viewport = document.createElementNS(svgNS, 'g');
  viewport.classList.add('viewport');
  svg.appendChild(viewport);

  // 点阵背景（无限画布感）：铺一大块，pan 时始终有底纹
  const bg = document.createElementNS(svgNS, 'rect');
  bg.classList.add('graph-bg');
  bg.setAttribute('x', -W); bg.setAttribute('y', -H);
  bg.setAttribute('width', W * 3); bg.setAttribute('height', H * 3);
  bg.setAttribute('fill', 'url(#dotgrid)');
  viewport.appendChild(bg);

  // 类簇背景晕光
  const haloGroup = document.createElementNS(svgNS, 'g');
  catCenter.forEach((c, h1) => {
    const i = catIdx.get(h1) || 0;
    const hue = accentHues[i % accentHues.length];
    const halo = document.createElementNS(svgNS, 'circle');
    halo.setAttribute('cx', c.x); halo.setAttribute('cy', c.y);
    halo.setAttribute('r', 200);
    halo.setAttribute('fill', `hsla(${hue}, 70%, 60%, .035)`);
    halo.setAttribute('stroke', `hsla(${hue}, 70%, 60%, .12)`);
    halo.setAttribute('stroke-width', 1);
    halo.setAttribute('stroke-dasharray', '3 6');
    halo.classList.add('cluster-halo');
    haloGroup.appendChild(halo);
  });
  viewport.appendChild(haloGroup);

  // 边
  const linkGroup = document.createElementNS(svgNS, 'g');
  const linkEls = links.map(l => {
    const path = document.createElementNS(svgNS, 'path');  // 改用贝塞尔弧线：密集簇里平行边视觉分离、不糊成一团
    path.classList.add('link');
    if(l.chain) path.classList.add('chain');
    path.setAttribute('stroke', l.chain ? 'var(--chain)' : 'var(--border-strong)');
    path.setAttribute('stroke-width', l.chain ? 1.6 : 0.8);
    path.setAttribute('fill', 'none');
    linkGroup.appendChild(path);
    return path;
  });
  viewport.appendChild(linkGroup);

  // 节点（每个 g 包含 circle + label）
  const nodeGroup = document.createElementNS(svgNS, 'g');
  // 决定哪些 label 常驻：仅 top-15（按 count），避免过密
  const sortedByCount = [...nodes].sort((a,b)=> b.count - a.count);
  const alwaysLabelSet = new Set(sortedByCount.slice(0, 15).map(n => n.id));

  const nodeEls = nodes.map(n => {
    const g = document.createElementNS(svgNS, 'g');
    g.classList.add('node');
    g.dataset.id = n.id;
    // 把节点 hue 写到 currentColor 上，hover 时 drop-shadow 用 currentColor
    g.style.color = `hsl(${n.hue}, 70%, ${catLight(n.catI)}%)`;
    const c = document.createElementNS(svgNS, 'circle');
    c.setAttribute('r', n.r);
    c.setAttribute('fill', `hsl(${n.hue}, 70%, ${catLight(n.catI)}%)`);
    c.setAttribute('stroke', n.chain ? 'var(--chain)' : 'var(--graph-node-stroke)');
    c.setAttribute('stroke-width', n.chain ? 2 : 1);
    g.appendChild(c);
    // 玻璃珠高光：白色径向高光叠在彩色圆上，立体感（共用一个 gradient，无 per-node 开销）
    const hi = document.createElementNS(svgNS, 'circle');
    hi.setAttribute('r', n.r); hi.setAttribute('fill', 'url(#orbHi)');
    hi.classList.add('node-hi');
    g.appendChild(hi);
    const t = document.createElementNS(svgNS, 'text');
    t.classList.add('label');
    if(alwaysLabelSet.has(n.id)) t.classList.add('always');
    t.setAttribute('y', n.r + 11);
    t.setAttribute('text-anchor', 'middle');
    t.textContent = n.id;
    g.appendChild(t);
    nodeGroup.appendChild(g);
    n._g = g; n._c = c; n._t = t;
    return g;
  });
  viewport.appendChild(nodeGroup);

  // tooltip
  const tooltip = document.createElement('div');
  tooltip.className = 'tooltip';
  container.appendChild(tooltip);

  // 节点详情侧抽屉
  const drawer = document.createElement('div');
  drawer.className = 'graph-drawer';
  container.appendChild(drawer);

  // ==== Pan / Zoom ====
  let scale = 1, tx = 0, ty = 0;
  function applyTransform(){
    viewport.setAttribute('transform', `translate(${tx},${ty}) scale(${scale})`);
  }

  // 屏幕坐标 → SVG 坐标（再 → 世界坐标）
  function screenToWorld(clientX, clientY){
    const rect = svg.getBoundingClientRect();
    // SVG 内部 viewBox 单位
    const vx = (clientX - rect.left) / rect.width * W;
    const vy = (clientY - rect.top) / rect.height * H;
    return {x: (vx - tx) / scale, y: (vy - ty) / scale};
  }
  function worldToView(wx, wy){ return {x: wx * scale + tx, y: wy * scale + ty}; }

  // ==== 详情抽屉 + 持久聚焦 ====
  let focusedNode = null;
  let focusedCat = null;
  const EN = LANG === 'en';
  function setHighlight(n){
    const nb = neighbors.get(n.id) || new Set();
    nodes.forEach(m => { const on = (m === n || nb.has(m.id)); m._g.classList.toggle('highlight', on); m._g.classList.toggle('dim', !on); });
    links.forEach((l, i) => { const adj = (l.source === n.id || l.target === n.id); linkEls[i].classList.toggle('highlight', adj); linkEls[i].classList.toggle('dim', !adj); });
  }
  function clearHighlight(){
    nodes.forEach(m => m._g.classList.remove('dim', 'highlight'));
    links.forEach((l, i) => linkEls[i].classList.remove('dim', 'highlight'));
  }
  function centerNode(n){ tx = W/2 - n.x * scale; ty = H/2 - n.y * scale; applyTransform(); }
  function clearFocus(){ focusedNode = null; clearHighlight(); drawer.classList.remove('open'); graphSelectedId = null; syncGraphURL(); }
  // 图例分类聚焦：高亮该大类全部节点 + 类内连线，淡化其余，并居中到类簇
  function clearCategoryFocus(){
    if(focusedCat === null) return;
    focusedCat = null; clearHighlight();
    document.querySelectorAll('.legend-cat').forEach(el => el.classList.remove('active'));
  }
  function focusCategory(i){
    if(focusedCat === i){ clearCategoryFocus(); return; }   // 再点同一项 → 取消
    if(focusedNode){ focusedNode = null; drawer.classList.remove('open'); graphSelectedId = null; }  // 与节点聚焦互斥
    focusedCat = i;
    nodes.forEach(m => { const on = (m.catI === i); m._g.classList.toggle('highlight', on); m._g.classList.toggle('dim', !on); });
    links.forEach((l, idx) => {
      const sa = nodeMap.get(l.source), ta = nodeMap.get(l.target);
      const inCat = !!(sa && ta && sa.catI === i && ta.catI === i);
      linkEls[idx].classList.toggle('highlight', inCat); linkEls[idx].classList.toggle('dim', !inCat);
    });
    document.querySelectorAll('.legend-cat').forEach(el => el.classList.toggle('active', +el.dataset.ci === i));
    const c = catCenter.get((DATA.sections[i] || {}).title);   // 居中到类簇
    if(c){ scale = 1.2; tx = W/2 - c.x * scale; ty = H/2 - c.y * scale; applyTransform(); updateZoomLabel(); }
    syncGraphURL();
  }
  function catLabelOf(h1zh){ const s = DATA.sections.find(x => x.title === h1zh); return s ? pickT(s.title_en, s.title) : h1zh; }
  function jumpToCard(skillName, group){
    const g = group || rows.filter(r => (r.skills || []).includes(skillName))[0];
    document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
    const inp = document.getElementById('search');
    if(inp){ inp.value = skillName; currentSearch = skillName; const cb = document.getElementById('clearBtn'); if(cb) cb.style.display = 'block'; const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none'; }
    applyFilter();
    // 滚到目标分组的小节并定位（之前只过滤、不滚动，所以"没跳过去"）
    if(g){
      const id = slugify(g._h1) + '--' + slugify(g._h2);
      setTimeout(() => {
        const el = document.getElementById(id);
        if(el){ smoothScrollToEl(el); pushHash(id); }
      }, 100);
    }
  }
  function openDrawer(n){
    clearCategoryFocus();   // 节点聚焦与分类聚焦互斥
    focusedNode = n; graphSelectedId = n.id; setHighlight(n); centerNode(n);
    const groups = rows.filter(r => (r.skills || []).includes(n.id));
    const primary = groups[0] || {};
    const descr = pickT(primary.description_en, primary.description) || '';
    const whatText = pickT(primary.use_case_en, primary.use_case) || (descr.length > 220 ? descr.slice(0, 220) + '…' : descr);
    const nbIds = [...(neighbors.get(n.id) || [])].sort();
    // 保留 source 对象（按名去重），以便仓库芯片能跳到对应 GitHub
    const srcMap = new Map();
    groups.forEach(g => (g.sources || []).forEach(s => { const nm = (s && s.name) || s; if(nm && !srcMap.has(nm)) srcMap.set(nm, s); }));
    const chip = (txt, act) => `<span class="gd-chip" data-nb="${escapeAttr(act)}">${escapeHtml(txt)}</span>`;
    const nbHtml = nbIds.length ? nbIds.map(id => chip(id, id)).join('') : `<span style="color:var(--fg-muted)">${EN ? 'none' : '无'}</span>`;
    const grpHtml = groups.map((g, gi) => `<div class="gd-group" data-gi="${gi}" title="${EN ? 'Open this group in cards' : '在功能视图查看该分组'}">${escapeHtml(pickT(g.group_en, g.group))}<span class="gd-go">→</span><div class="gd-cat">${escapeHtml(catLabelOf(g._h1))}${g.chain ? ' · ⛓' : ''}</div></div>`).join('');
    const srcHtml = [...srcMap].map(([nm, s]) => {
      const url = (s && s.url) || '';
      return `<span class="gd-chip gd-repo${url ? '' : ' no-link'}" data-url="${escapeAttr(url)}"${url ? ` title="${escapeAttr(url)}"` : ''}>${escapeHtml(nm)}${url ? ' ↗' : ''}</span>`;
    }).join('');
    drawer.innerHTML =
      `<div class="gd-head"><button class="gd-close" aria-label="close">×</button>` +
      `<div class="gd-eyebrow">${EN ? 'SKILL' : '技能'}</div>` +
      `<div class="gd-title">${escapeHtml(n.id)}</div>` +
      `<div class="gd-sub">${escapeHtml(catLabelOf(n.h1))} · ${EN ? `in ${n.count} ${n.count === 1 ? 'group' : 'groups'}` : `出现于 ${n.count} 个分组`}${n.chain ? ' · <span style="color:var(--chain)">⛓ ' + (EN ? 'chained' : '强绑定') + '</span>' : ''}</div></div>` +
      `<div class="gd-body">` +
        (whatText ? `<div class="gd-sec"><h4>${EN ? 'What it does' : '用途'}</h4><div class="gd-what">${escapeHtml(whatText)}</div></div>` : '') +
        `<div class="gd-sec"><h4>${EN ? 'Often used with' : '常一起用'}</h4><div class="gd-chips">${nbHtml}</div></div>` +
        `<div class="gd-sec"><h4>${EN ? 'Part of these workflows' : '所属功能分组'}</h4>${grpHtml}</div>` +
        (srcHtml ? `<div class="gd-sec"><h4>${EN ? 'From repos' : '来自仓库'}</h4><div class="gd-chips">${srcHtml}</div></div>` : '') +
      `</div>` +
      `<div class="gd-foot"><button class="gd-btn primary" data-act="jump">${EN ? 'Open in cards →' : '在功能视图查看 →'}</button>` +
      `<button class="gd-btn" data-act="link" style="flex:0 0 auto" title="${EN ? 'Copy shareable link' : '复制可分享链接'}">🔗</button></div>`;
    drawer.classList.add('open');
    drawer.querySelector('.gd-close').addEventListener('click', clearFocus);
    drawer.querySelector('[data-act="jump"]').addEventListener('click', () => jumpToCard(n.id));
    drawer.querySelectorAll('.gd-chip[data-nb]').forEach(c => c.addEventListener('click', () => { const m = nodeMap.get(c.dataset.nb); if(m) openDrawer(m); }));
    // 「所属功能分组」每项可点 → 在功能视图打开该分组
    drawer.querySelectorAll('.gd-group[data-gi]').forEach(el => el.addEventListener('click', () => { const g = groups[+el.dataset.gi]; if(g) jumpToCard(n.id, g); }));
    // 「来自仓库」芯片可点 → 新标签打开该仓库 GitHub
    drawer.querySelectorAll('.gd-repo[data-url]').forEach(c => { const u = c.dataset.url; if(u) c.addEventListener('click', () => window.open(u, '_blank', 'noopener')); });
    const lk = drawer.querySelector('[data-act="link"]');
    if(lk) lk.addEventListener('click', () => {
      try{ navigator.clipboard.writeText(location.href); }catch(_){}
      const o = lk.textContent; lk.textContent = EN ? '✓ Copied' : '✓ 已复制'; setTimeout(() => { lk.textContent = o; }, 1200);
    });
    syncGraphURL();
  }
  // 对外钩子：图内搜索定位 + 深链还原打开节点
  graphFindFn = (q, openTop) => {
    q = (q || '').trim().toLowerCase();
    if(!q){ if(focusedNode) setHighlight(focusedNode); else clearHighlight(); return; }
    const matches = nodes.filter(n => n.id.toLowerCase().includes(q));
    if(!matches.length){ clearHighlight(); return; }
    matches.sort((a, b) => (a.id.toLowerCase().startsWith(q) ? 0 : 1) - (b.id.toLowerCase().startsWith(q) ? 0 : 1) || b.count - a.count);
    if(openTop){ openDrawer(matches[0]); return; }
    const mset = new Set(matches);
    nodes.forEach(m => { const on = mset.has(m); m._g.classList.toggle('highlight', on); m._g.classList.toggle('dim', !on); });
    links.forEach((l, i) => linkEls[i].classList.add('dim'));
    centerNode(matches[0]);
  };
  graphOpenNodeFn = (id) => { const m = nodeMap.get(id); if(m) openDrawer(m); };

  // 鼠标滚轮缩放
  svg.addEventListener('wheel', e => {
    e.preventDefault();
    const rect = svg.getBoundingClientRect();
    const vx = (e.clientX - rect.left) / rect.width * W;
    const vy = (e.clientY - rect.top) / rect.height * H;
    const factor = Math.exp(-e.deltaY * 0.001);
    const newScale = Math.max(0.3, Math.min(4, scale * factor));
    // 在鼠标位置保持不变的情况下缩放
    tx = vx - (vx - tx) * (newScale / scale);
    ty = vy - (vy - ty) * (newScale / scale);
    scale = newScale;
    applyTransform();
    updateZoomLabel();
  }, {passive: false});

  // 平移：在空白处按下
  let panning = false, panStart = null, panMoved = false;
  svg.addEventListener('pointerdown', e => {
    if(e.target.closest('.node')) return;
    panning = true; panMoved = false;
    panStart = {x: e.clientX, y: e.clientY, tx, ty};
    container.classList.add('is-panning');
    svg.setPointerCapture(e.pointerId);
  });
  svg.addEventListener('pointermove', e => {
    if(!panning) return;
    panMoved = true;
    const rect = svg.getBoundingClientRect();
    const dx = (e.clientX - panStart.x) / rect.width * W;
    const dy = (e.clientY - panStart.y) / rect.height * H;
    tx = panStart.tx + dx;
    ty = panStart.ty + dy;
    applyTransform();
  });
  svg.addEventListener('pointerup', e => {
    // 空白处轻点（非拖拽）→ 清除聚焦/关抽屉。注意必须在 pointerup 判定，
    // 不能用 click 事件：节点 pointerdown 的 setPointerCapture 会把 click 派发到 svg，
    // 误判成"点空白"而把刚打开的抽屉立刻关掉。
    const wasEmptyTap = panning && !panMoved;
    panning = false;
    container.classList.remove('is-panning');
    if(wasEmptyTap && focusedNode) clearFocus();
    else if(wasEmptyTap && focusedCat !== null) clearCategoryFocus();
  });
  svg.addEventListener('pointercancel', () => { panning = false; container.classList.remove('is-panning'); });

  // ==== 节点拖动 ====
  let dragNode = null, dragStart = null, dragStartScreen = null;
  nodes.forEach(n => {
    n._g.addEventListener('pointerdown', e => {
      e.stopPropagation();
      dragNode = n;
      dragStart = screenToWorld(e.clientX, e.clientY);
      dragStartScreen = {x: e.clientX, y: e.clientY};
      n.fx = n.x; n.fy = n.y;
      n._g.classList.add('dragging');
      svg.setPointerCapture(e.pointerId);
      energy = 1; wake();  // 重新激活模拟 + 唤醒循环（静止后停了也能拖）
    });
    // 点击在 document 的 pointerup 里统一处理（避免 setPointerCapture 导致 click 不触发 + 防双开）
    n._g.addEventListener('pointerenter', () => {
      const nb = neighbors.get(n.id);
      // dim 所有 / highlight 自身和邻居
      nodes.forEach(m => {
        if(m === n || nb.has(m.id)) m._g.classList.remove('dim'), m._g.classList.add('highlight');
        else m._g.classList.add('dim'), m._g.classList.remove('highlight');
      });
      links.forEach((l, i) => {
        const adj = (l.source === n.id || l.target === n.id);
        if(adj) linkEls[i].classList.add('highlight'), linkEls[i].classList.remove('dim');
        else linkEls[i].classList.add('dim'), linkEls[i].classList.remove('highlight');
      });
      // tooltip
      tooltip.innerHTML = `<b>${escapeHtml(n.id)}</b><br>
        <span style="color:var(--fg-muted)">${escapeHtml(catLabelOf(n.h1))}</span><br>
        ${EN ? `in ${n.count} groups` : `分组数: ${n.count}`}${n.chain ? ' · <span style="color:var(--chain)">⛓</span>' : ''}`;
      tooltip.classList.add('visible');
    });
    n._g.addEventListener('pointermove', e => {
      const rect = container.getBoundingClientRect();
      tooltip.style.left = (e.clientX - rect.left + 14) + 'px';
      tooltip.style.top = (e.clientY - rect.top + 14) + 'px';
    });
    n._g.addEventListener('pointerleave', () => {
      tooltip.classList.remove('visible');
      if(focusedNode) setHighlight(focusedNode); else clearHighlight();  // 聚焦时离开 hover 不丢焦点
    });
  });

  document.addEventListener('pointermove', e => {
    if(!dragNode) return;
    // 用屏幕像素判定是否真的在拖动（之前用世界坐标阈值 4，约 <2px，导致正常点击被误判为拖动、抽屉打不开）
    if(dragStartScreen && Math.hypot(e.clientX - dragStartScreen.x, e.clientY - dragStartScreen.y) > 6){
      dragNode._dragMoved = true;
    }
    const w = screenToWorld(e.clientX, e.clientY);
    dragNode.fx = w.x; dragNode.fy = w.y;
    dragNode.x = w.x; dragNode.y = w.y;
    energy = 1;
  });
  document.addEventListener('pointerup', () => {
    if(dragNode){
      dragNode._g.classList.remove('dragging');
      // 没拖动 = 点击 → 打开详情抽屉。（不能依赖节点的 click 事件：pointerdown 时
      // svg.setPointerCapture 把后续 click 派发到了 svg，节点上的 click 永远不触发。）
      if(!dragNode._dragMoved){ openDrawer(dragNode); }
      dragNode.fx = null; dragNode.fy = null;
      dragNode._dragMoved = false;
      dragNode = null; dragStartScreen = null;
    }
  });

  // ==== 力学模拟（每帧一步） ====
  let energy = 1;
  let paused = false;

  function tick(){
    const repulse = 950;
    const linkDist = 70, linkChainDist = 50;
    const damping = 0.82;

    // 排斥（O(n²) - n=200 量级，没问题）
    for(let i=0;i<nodes.length;i++){
      const a = nodes[i];
      for(let j=i+1;j<nodes.length;j++){
        const b = nodes[j];
        let dx = a.x - b.x, dy = a.y - b.y;
        let d2 = dx*dx + dy*dy;
        if(d2 < 0.5) { dx = (Math.random()-.5); dy = (Math.random()-.5); d2 = dx*dx + dy*dy + 0.5; }
        const d = Math.sqrt(d2);
        const f = repulse / d2;
        a.vx += dx/d * f; a.vy += dy/d * f;
        b.vx -= dx/d * f; b.vy -= dy/d * f;
      }
    }

    // 链路吸引
    for(const l of links){
      const a = nodeMap.get(l.source), b = nodeMap.get(l.target);
      if(!a || !b) continue;
      const dx = b.x - a.x, dy = b.y - a.y;
      const d = Math.sqrt(dx*dx + dy*dy) + 0.01;
      const target = l.chain ? linkChainDist : linkDist;
      const k = l.chain ? 0.06 : 0.025;
      const f = (d - target) * k;
      a.vx += dx/d * f; a.vy += dy/d * f;
      b.vx -= dx/d * f; b.vy -= dy/d * f;
    }

    // 类簇中心引力
    nodes.forEach(n => {
      const c = catCenter.get(n.h1);
      if(!c) return;
      n.vx += (c.x - n.x) * 0.012;
      n.vy += (c.y - n.y) * 0.012;
    });

    // 全局中心引力（极弱）
    nodes.forEach(n => {
      n.vx += (cx - n.x) * 0.0008;
      n.vy += (cy - n.y) * 0.0008;
    });

    // 阻尼 + 位置更新（带能量退火）
    let totalV = 0;
    nodes.forEach(n => {
      n.vx *= damping; n.vy *= damping;
      const step = 0.4 * energy + 0.15;
      if(n.fx == null){
        n.x += n.vx * step;
        n.y += n.vy * step;
      } else {
        n.x = n.fx; n.y = n.fy;
        n.vx = 0; n.vy = 0;
      }
      // 边界
      n.x = Math.max(40, Math.min(W - 40, n.x));
      n.y = Math.max(40, Math.min(H - 40, n.y));
      totalV += Math.abs(n.vx) + Math.abs(n.vy);
    });

    // 能量退火（无交互时逐渐冷却到 0，便于静止后停掉 rAF）
    if(totalV / nodes.length < 0.5) energy *= 0.985;
    energy = Math.max(0, Math.min(1, energy));
  }

  function render(){
    nodes.forEach(n => {
      n._g.setAttribute('transform', `translate(${n.x},${n.y})`);
    });
    links.forEach((l, i) => {
      const a = nodeMap.get(l.source), b = nodeMap.get(l.target);
      if(!a || !b) return;
      // 二次贝塞尔：控制点在中点沿法线偏移，弧度 ∝ 距离（封顶），让平行边分开、更有机
      const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;
      const dx = b.x - a.x, dy = b.y - a.y;
      const len = Math.hypot(dx, dy) || 1;
      const off = Math.min(len * 0.12, 26);
      const cx2 = mx + (-dy / len) * off, cy2 = my + (dx / len) * off;
      linkEls[i].setAttribute('d', `M${a.x},${a.y} Q${cx2},${cy2} ${b.x},${b.y}`);
    });
  }

  const REDUCE = !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
  const STOP = 0.06;   // 能量低于此 + 无拖动 → 停掉动画循环（打开就安静、不空转耗电）
  function loop(){
    if(!paused) tick();
    render();
    // 静止（能量耗尽 / 暂停）且未在拖动 → 停 rAF；交互时由 wake() 唤醒
    if((paused || energy <= STOP) && !dragNode){ _graphAnim = null; return; }
    _graphAnim = requestAnimationFrame(loop);
  }
  function wake(boost){          // 交互时唤醒动画循环（拖动/重置/取消暂停）
    if(boost) energy = Math.max(energy, boost);
    if(!_graphAnim) _graphAnim = requestAnimationFrame(loop);  // loop 内的停止条件会处理 paused/拖动结束
  }
  // 预热：reduced-motion 多跑 tick 充分收敛；渲染一次。reduced-motion 不常驻循环（静止呈现），交互时再 wake 短跑
  for(let i=0; i < (REDUCE ? 400 : 120); i++) tick();
  render();
  if(!REDUCE) loop();

  // 双击节点：长按到该位置（pin）
  nodes.forEach(n => {
    n._g.addEventListener('dblclick', e => {
      e.stopPropagation();
      if(n.fx != null){ n.fx = null; n.fy = null; }
      else { n.fx = n.x; n.fy = n.y; }
    });
  });

  // ==== 控件 ====
  container.appendChild(svg);
  // 入场淡入（非 reduced-motion）：先 opacity 0，下一帧过渡到 1
  if(!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches)){
    container.classList.add('entering');
    requestAnimationFrame(() => requestAnimationFrame(() => container.classList.remove('entering')));
  }

  const ICON = {
    pause: '<svg class="gc-icon" viewBox="0 0 24 24"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>',
    play:  '<svg class="gc-icon" viewBox="0 0 24 24"><polygon points="7,5 19,12 7,19" fill="currentColor" stroke="none"/></svg>',
    reset: '<svg class="gc-icon" viewBox="0 0 24 24"><path d="M4 4v6h6"/><path d="M20 12a8 8 0 0 1-15.5 3"/><path d="M4 10a8 8 0 0 1 15.5-3"/></svg>',
    zoomIn:  '<svg class="gc-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M21 21l-5.5-5.5M8 11h6M11 8v6"/></svg>',
    zoomOut: '<svg class="gc-icon" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6"/><path d="M21 21l-5.5-5.5M8 11h6"/></svg>',
    fit: '<svg class="gc-icon" viewBox="0 0 24 24"><path d="M4 9V5h4M20 9V5h-4M4 15v4h4M20 15v4h-4"/></svg>',
    labels: '<svg class="gc-icon" viewBox="0 0 24 24"><path d="M5 19l4-14 4 14M7 14h4M14 19V8h3a3 3 0 0 1 0 6h-3"/></svg>'
  };

  const ctrls = document.createElement('div');
  ctrls.className = 'graph-controls';
  ctrls.innerHTML = `
    <button class="gc-btn" data-act="pause" title="${EN ? 'Pause / resume' : '暂停 / 继续'}">${ICON.pause}</button>
    <button class="gc-btn" data-act="reset" title="${EN ? 'Reset layout' : '重置布局'}">${ICON.reset}</button>
    <div class="graph-zoom-row">
      <button class="gc-btn" data-act="zoom-out" title="${EN ? 'Zoom out' : '缩小'}">${ICON.zoomOut}</button>
      <button class="gc-btn" data-act="zoom-in" title="${EN ? 'Zoom in' : '放大'}">${ICON.zoomIn}</button>
    </div>
    <button class="gc-btn gc-zoom" data-act="zoom" title="${EN ? 'Reset zoom' : '重置缩放'}">100%</button>
    <button class="gc-btn" data-act="labels" title="${EN ? 'Toggle all labels' : '切换全部标签'}">${ICON.labels}</button>`;
  container.appendChild(ctrls);

  function updateZoomLabel(){
    ctrls.querySelector('[data-act="zoom"]').textContent = Math.round(scale * 100) + '%';
  }
  function zoomTo(s){
    scale = Math.max(0.3, Math.min(4, s));
    applyTransform(); updateZoomLabel();
  }
  function fitView(){ scale = 1; tx = 0; ty = 0; applyTransform(); updateZoomLabel(); }
  fitView();

  ctrls.querySelector('[data-act="pause"]').addEventListener('click', e => {
    paused = !paused;
    e.currentTarget.innerHTML = paused ? ICON.play : ICON.pause;
    e.currentTarget.classList.toggle('active', paused);
    if(!paused){ energy = 1; wake(); }
  });
  ctrls.querySelector('[data-act="reset"]').addEventListener('click', () => {
    nodes.forEach(n => {
      const c = catCenter.get(n.h1) || {x: cx, y: cy};
      n.x = c.x + (Math.random()-.5) * 200;
      n.y = c.y + (Math.random()-.5) * 200;
      n.vx = 0; n.vy = 0;
      n.fx = null; n.fy = null;
    });
    energy = 1; wake();
    fitView();
  });
  ctrls.querySelector('[data-act="zoom-in"]').addEventListener('click', () => {
    // 放大到屏幕中心
    const oldScale = scale;
    scale = Math.min(4, scale * 1.25);
    tx = W/2 - (W/2 - tx) * (scale / oldScale);
    ty = H/2 - (H/2 - ty) * (scale / oldScale);
    applyTransform(); updateZoomLabel();
  });
  ctrls.querySelector('[data-act="zoom-out"]').addEventListener('click', () => {
    const oldScale = scale;
    scale = Math.max(0.3, scale * 0.8);
    tx = W/2 - (W/2 - tx) * (scale / oldScale);
    ty = H/2 - (H/2 - ty) * (scale / oldScale);
    applyTransform(); updateZoomLabel();
  });
  ctrls.querySelector('[data-act="zoom"]').addEventListener('click', fitView);
  let allLabels = false;
  ctrls.querySelector('[data-act="labels"]').addEventListener('click', e => {
    allLabels = !allLabels;
    e.currentTarget.classList.toggle('active', allLabels);
    nodes.forEach(n => n._t.classList.toggle('always', allLabels || alwaysLabelSet.has(n.id)));
  });

  // 图例
  const legend = document.createElement('div');
  legend.className = 'legend';
  // 简短大类名（去掉"一、二、…"前缀；保留主题词）
  function shortCat(t){
    return t.replace(/^[一二三四五六七八九十]+、\s*/, '').replace(/^\d+\.\s*/, '')
            .replace(/（[^）]*）/g, '').replace(/\s*\([^)]*\)\s*$/g, '');
  }
  const catLegend = DATA.sections.map((s, i) => {
    const hue = accentHues[i % accentHues.length];
    return `<div class="legend-cat" data-ci="${i}" title="${escapeAttr(pickT(s.title_en, s.title))}"><span class="swatch" style="background:hsl(${hue},70%,${catLight(i)}%);color:hsl(${hue},70%,${catLight(i)}%)"></span><span>${escapeHtml(catAbbr(s.title) || shortCat(pickT(s.title_en, s.title)))}</span></div>`;
  }).join('');
  legend.innerHTML = `<b>${t('graph_title')}</b>
    <div style="margin-top:4px">${t('graph_l_node')}</div>
    <div>${t('graph_legend_chain')}</div>
    <div style="color:var(--fg-muted)">${t('graph_l_ctrl')}</div>
    <div class="legend-cats">${catLegend}</div>
    <div class="legend-hint">${EN ? 'Tap a category to isolate its cluster' : '点分类可单独聚焦该类簇'}</div>`;
  // legend 加宽
  legend.style.maxWidth = '300px';
  container.appendChild(legend);
  // 图例分类可点：单独聚焦该类簇（高亮本类节点 + 类内连线，居中），再点同一项取消
  legend.querySelectorAll('.legend-cat').forEach(el => el.addEventListener('click', () => focusCategory(+el.dataset.ci)));

  // ==== 视图坞：策展预设（全部 / 强绑定 / 最常联用）====
  let hubId = null, hubDeg = -1;
  neighbors.forEach((set, id) => { if(set.size > hubDeg){ hubDeg = set.size; hubId = id; } });
  const PRESETS = [
    { f: 'all',   label: EN ? '🌐 All' : '🌐 全部' },
    { f: 'chain', label: EN ? '⛓ Chained' : '⛓ 强绑定' },
  ];
  const dock = document.createElement('div');
  dock.className = 'views-dock';
  const presetChips = PRESETS.map(p =>
    `<button class="vd-chip${p.f === currentFilter ? ' active' : ''}" data-preset="${p.f}">${p.label}</button>`).join('');
  const hubChip = hubId ? `<button class="vd-chip" data-preset="hub" title="${escapeAttr(hubId)}">${EN ? '🔥 Most connected' : '🔥 最常联用'}</button>` : '';
  dock.innerHTML = `<div class="vd-row vd-presets"><span class="vd-label">${EN ? 'Views' : '视图'}</span>${presetChips}${hubChip}</div>`;
  container.appendChild(dock);
  dock.addEventListener('click', e => {
    const presetBtn = e.target.closest('[data-preset]');
    if(!presetBtn) return;
    const f = presetBtn.dataset.preset;
    if(f === 'hub'){ if(hubId && nodeMap.has(hubId)) openDrawer(nodeMap.get(hubId)); return; }
    const pill = document.querySelector(`.toolbar .pill[data-filter="${f}"]`);
    if(pill) pill.click();   // 复用工具栏过滤逻辑（重建图 + 同步 URL）
  });
}

// === AI 推荐（轻量 TF-IDF + 同义词扩展） ===
const SYNONYMS = {
  'gtm': ['go-to-market','launch','release','发布'],
  '发布': ['launch','gtm','release','上线'],
  '推广': ['marketing','growth','营销','增长'],
  '原型': ['prototype','mockup','原型','实验'],
  '面试': ['interview','面试','candidate','简历'],
  '简历': ['resume','cv','简历'],
  '招聘': ['hire','recruit','招聘'],
  '需求': ['prd','spec','需求文档'],
  'prd': ['spec','需求','requirement'],
  '调试': ['debug','调试','bug','故障'],
  '测试': ['test','tdd','testing','测试'],
  '安全': ['security','audit','审计','漏洞'],
  '部署': ['deploy','部署','上线','ship'],
  '记忆': ['memory','记忆','上下文'],
  '上下文': ['context','memory','context engineering'],
  '抓取': ['scrape','crawl','fetch','抓取'],
  '翻译': ['translate','translation','翻译'],
  '简介': ['readme','文档','documentation'],
  '会议': ['meeting','纪要','transcript'],
  '产品经理': ['pm','product manager','产品'],
  '客户': ['customer','user','user research','用户'],
  '设计': ['design','ui','ux','视觉'],
  'logo': ['logo','brand','identity','品牌'],
};
function expandQuery(q){
  q = q.toLowerCase();
  const tokens = new Set(q.split(/[\s,，。、/]+/).filter(Boolean));
  for(const [k, syns] of Object.entries(SYNONYMS)){
    if(q.includes(k)) syns.forEach(s => tokens.add(s.toLowerCase()));
    syns.forEach(s => { if(q.includes(s.toLowerCase())) tokens.add(k); });
  }
  return [...tokens];
}
function scoreRow(row, queryTokens){
  const text = (row.skills.join(' ') + ' ' + row.group + ' ' + row.description + ' ' +
                (row.use_case||'') + ' ' + (row.personas||[]).join(' ') + ' ' +
                row._h1 + ' ' + row._h2).toLowerCase();
  let score = 0;
  queryTokens.forEach(t => {
    if(!t || t.length < 2) return;
    // 完整匹配 group: 高分
    if(row.group.toLowerCase().includes(t)) score += 5;
    // skill 名匹配
    if(row.skills.some(s => s.toLowerCase().includes(t))) score += 4;
    // 用例（场景）匹配：高信号
    if((row.use_case||'').toLowerCase().includes(t)) score += 3;
    // 描述匹配
    const occurrences = (text.match(new RegExp(t.replace(/[.*+?^${}()|[\]\\]/g,'\\$&'),'g'))||[]).length;
    score += occurrences * 1.5;
    // h1/h2 标题匹配（弱）
    if(row._h1.toLowerCase().includes(t)) score += 1;
    if(row._h2.toLowerCase().includes(t)) score += 1.5;
  });
  // ⛓ 强绑定加成
  if(row.chain) score *= 1.15;
  // star 加权（log 缩放）
  const maxStars = row.sources.reduce((m,s)=> Math.max(m, s.stars||0), 0);
  if(maxStars > 0) score *= (1 + Math.log10(maxStars+1) * 0.04);
  return score;
}
// === LLM BYOK 配置 ===
// 站点默认配置：通过 Cloudflare Worker 代理，key 在 worker 里不暴露。
// 访客打开网页 → 调用 proxyUrl（无需 Authorization）→ worker 加 key 转发到 OpenRouter。
// worker 端做白名单（仅 4 个 free 模型）+ 限速 + CORS，防止滥用。
const SITE_DEFAULT_LLM = {
  enabled:  true,
  proxyUrl: 'https://skills-atlas-llm.zita-go.workers.dev/v1/chat/completions',
};
const SITE_LLM_MODELS = [
  { id:'openai/gpt-oss-120b:free',          label:'gpt-oss-120b',          hint:'120B · 平衡（推荐）' },
  { id:'z-ai/glm-4.5-air:free',              label:'glm-4.5-air',           hint:'智谱 GLM · 中文强' },
  { id:'nvidia/nemotron-3-super-120b-a12b:free', label:'nemotron-3-super-120b', hint:'NVIDIA 120B · 慢但稳' },
  { id:'openai/gpt-oss-20b:free',           label:'gpt-oss-20b',           hint:'20B · 最快' },
];
const LLM_PRESETS = {
  openai:     { baseUrl: 'https://api.openai.com/v1',          model: 'gpt-4o-mini' },
  openrouter: { baseUrl: 'https://openrouter.ai/api/v1',       model: 'openai/gpt-oss-120b:free' },
  deepseek:   { baseUrl: 'https://api.deepseek.com/v1',        model: 'deepseek-chat' },
  moonshot:   { baseUrl: 'https://api.moonshot.cn/v1',         model: 'moonshot-v1-8k' },
  ollama:     { baseUrl: 'http://localhost:11434/v1',          model: 'llama3.1' },
};
const LLM_CFG_KEY = 'skills-atlas:llm-cfg';
const LLM_MODEL_KEY = 'skills-atlas:llm-model';
// 返回 {baseUrl, apiKey, model, source}：
//   source='byok' → 用户自填覆盖；
//   source='site' → 用站点默认 key + 当前选中的模型；
//   null → 无 LLM 可用，回退本地 TF-IDF。
function getLLMConfig(){
  // 1) 用户自填优先
  try{
    const raw = localStorage.getItem(LLM_CFG_KEY);
    if(raw){
      const cfg = JSON.parse(raw);
      if(cfg.apiKey && cfg.baseUrl && cfg.model){
        return { ...cfg, source: 'byok' };
      }
    }
  }catch(e){ /* ignore */ }
  // 2) 站点默认（通过 Cloudflare Worker 代理）
  if(SITE_DEFAULT_LLM.enabled && SITE_DEFAULT_LLM.proxyUrl){
    return {
      proxyUrl: SITE_DEFAULT_LLM.proxyUrl,
      model:    getCurrentModel(),
      source:   'site'
    };
  }
  return null;
}
function saveLLMConfig(cfg){
  localStorage.setItem(LLM_CFG_KEY, JSON.stringify(cfg));
}
function clearLLMConfig(){ localStorage.removeItem(LLM_CFG_KEY); }
function hasUserKey(){
  try{
    const raw = localStorage.getItem(LLM_CFG_KEY);
    if(!raw) return false;
    const cfg = JSON.parse(raw);
    return !!(cfg.apiKey && cfg.baseUrl && cfg.model);
  }catch(e){ return false; }
}
function getCurrentModel(){
  const m = localStorage.getItem(LLM_MODEL_KEY);
  // 必须在白名单内才认（防止 localStorage 被脏数据塞）
  if(m && SITE_LLM_MODELS.some(x => x.id === m)) return m;
  return SITE_LLM_MODELS[0].id;
}
function setCurrentModel(id){
  if(SITE_LLM_MODELS.some(x => x.id === id)) localStorage.setItem(LLM_MODEL_KEY, id);
}

function buildLLMPrompt(query, candidates){
  const lines = candidates.map((r, i) => {
    const skills = r.skills.join(' / ');
    const desc = (r.description || '').slice(0, 140);
    return `${i+1}. [${r._h1.split('、').slice(-1)[0]} / ${r._h2}] ${r.group} — ${skills}${desc?' :: '+desc:''}`;
  }).join('\n');
  return [
    {role: 'system', content: '你是一个 skill 推荐助手。用户给出一个目标，你从候选列表里挑出最相关的 6-12 个 skill 组合，按相关性从高到低排序，并给每个解释一句为什么。**严格只输出 JSON**，不要 markdown，不要前后缀文字。格式：{"results":[{"index":<候选序号 1-based>,"reason":"<10-30 字中文解释>"}]}。如果完全找不到相关项，返回 {"results":[]}。'},
    {role: 'user', content: `目标：${query}\n\n候选 skill 组合：\n${lines}\n\n返回 JSON。`}
  ];
}

async function callLLMRerank(query, candidates, cfg){
  // cfg 两种形态：
  //   byok: { baseUrl, apiKey, model }       → 直接调 LLM provider（前端带 Authorization）
  //   site: { proxyUrl, model }              → 调 Cloudflare Worker，worker 注入 key 转发
  const useProxy = !!cfg.proxyUrl;
  const url = useProxy
    ? cfg.proxyUrl
    : cfg.baseUrl.replace(/\/+$/,'') + '/chat/completions';
  const body = {
    model: cfg.model,
    messages: buildLLMPrompt(query, candidates),
    temperature: 0.2
    // 不加 response_format=json_object：实测 OpenRouter 部分 provider（如 OpenInference）
    // 在带 reasoning 模型 + json_object 同时启用时，会把答案写进 reasoning 而 content 为空。
    // 系统 prompt 已要求严格输出 JSON，模型基本都遵守。
  };
  const headers = { 'Content-Type': 'application/json' };
  if(!useProxy){
    headers['Authorization'] = 'Bearer ' + cfg.apiKey;
    // OpenRouter 推荐带这两个 header（用于站点识别和限流分流）
    if(/openrouter\.ai/i.test(cfg.baseUrl)){
      headers['HTTP-Referer'] = location.origin + location.pathname;
      headers['X-Title'] = 'Skills Atlas';
    }
  }
  const ctrl = new AbortController();
  const TIMEOUT_MS = 60000;
  let timedOut = false;
  const timer = setTimeout(() => { timedOut = true; ctrl.abort(); }, TIMEOUT_MS);
  let resp;
  try{
    resp = await fetch(url, {
      method: 'POST', headers,
      body: JSON.stringify(body),
      signal: ctrl.signal
    });
  } catch(err){
    if(timedOut) throw new Error('请求超时（60s 无响应）· free 模型常见，可换个模型再试');
    throw err;
  } finally { clearTimeout(timer); }
  if(!resp.ok){
    const text = await resp.text().catch(() => '');
    // 尝试解析 OpenRouter / OpenAI 标准错误对象
    let detail = text.slice(0, 200);
    try{
      const j = JSON.parse(text);
      const e = j.error || j;
      detail = e.message || detail;
      if(e.metadata && e.metadata.raw) detail += ' :: ' + e.metadata.raw.slice(0, 120);
    }catch(_){}
    if(resp.status === 429){
      throw new Error(`HTTP 429 限流：${detail}（免费模型常见，可换个模型再试）`);
    }
    throw new Error(`HTTP ${resp.status}: ${detail}`);
  }
  // 有些 provider 即使 200 也会把 error 塞 body 里
  const data = await resp.json();
  if(data.error){
    const e = data.error;
    const raw = e.metadata?.raw || '';
    throw new Error(`${e.message || 'provider error'}${raw ? ' :: '+raw.slice(0,120) : ''}`);
  }
  // 推理模型（gpt-oss 等）可能把 JSON 答案放进 reasoning_content / reasoning 而非 content。
  // 把所有可能的字段拼起来再做 JSON 提取。
  const msg = data.choices?.[0]?.message || {};
  const candidates_text = [
    msg.content, msg.reasoning_content, msg.reasoning, msg.refusal
  ].filter(s => typeof s === 'string' && s.trim()).join('\n');
  const m = candidates_text.match(/\{[\s\S]*\}/);
  if(!m){
    const finishReason = data.choices?.[0]?.finish_reason || '?';
    const usage = data.usage || {};
    throw new Error(`LLM 返回空内容（finish=${finishReason} / tokens=${usage.completion_tokens||'?'}）· 换个模型试试`);
  }
  let parsed;
  try{ parsed = JSON.parse(m[0]); }
  catch(e){ throw new Error('JSON 解析失败: ' + e.message); }
  const arr = parsed.results || parsed.recommendations || [];
  if(!Array.isArray(arr)) throw new Error('LLM 返回 results 不是数组');
  // 把 LLM 给的 1-based index 映射回 candidates
  return arr.map(r => {
    const idx = (typeof r.index === 'number' ? r.index : parseInt(r.index, 10)) - 1;
    if(isNaN(idx) || idx < 0 || idx >= candidates.length) return null;
    return { ...candidates[idx], _llmReason: r.reason || '' };
  }).filter(Boolean);
}

function setupAI(){
  const overlay = document.getElementById('aiOverlay');
  const btn = document.getElementById('aiBtn');
  const closeBtn = document.getElementById('aiClose');
  const input = document.getElementById('aiInput');
  const results = document.getElementById('aiResults');
  const status = document.getElementById('aiStatus');
  const modeBadge = document.getElementById('aiModeBadge');
  const settingsPanel = document.getElementById('aiSettings');
  const settingsBtn = document.getElementById('aiSettingsBtn');
  const baseUrlInput = document.getElementById('llmBaseUrl');
  const modelInput = document.getElementById('llmModel');
  const apiKeyInput = document.getElementById('llmApiKey');
  const saveBtn = document.getElementById('llmSaveBtn');
  const clearBtn = document.getElementById('llmClearBtn');
  const testBtn = document.getElementById('llmTestBtn');
  const llmStatusEl = document.getElementById('llmStatus');

  function refreshModeBadge(){
    const cfg = getLLMConfig();
    if(!cfg){
      modeBadge.dataset.mode = 'local';
      modeBadge.textContent = t('mode_local');
      modeBadge.title = t('mode_local_title');
      return;
    }
    if(cfg.source === 'byok'){
      modeBadge.dataset.mode = 'llm';
      modeBadge.textContent = (LANG === 'en' ? 'LLM · own key · ' : 'LLM · 自有 key · ') + cfg.model;
      modeBadge.title = LANG === 'en' ? `Calling ${cfg.model} via ${cfg.baseUrl} (your key)` : `通过 ${cfg.baseUrl} 调用 ${cfg.model}（你的 key）`;
    } else {
      modeBadge.dataset.mode = 'llm';
      modeBadge.textContent = '✨ ' + (SITE_LLM_MODELS.find(m => m.id === cfg.model)?.label || cfg.model);
      modeBadge.title = LANG === 'en' ? `Site-default LLM (${cfg.model}) · proxied via worker, key not exposed · set your own quota in ⚙` : `站点默认 LLM (${cfg.model}) · 通过 worker 代理，不暴露 key · 想用自己的额度可在 ⚙ 里设置`;
    }
  }
  function loadConfigToForm(){
    // 只回填用户自有 key，不暴露站点默认 key
    if(!hasUserKey()){
      baseUrlInput.value = '';
      modelInput.value = '';
      apiKeyInput.value = '';
      return;
    }
    try{
      const cfg = JSON.parse(localStorage.getItem(LLM_CFG_KEY));
      baseUrlInput.value = cfg.baseUrl || '';
      modelInput.value = cfg.model || '';
      apiKeyInput.value = cfg.apiKey || '';
    }catch(e){ /* ignore */ }
  }
  function setLLMStatus(text, state){
    llmStatusEl.textContent = text;
    if(state) llmStatusEl.dataset.state = state; else llmStatusEl.removeAttribute('data-state');
  }
  function showStatus(html){
    status.innerHTML = html;
    status.classList.remove('hidden');
  }
  function hideStatus(){ status.classList.add('hidden'); }

  let aiReturnFocus = null;
  function open(){
    aiReturnFocus = document.activeElement;
    overlay.classList.remove('hidden');
    setTimeout(() => input.focus(), 50);
    refreshModeBadge();
    if(!input.value.trim()){
      results.innerHTML = `<div class="ai-empty">${t('ai_empty_default')}</div>`;
      hideStatus();
    }
  }
  function close(){ overlay.classList.add('hidden'); if(aiReturnFocus && aiReturnFocus.focus) aiReturnFocus.focus(); }

  function renderResults(rows, source){
    if(!rows.length){
      results.innerHTML = `<div class="ai-empty">${t('ai_empty_local')}</div>`;
      return;
    }
    results.innerHTML = rows.map(r => {
      const skills = r.skills.map(s => `<span class="skill-tag">${escapeHtml(s)}</span>`).join('');
      const score = r.score != null ? Math.round(r.score * 10) / 10 : null;
      const scoreHtml = score != null ? `<div class="ai-result-score">${score}</div>` : '';
      const reasonHtml = r._llmReason
        ? `<div class="ai-result-source"><strong>${LANG === 'en' ? 'LLM: ' : 'LLM：'}</strong>${escapeHtml(r._llmReason)}</div>` : '';
      return `<div class="ai-result-card" data-h1="${escapeAttr(slugify(r._h1))}"
        data-h2="${escapeAttr(slugify(r._h2))}" data-skills="${escapeAttr(r.skills[0])}">
        <div class="ai-result-head">
          <div class="ai-result-skills">${skills}${r.chain?'<span class="chain-badge">⛓</span>':''}</div>
          ${scoreHtml}
        </div>
        <div class="ai-result-group">${escapeHtml(r._h1)} · ${escapeHtml(r._h2)} · ${escapeHtml(r.group)}</div>
        <div class="ai-result-desc">${escapeHtml(r.description)}</div>
        ${reasonHtml}
      </div>`;
    }).join('');
    results.querySelectorAll('.ai-result-card').forEach(c => {
      c.addEventListener('click', () => {
        const target = c.dataset.h1 + '--' + c.dataset.h2;
        close();
        if(currentView !== 'cards'){
          document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
        }
        const inp = document.getElementById('search');
        inp.value = c.dataset.skills;
        currentSearch = c.dataset.skills;
        document.getElementById('clearBtn').style.display = 'block';
        const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none';
        applyFilter();
        setTimeout(() => {
          const el = document.getElementById(target);
          if(el) smoothScrollToEl(el);
        }, 100);
      });
    });
  }

  async function search(){
    const q = input.value.trim();
    if(!q){ results.innerHTML = `<div class="ai-empty">${t('ai_empty_noquery')}</div>`; hideStatus(); return; }
    const tokens = expandQuery(q);
    const allRows = getAllRows();
    const localScored = allRows.map(r => ({...r, score: scoreRow(r, tokens)}))
                               .filter(r => r.score > 0)
                               .sort((a,b) => b.score - a.score);

    const cfg = getLLMConfig();

    // 没 LLM → 纯本地匹配
    if(!cfg){
      if(localScored.length === 0){
        results.innerHTML = `<div class="ai-empty">${t('ai_empty_local_hint')}</div>`;
      } else {
        renderResults(localScored.slice(0, 12), 'local');
      }
      hideStatus();
      return;
    }

    // 有 LLM：全部 186 条 skill 都给它（~26k tokens，远低于 128k 上下文）
    // 让 LLM 视野完整，不会因 TF-IDF 评分缺漏而错过相关 skill
    const candidates = allRows.map(r => ({...r, score: 0}));
    showStatus(`<span class="ai-spin"></span><span>${LANG === 'en' ? `Calling ${escapeHtml(cfg.model)} to pick from ${candidates.length} skills…` : `调用 ${escapeHtml(cfg.model)} 从 ${candidates.length} 个 skill 中筛选…`}</span>`);
    try{
      const reranked = await callLLMRerank(q, candidates, cfg);
      hideStatus();
      if(!reranked.length){
        if(localScored.length > 0){
          showStatus(`<span>${LANG === 'en' ? 'LLM found no match — falling back to local TF-IDF top 12' : 'LLM 说没匹配，回退本地 TF-IDF top 12'}</span>`);
          renderResults(localScored.slice(0, 12), 'local-fallback');
        } else {
          results.innerHTML = `<div class="ai-empty">${t('ai_empty_llm')}</div>`;
        }
      } else {
        renderResults(reranked, 'llm');
      }
    }catch(err){
      console.warn('LLM rerank 失败:', err);
      const msg = err.message || String(err);
      if(localScored.length > 0){
        showStatus(`<span style="color:var(--err,#ff6b6b)">${LANG === 'en' ? `LLM call failed: ${escapeHtml(msg)} · fell back to local` : `LLM 调用失败：${escapeHtml(msg)} · 已回退本地`}</span>`);
        renderResults(localScored.slice(0, 12), 'local-fallback');
      } else {
        results.innerHTML = `<div class="ai-empty">${LANG === 'en' ? `LLM call failed: ${escapeHtml(msg)}<br><br>Local keyword match found nothing either. Try a different model?` : `LLM 调用失败：${escapeHtml(msg)}<br><br>本地关键词也没命中。试试切换其他模型？`}</div>`;
        hideStatus();
      }
    }
  }

  // 设置面板事件
  function toggleSettings(){
    const isHidden = settingsPanel.classList.toggle('hidden');
    settingsBtn.classList.toggle('active', !isHidden);
    if(!isHidden) loadConfigToForm();
  }
  settingsBtn.addEventListener('click', toggleSettings);

  saveBtn.addEventListener('click', () => {
    const cfg = {
      baseUrl: baseUrlInput.value.trim(),
      model: modelInput.value.trim(),
      apiKey: apiKeyInput.value.trim()
    };
    if(!cfg.baseUrl || !cfg.model || !cfg.apiKey){
      setLLMStatus(LANG === 'en' ? 'Fill in Base URL / Model / API Key' : '请填完 Base URL / Model / API Key', 'err'); return;
    }
    saveLLMConfig(cfg);
    setLLMStatus(LANG === 'en' ? 'Saved. Next picks will use your own key.' : '已保存。下次推荐将用你自己的 key。', 'ok');
    refreshModeBadge();
    renderModelPicker();
  });
  clearBtn.addEventListener('click', () => {
    clearLLMConfig();
    baseUrlInput.value = ''; modelInput.value = ''; apiKeyInput.value = '';
    const fallback = (SITE_DEFAULT_LLM.enabled && SITE_DEFAULT_LLM.proxyUrl)
      ? (LANG === 'en' ? 'site-default LLM' : '站点默认 LLM')
      : t('mode_local');
    setLLMStatus(LANG === 'en' ? `Cleared — falling back to ${fallback}` : `已清空，回退到${fallback}`, 'info');
    refreshModeBadge();
    renderModelPicker();
  });
  testBtn.addEventListener('click', async () => {
    const cfg = {
      baseUrl: baseUrlInput.value.trim(),
      model: modelInput.value.trim(),
      apiKey: apiKeyInput.value.trim()
    };
    if(!cfg.baseUrl || !cfg.model || !cfg.apiKey){
      setLLMStatus(LANG === 'en' ? 'Fill in Base URL / Model / API Key' : '请填完 Base URL / Model / API Key', 'err'); return;
    }
    setLLMStatus(LANG === 'en' ? 'Testing…' : '测试中…', 'info');
    try{
      const r = await callLLMRerank('hello world', [
        { _h1:'测试', _h2:'测试', group:'ping', skills:['ping'], description:'ping test', chain:false, sources:[] }
      ], cfg);
      setLLMStatus(LANG === 'en' ? `✓ Connected (returned ${r.length})` : `✓ 连通成功（返回 ${r.length} 条）`, 'ok');
    }catch(err){
      setLLMStatus(LANG === 'en' ? `✗ Failed: ${err.message || err}` : `✗ 失败：${err.message || err}`, 'err');
    }
  });
  document.querySelectorAll('.ai-settings-presets a').forEach(a => {
    a.addEventListener('click', e => {
      e.preventDefault();
      const p = LLM_PRESETS[a.dataset.preset];
      if(!p) return;
      baseUrlInput.value = p.baseUrl;
      modelInput.value = p.model;
      setLLMStatus(`已套用 ${a.dataset.preset} 预设，记得填 API Key 再保存`, 'info');
    });
  });

  btn.addEventListener('click', open);
  closeBtn.addEventListener('click', close);
  overlay.addEventListener('click', e => { if(e.target === overlay) close(); });
  document.addEventListener('keydown', e => {
    if(e.key === 'Escape' && !overlay.classList.contains('hidden')) close();
  });
  // 跟踪 IME 输入状态，避免中文输入法选词回车被误判为提交
  let composing = false;
  input.addEventListener('compositionstart', () => { composing = true; });
  input.addEventListener('compositionend', () => { composing = false; });
  input.addEventListener('keydown', e => {
    if(e.key !== 'Enter' || e.shiftKey) return;
    // Cmd/Ctrl + Enter：强制提交（即使在输入法选词中）
    if(e.metaKey || e.ctrlKey){ e.preventDefault(); search(); return; }
    // 普通 Enter：跳过 IME composition 中（中文输入法选词阶段）
    if(composing || e.isComposing || e.keyCode === 229) return;
    e.preventDefault();
    search();
  });
  const submitBtn = document.getElementById('aiSubmit');
  if(submitBtn){
    submitBtn.addEventListener('click', () => search());
  }
  document.querySelectorAll('.ai-tag').forEach(tag => {
    tag.addEventListener('click', () => {
      input.value = tag.dataset.q;
      search();
    });
  });

  function renderModelPicker(){
    const picker = document.getElementById('aiModelPicker');
    const chips = document.getElementById('aiModelChips');
    if(!picker || !chips) return;
    // 用户自填了 key 时，picker 没意义了（用用户自己 model）
    if(hasUserKey()){
      picker.classList.add('hidden');
      return;
    }
    // 站点默认 key 也没有 → 也隐藏（本地匹配模式）
    if(!(SITE_DEFAULT_LLM.enabled && SITE_DEFAULT_LLM.proxyUrl)){
      picker.classList.add('hidden');
      return;
    }
    picker.classList.remove('hidden');
    const cur = getCurrentModel();
    chips.innerHTML = SITE_LLM_MODELS.map(m =>
      `<button class="ai-model-chip" data-model="${escapeAttr(m.id)}"
        data-active="${m.id===cur ? 'true' : 'false'}"
        title="${escapeAttr(m.hint)}">${escapeHtml(m.label)}</button>`
    ).join('');
    chips.querySelectorAll('.ai-model-chip').forEach(b => {
      b.addEventListener('click', () => {
        setCurrentModel(b.dataset.model);
        renderModelPicker();
        refreshModeBadge();
      });
    });
  }

  // 启动初始化
  refreshModeBadge();
  renderModelPicker();
}

// === ⌘K Spotlight 搜索 ===
function fuzzyScore(query, target){
  // 连续子序列匹配 + 起首/连续奖励 + 完整子串大幅奖励
  if(!query) return 0;
  const q = query.toLowerCase();
  const t = target.toLowerCase();
  // 完整子串：直接高分（且越靠前越高）
  const idx = t.indexOf(q);
  if(idx >= 0){
    return 100 + (q.length / t.length) * 50 + Math.max(0, 30 - idx);
  }
  // 子序列 fuzzy
  let qi = 0, score = 0, streak = 0, prevMatch = -2;
  for(let ti = 0; ti < t.length && qi < q.length; ti++){
    if(t[ti] === q[qi]){
      score += 1;
      if(ti === prevMatch + 1) streak += 1.2;
      else streak = 0;
      score += streak;
      // 起首奖励：单词边界（空格/-/_/./）后的字符
      if(ti === 0 || /[\s\-_./]/.test(t[ti-1])) score += 2;
      prevMatch = ti;
      qi++;
    }
  }
  if(qi < q.length) return 0;  // query 没全部匹配上
  // 长度惩罚
  return score - (t.length - q.length) * 0.05;
}

function setupSpotlight(){
  const overlay = document.getElementById('spotlightOverlay');
  const input = document.getElementById('spotlightInput');
  const list = document.getElementById('spotlightList');
  const btn = document.getElementById('spotlightBtn');

  // 构建索引
  const items = [];
  const EN = LANG === 'en';
  // 1) skill 名
  const skillH1 = new Map();   // skillName -> h1Title (取首个出现的)
  const skillHue = new Map();  // skillName -> hue
  const skillTargets = new Map(); // skillName -> {h1Slug, h2Slug}
  getAllRows().forEach(row => {
    const h1Slug = slugify(row._h1);
    const h2Slug = slugify(row._h2);
    const hue = hueOf(row._h1);
    row.skills.forEach(sk => {
      if(!skillH1.has(sk)){
        skillH1.set(sk, row._h1);
        skillHue.set(sk, hue);
        skillTargets.set(sk, {h1Slug, h2Slug, group: row.group, group_en: row.group_en, h1en: row._h1en});
      }
    });
  });
  skillH1.forEach((h1, sk) => {
    const tgt = skillTargets.get(sk);
    items.push({
      kind: 'skill', icon: '◆', label: sk,
      meta: `${pickT(tgt.h1en, h1)} · ${pickT(tgt.group_en, tgt.group)}`,
      hue: skillHue.get(sk),
      action: () => jumpToSkill(sk, tgt)
    });
  });
  // 2) 功能分组（group）
  getAllRows().forEach(row => {
    const h1Slug = slugify(row._h1);
    const h2Slug = slugify(row._h2);
    items.push({
      kind: 'group', icon: row.chain ? '⛓' : '◇', label: pickT(row.group_en, row.group),
      meta: `${pickT(row._h1en, row._h1)} · ${pickT(row._h2en, row._h2)}` + (row.chain ? ' · ' + t('chain_word') : ''),
      hue: hueOf(row._h1),
      action: () => jumpToSection(`${h1Slug}--${h2Slug}`, row.skills[0])
    });
  });
  // 3) 大类 / 子分组
  DATA.sections.forEach(h1 => {
    items.push({
      kind: 'category', icon: h1.icon || H1_ICONS[h1.title] || '📌', label: pickT(h1.title_en, h1.title),
      meta: EN ? `category · ${h1.subsections.length} subgroups` : `大类 · ${h1.subsections.length} 子分组`,
      hue: hueOf(h1.title),
      action: () => jumpToSection(slugify(h1.title))
    });
    h1.subsections.forEach(h2 => {
      items.push({
        kind: 'sub', icon: '§', label: pickT(h2.title_en, h2.title),
        meta: `${pickT(h1.title_en, h1.title)} · ${h2.rows.length} ${EN ? 'groups' : '分组'}`,
        hue: hueOf(h1.title),
        action: () => jumpToSection(slugify(h1.title) + '--' + slugify(h2.title))
      });
    });
  });
  // 4) 仓库
  Object.entries(DATA.vendors).forEach(([id, v]) => {
    items.push({
      kind: 'repo', icon: '📦', label: id,
      meta: `${v.author || ''}/${v.repo || id} · ${v.type || 'skill'}`,
      hue: 215,
      action: () => jumpToRepo(id)
    });
  });

  let active = 0;
  let filtered = [];

  function jumpToSkill(skillName, tgt){
    closeSpotlight();
    if(currentView !== 'cards'){
      document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
    }
    const inp = document.getElementById('search');
    inp.value = skillName;
    currentSearch = skillName;
    document.getElementById('clearBtn').style.display = 'block';
    const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none';
    applyFilter();
    setTimeout(() => {
      const el = document.getElementById(`${tgt.h1Slug}--${tgt.h2Slug}`);
      if(el) smoothScrollToEl(el);
    }, 80);
  }
  function jumpToSection(targetId, focusSkill){
    closeSpotlight();
    if(currentView !== 'cards'){
      document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
    }
    // 清除搜索以确保章节可见
    const inp = document.getElementById('search');
    if(inp.value){
      inp.value = '';
      currentSearch = '';
      document.getElementById('clearBtn').style.display = 'none';
      const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'block';
      applyFilter();
    }
    setTimeout(() => {
      const el = document.getElementById(targetId);
      if(el){
        smoothScrollToEl(el);
        pushHash(targetId);
      }
      // 同步侧栏高亮
      const navH2 = document.querySelector(`.nav-h2[data-target="${targetId}"]`);
      if(navH2){
        document.querySelectorAll('.nav-h2').forEach(x => x.classList.remove('active'));
        navH2.classList.add('active');
        const section = navH2.closest('.nav-section');
        if(section) section.classList.add('expanded');
      }
    }, 80);
  }
  function jumpToRepo(repoId){
    closeSpotlight();
    if(currentView !== 'cards'){
      document.querySelector('#viewSwitch .view-btn[data-view="cards"]').click();
    }
    const inp = document.getElementById('search');
    inp.value = repoId;
    currentSearch = repoId;
    document.getElementById('clearBtn').style.display = 'block';
    const kbd = document.getElementById('kbdHint'); if(kbd) kbd.style.display = 'none';
    applyFilter();
    window.scrollTo({top: 0, behavior: 'smooth'});
  }

  function render(query){
    if(!query){
      // 默认显示分类型示例
      const groups = [
        {label: EN ? 'SKILL' : '技能', items: items.filter(x => x.kind === 'skill').slice(0, 4)},
        {label: EN ? 'GROUP' : '分组', items: items.filter(x => x.kind === 'group').slice(0, 4)},
        {label: EN ? 'CATEGORY' : '大类', items: items.filter(x => x.kind === 'category').slice(0, 4)},
        {label: EN ? 'REPO' : '仓库', items: items.filter(x => x.kind === 'repo').slice(0, 4)}
      ];
      filtered = [];
      let html = '';
      groups.forEach(g => {
        if(!g.items.length) return;
        html += `<div class="spotlight-section-label">${g.label}</div>`;
        g.items.forEach(it => {
          const i = filtered.length;
          filtered.push(it);
          html += renderRow(it, '', i);
        });
      });
      list.innerHTML = html || `<div class="spotlight-empty">${t('sp_empty_default')}</div>`;
    } else {
      // fuzzy match
      const scored = items.map(it => ({...it, _score: Math.max(
        fuzzyScore(query, it.label),
        fuzzyScore(query, it.meta) * 0.4
      )})).filter(x => x._score > 0)
        .sort((a, b) => {
          // 同分时按 kind 优先级：skill > group > sub > category > repo
          if(b._score - a._score > 0.5) return b._score - a._score;
          const order = {skill: 0, group: 1, sub: 2, category: 3, repo: 4};
          return (order[a.kind] || 9) - (order[b.kind] || 9);
        }).slice(0, 30);
      filtered = scored;
      if(!scored.length){
        list.innerHTML = `<div class="spotlight-empty">${t('sp_empty_none')}</div>`;
      } else {
        list.innerHTML = scored.map((it, i) => renderRow(it, query, i)).join('');
      }
    }
    active = 0;
    updateActive();
    bindRowClicks();
  }
  function renderRow(it, query, idx){
    const labelHtml = highlightFuzzy(it.label, query);
    const metaHtml = escapeHtml(it.meta);
    const kindLabel = {skill: 'skill', group: 'group', sub: 'sub', category: 'cat', repo: 'repo'}[it.kind] || it.kind;
    return `<div class="spotlight-result" data-idx="${idx}" style="--cat-hue:${it.hue||220}">
      <div class="sp-icon">${it.icon}</div>
      <div class="sp-body">
        <div class="sp-title">${labelHtml}</div>
        <div class="sp-meta">${metaHtml}</div>
      </div>
      <div class="sp-kind">${kindLabel}</div>
    </div>`;
  }
  function highlightFuzzy(label, query){
    if(!query) return escapeHtml(label);
    const q = query.toLowerCase();
    const t = label.toLowerCase();
    // 优先：完整子串
    const idx = t.indexOf(q);
    if(idx >= 0){
      return escapeHtml(label.slice(0, idx))
        + '<span class="match">' + escapeHtml(label.slice(idx, idx + q.length)) + '</span>'
        + escapeHtml(label.slice(idx + q.length));
    }
    // 否则按 fuzzy 字符高亮
    let qi = 0, out = '';
    for(let i = 0; i < label.length; i++){
      const ch = label[i];
      if(qi < q.length && t[i] === q[qi]){
        out += '<span class="match">' + escapeHtml(ch) + '</span>';
        qi++;
      } else {
        out += escapeHtml(ch);
      }
    }
    return out;
  }
  function updateActive(){
    list.querySelectorAll('.spotlight-result').forEach((el, i) => {
      el.classList.toggle('active', i === active);
      if(i === active){
        el.scrollIntoView({block:'nearest'});
      }
    });
  }
  function bindRowClicks(){
    list.querySelectorAll('.spotlight-result').forEach(el => {
      el.addEventListener('mouseenter', () => {
        active = parseInt(el.dataset.idx);
        updateActive();
      });
      el.addEventListener('click', () => {
        active = parseInt(el.dataset.idx);
        confirmActive();
      });
    });
  }
  function confirmActive(){
    const it = filtered[active];
    if(it && it.action) it.action();
  }

  let spotReturnFocus = null;
  function openSpotlight(){
    spotReturnFocus = document.activeElement;
    overlay.classList.remove('hidden');
    input.value = '';
    setTimeout(() => input.focus(), 30);
    render('');
  }
  function closeSpotlight(){
    overlay.classList.add('hidden');
    if(spotReturnFocus && spotReturnFocus.focus) spotReturnFocus.focus();
  }

  btn.addEventListener('click', openSpotlight);
  overlay.addEventListener('click', e => { if(e.target === overlay) closeSpotlight(); });
  input.addEventListener('input', () => render(input.value.trim()));
  input.addEventListener('keydown', e => {
    if(e.key === 'ArrowDown'){
      e.preventDefault();
      if(filtered.length){ active = (active + 1) % filtered.length; updateActive(); }
    } else if(e.key === 'ArrowUp'){
      e.preventDefault();
      if(filtered.length){ active = (active - 1 + filtered.length) % filtered.length; updateActive(); }
    } else if(e.key === 'Enter'){
      e.preventDefault();
      confirmActive();
    } else if(e.key === 'Escape'){
      e.preventDefault();
      closeSpotlight();
    }
  });
  document.addEventListener('keydown', e => {
    // Cmd/Ctrl + K
    if((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'){
      e.preventDefault();
      if(overlay.classList.contains('hidden')) openSpotlight();
      else closeSpotlight();
    }
    // 在 overlay 打开时 Esc 关闭（input handler 内已处理，但用户可能 focus 转移）
    if(e.key === 'Escape' && !overlay.classList.contains('hidden')) closeSpotlight();
  });
}

function setupTheme(){
  const btns = [...document.querySelectorAll('.js-theme')];   // 顶栏 + 侧栏（移动端）两处
  const saved = localStorage.getItem('theme') || 'dark';
  if(saved === 'light'){ document.documentElement.classList.add('light'); }
  // 拆成 emoji + 文字两段，窄屏顶栏只留 emoji（见 @media）；侧栏保留文字
  const paint = (light) => {
    const sfull = light ? t('theme_light') : t('theme_dark');
    const i = sfull.indexOf(' ');
    const emoji = i >= 0 ? sfull.slice(0, i) : sfull, lbl = i >= 0 ? sfull.slice(i + 1) : '';
    btns.forEach(b => { b.innerHTML = `<span class="tg-emoji" aria-hidden="true">${emoji}</span><span class="tg-lbl">${escapeHtml(lbl)}</span>`; });
  };
  paint(saved === 'light');
  btns.forEach(b => b.addEventListener('click', () => {
    const isLight = document.documentElement.classList.toggle('light');
    paint(isLight);
    localStorage.setItem('theme', isLight ? 'light' : 'dark');
  }));
}

function setupMenuBtn(){
  const sidebar = document.getElementById('sidebar');
  const app = document.getElementById('app');
  const toggleBtn = document.getElementById('sidebarToggle');
  const railBtn = document.getElementById('sidebarRail');
  const STORAGE_KEY = 'atlas:sidebar:collapsed';

  // 移动端抽屉
  document.getElementById('menuBtn').addEventListener('click', () => {
    sidebar.classList.toggle('open');
  });
  document.getElementById('nav').addEventListener('click', e => {
    if(window.innerWidth < 900 && e.target.classList.contains('nav-h2')){
      sidebar.classList.remove('open');
    }
  });

  // 桌面端折叠：恢复用户偏好
  function applyCollapsed(collapsed){
    if(window.innerWidth < 900) return;  // 移动端忽略
    app.classList.toggle('sidebar-collapsed', !!collapsed);
  }
  let collapsed = false;
  try { collapsed = localStorage.getItem(STORAGE_KEY) === '1'; } catch(_){}
  applyCollapsed(collapsed);

  function setCollapsed(v){
    collapsed = v;
    applyCollapsed(v);
    try { localStorage.setItem(STORAGE_KEY, v ? '1' : '0'); } catch(_){}
  }

  toggleBtn?.addEventListener('click', () => {
    if(window.innerWidth < 900){ sidebar.classList.remove('open'); }  // 移动端：关抽屉
    else { setCollapsed(true); }                                      // 桌面：折叠
  });
  railBtn?.addEventListener('click', () => setCollapsed(false));
  // 移动端：点背景遮罩关抽屉
  document.getElementById('sidebarBackdrop')?.addEventListener('click', () => {
    sidebar.classList.remove('open');
  });

  // 快捷键：[ 切换桌面侧栏；focus 在 input 时不响应
  document.addEventListener('keydown', e => {
    if(e.key !== '[') return;
    const t = e.target;
    if(t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;
    if(window.innerWidth < 900) return;
    e.preventDefault();
    setCollapsed(!collapsed);
  });

  // 窗口尺寸跨越断点时同步状态
  window.addEventListener('resize', () => {
    if(window.innerWidth < 900){
      app.classList.remove('sidebar-collapsed');
    } else {
      sidebar.classList.remove('open');  // 跨回桌面：清掉移动端抽屉态
      if(collapsed) app.classList.add('sidebar-collapsed');
    }
  });
}

function setupScrollSpy(){
  const observer = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if(e.isIntersecting){
        const id = e.target.id;
        document.querySelectorAll('.nav-h2').forEach(a => a.classList.toggle('active', a.dataset.target === id));
        const navH2 = document.querySelector(`.nav-h2[data-target="${id}"]`);
        const section = navH2 && navH2.closest('.nav-section');
        if(section){
          // 滚动跟随：自动展开当前大类、高亮，收起其它
          document.querySelectorAll('.nav-section').forEach(s => {
            const on = s === section;
            s.classList.toggle('expanded', on);
            const h1 = s.querySelector('.nav-h1'); if(h1) h1.classList.toggle('active', on);
          });
        }
      }
    });
  }, {rootMargin: '-30% 0px -60% 0px'});
  document.querySelectorAll('.section-h2').forEach(h => observer.observe(h));
}

// Hero「技能地图」：按大类 group 数铺成 treemap（面积∝规模），点击跳到该分类。
// 用递归二分（交替方向）布局，鲁棒且长宽比尚可；色块用各大类色相。
function buildHeroMap(pal){
  const host = document.getElementById('heroMap');
  if(!host) return;
  const PAL = (pal && pal.length) ? pal : HERO_PALETTE;
  // 高度对齐左侧文字栏，消除右侧留白（地图也随之更大）
  const txtH = (document.querySelector('.hero-text') || {}).offsetHeight || 0;
  const W = Math.max(240, Math.round(host.clientWidth) || 360);
  const H = Math.max(244, Math.min(360, txtH ? txtH - 28 : 244));
  host.style.height = H + 'px';
  const short = t => t.replace(/^[一二三四五六七八九十]+、\s*/, '').replace(/^\d+[\.、]\s*/, '')
                      .replace(/（[^）]*）/g, '').replace(/\s*\([^)]*\)\s*$/g, '').trim()
                      .split(/\s*[\/／&]\s*/)[0].trim();   // 取首段，标签更短不易裁切
  // 配色与 graph 统一：catColor(大类序号) —— 柔和较浅、协调，深浅底通用
  const cats = DATA.sections.map((h1, i) => ({
    i, title: pickT(h1.title_en, h1.title), abbr: catAbbr(h1.title), icon: h1.icon || H1_ICONS[h1.title] || '·',
    v: h1.subsections.reduce((s, h2) => s + h2.rows.length, 0)
  })).filter(c => c.v > 0).sort((a, b) => b.v - a.v);
  if(!cats.length) return;
  // 默认：浅色系（高亮度、略降饱和，更高级不糖果）；传 pal 时用于试色
  cats.forEach((c, si) => { c.col = pal ? PAL[si % PAL.length] : `hsl(${catHue(c.i)}, 44%, 75%)`; });
  const rects = [];
  (function slice(items, x, y, w, h, horiz){
    if(items.length === 1){ rects.push({ ...items[0], x, y, w, h }); return; }
    const total = items.reduce((s, o) => s + o.v, 0);
    let acc = 0, k = 0;
    while(k < items.length - 1 && acc + items[k].v < total / 2){ acc += items[k].v; k++; }
    if(k === 0) k = 1;
    const A = items.slice(0, k), B = items.slice(k);
    const aFrac = A.reduce((s, o) => s + o.v, 0) / total;
    if(horiz){ const w1 = w * aFrac; slice(A, x, y, w1, h, !horiz); slice(B, x + w1, y, w - w1, h, !horiz); }
    else { const h1 = h * aFrac; slice(A, x, y, w, h1, !horiz); slice(B, x, y + h1, w, h - h1, !horiz); }
  })(cats, 0, 0, W, H, W >= H);
  const GAP = 3;
  host.innerHTML = rects.map(r => {
    const tw = Math.max(0, r.w - GAP), th = Math.max(0, r.h - GAP);
    // 图标始终显示（小块用小号）；名称只在够高够宽时出现（避免裁切/拥挤）；中等块显示数量
    const tiny = th < 30 || tw < 30;
    const nm = escapeHtml(r.abbr || short(r.title));   // 简称
    let label, row = false;
    if(th > 54 && tw > 58){            // 够高：纵向 图标 / 名称 / 数量
      label = `<span class="hm-ic">${r.icon}</span><span class="hm-nm">${nm}</span><b class="hm-ct">${r.v}</b>`;
    } else if(th >= 34 && tw > 96){    // 又宽又矮：横向 图标 名称 …… 数量（避免三行挤压）
      row = true;
      label = `<span class="hm-ic">${r.icon}</span><span class="hm-nm">${nm}</span><b class="hm-ct">${r.v}</b>`;
    } else if(tw > 32 && th > 28){     // 中小块：图标 + 数量
      label = `<span class="hm-ic${tiny ? ' tiny' : ''}">${r.icon}</span><b class="hm-ct sm">${r.v}</b>`;
    } else {                           // 极小块：仅图标
      label = `<span class="hm-ic${tiny ? ' tiny' : ''}">${r.icon}</span>`;
    }
    const txt = (r.col.charAt(0) === '#' && hexLum(r.col) <= 0.5) ? '#f4f7fb' : '#15171c';
    return `<button class="hm-tile${row ? ' row' : ''}" data-idx="${r.i}" title="${escapeAttr(r.title + ' · ' + r.v + (LANG === 'en' ? ' groups' : ' 个分组'))}" style="left:${(r.x + GAP / 2).toFixed(1)}px;top:${(r.y + GAP / 2).toFixed(1)}px;width:${tw.toFixed(1)}px;height:${th.toFixed(1)}px;--tile:${r.col};--txt:${txt}">${label}</button>`;
  }).join('');
  host.querySelectorAll('.hm-tile').forEach(tl => tl.addEventListener('click', () => {
    const el = document.querySelectorAll('.section-h1')[+tl.dataset.idx];
    if(el) smoothScrollToEl(el);
  }));
}

/* ===== 用法内联 + 一键安装命令 ===== */
// Worker 兜底代理（raw 自带 CORS，直取失败时才走它）
const RAW_PROXY = SITE_DEFAULT_LLM.proxyUrl.replace(/\/v1\/chat\/completions$/, '/raw');
const _docCache = new Map();

function rawUrl(author, repo, branch, path){
  return `https://raw.githubusercontent.com/${author}/${repo}/${branch || 'main'}/${path}`;
}
function candidatePaths(docpath){
  return docpath ? [docpath]
    : ['SKILL.md', 'README.md', 'readme.md', 'Readme.md', 'docs/SKILL.md', '.claude/SKILL.md'];
}
function withTimeout(promise, ms){
  return Promise.race([promise,
    new Promise((_, rej) => setTimeout(() => rej(new Error('timeout')), ms))]);
}
async function fetchDoc(d){
  const branch = d.branch || 'main';
  const key = `${d.author}/${d.repo}@${branch}:${d.docpath || '*'}`;
  if(_docCache.has(key)) return _docCache.get(key);
  let lastErr = null;
  for(const p of candidatePaths(d.docpath)){
    const direct = rawUrl(d.author, d.repo, branch, p);
    for(const u of [direct, `${RAW_PROXY}?u=${encodeURIComponent(direct)}`]){
      try{
        const r = await withTimeout(fetch(u, { redirect: 'follow' }), 8000);
        if(r.ok){
          const out = { text: await r.text(), path: p };
          _docCache.set(key, out);
          return out;
        }
      }catch(e){ lastErr = e; }
    }
  }
  throw lastErr || new Error('not found');
}

// 极简、安全的 Markdown 渲染器：先整体 escapeHtml 中和所有 HTML/XSS，
// 再只产出固定白名单标签；链接仅允许 http(s)，不渲染图片。
function renderMarkdown(src){
  src = String(src).slice(0, 200000);                 // 限大小，防超大 README 卡顿
  const blocks = [];
  src = src.replace(/```[^\n]*\n([\s\S]*?)```/g, (_, code) => {
    blocks.push(code); return `\u0000B${blocks.length - 1}\u0000`;
  });
  // 去掉 README 里的 HTML 标签噪音（代码块已抽出；之后仍 escape，安全）
  src = src.replace(/<\/?[a-zA-Z][^>]*>/g, '');
  let h = escapeHtml(src);                             // 关键：先转义全文
  // 行内（在已转义文本上）：代码 / 粗体 / 斜体 / 链接
  h = h.replace(/`([^`\n]+)`/g, (_, c) => `<code>${c}</code>`)
       .replace(/\*\*([^*\n]+)\*\*/g, '<strong>$1</strong>')
       .replace(/(^|[^*])\*([^*\n]+)\*/g, '$1<em>$2</em>')
       .replace(/\[([^\]\n]+)\]\(([^)\s]+)\)/g, (m, txt, url) =>
          /^https?:\/\//i.test(url)
            ? `<a href="${url.replace(/"/g, '&quot;')}" target="_blank" rel="noopener noreferrer nofollow">${txt}</a>`
            : m);                                      // 非 http(s) 链接降级为纯文本
  // 块级：按行组装 h1-3 / ul / p / 代码块占位
  const lines = h.split('\n');
  let out = '', inList = false;
  const closeList = () => { if(inList){ out += '</ul>'; inList = false; } };
  for(const line of lines){
    const t = line.trim();
    if(!t){ closeList(); continue; }
    let m;
    if(/^\u0000B\d+\u0000$/.test(t)){
      closeList();
      out += `<pre><code>${escapeHtml(blocks[+t.slice(2, -1)])}</code></pre>`;
    } else if((m = t.match(/^(#{1,3})\s+(.*)$/))){
      closeList(); out += `<h${m[1].length}>${m[2]}</h${m[1].length}>`;
    } else if((m = t.match(/^[-*+]\s+(.*)$/))){
      if(!inList){ out += '<ul>'; inList = true; }
      out += `<li>${m[1]}</li>`;
    } else {
      closeList(); out += `<p>${t}</p>`;
    }
  }
  closeList();
  // 兜底：还原任何残留的行内代码块占位
  out = out.replace(/\u0000B(\d+)\u0000/g, (_, i) => `<pre><code>${escapeHtml(blocks[i])}</code></pre>`);
  return out;
}

function flashBtn(btn, text){
  if(btn.dataset._old == null) btn.dataset._old = btn.innerHTML;
  btn.innerHTML = text;
  setTimeout(() => { btn.innerHTML = btn.dataset._old; delete btn.dataset._old; }, 1300);
}
async function copyText(cmd, btn){
  try{
    await navigator.clipboard.writeText(cmd);
    flashBtn(btn, t('copied'));
  }catch(_){
    const ta = document.createElement('textarea');
    ta.value = cmd; ta.style.position = 'fixed'; ta.style.opacity = '0';
    document.body.appendChild(ta); ta.focus(); ta.select();
    try{ document.execCommand('copy'); flashBtn(btn, t('copied')); }
    catch(e){ flashBtn(btn, t('copy_failed')); }
    document.body.removeChild(ta);
  }
}

function setupUsage(){
  const ov = document.createElement('div');
  ov.className = 'ai-overlay hidden';
  ov.id = 'usageOverlay';
  ov.innerHTML =
    '<div class="ai-modal" role="dialog" aria-modal="true" aria-labelledby="usageTitle">' +
      '<div class="ai-header">' +
        `<div><div class="ai-title" id="usageTitle"><span>${t('usage_btn')}</span></div>` +
        '<div class="ai-subtitle" id="usageSub"></div></div>' +
        `<button class="ai-close" id="usageClose" aria-label="${LANG === 'en' ? 'Close skill documentation' : '关闭技能文档'}">×</button>` +
      '</div>' +
      '<div class="usage-toolbar">' +
        `<a class="ai-btn-secondary" id="usageRepo" target="_blank" rel="noopener">${t('usage_open_gh')}</a>` +
        `<button class="ai-btn-secondary" id="usageCopy">${t('usage_copy_cmd')}</button>` +
        '<a class="license-badge" id="usageLic" target="_blank" rel="noopener" style="display:none"></a>' +
      '</div>' +
      '<div class="usage-install" id="usageInstall" style="display:none"></div>' +
      '<div class="usage-body" id="usageBody"></div>' +
    '</div>';
  document.body.appendChild(ov);
  const body = ov.querySelector('#usageBody');
  const sub = ov.querySelector('#usageSub');
  const repoLink = ov.querySelector('#usageRepo');
  const copyBtn = ov.querySelector('#usageCopy');
  const licEl = ov.querySelector('#usageLic');
  const installEl = ov.querySelector('#usageInstall');
  let usageReturnFocus = null;
  let usageReq = 0;
  const close = () => {
    ov.classList.add('hidden');
    document.documentElement.style.overflow = '';
    if(usageReturnFocus && usageReturnFocus.focus) usageReturnFocus.focus();
  };
  ov.querySelector('#usageClose').addEventListener('click', close);
  ov.addEventListener('click', e => { if(e.target === ov) close(); });
  document.addEventListener('keydown', e => {
    if(!ov.classList.contains('hidden') && e.key === 'Escape') close();
  });
  // 焦点陷阱：焦点一旦移出弹窗就拉回（比枚举可聚焦元素更稳——可滚动 <pre>/<summary>
  // 等会被浏览器隐式聚焦却难以选择器命中，boundary 法会漏）
  ov.addEventListener('focusout', () => {
    if(ov.classList.contains('hidden')) return;
    setTimeout(() => {
      if(!ov.classList.contains('hidden') && !ov.contains(document.activeElement)){
        const c = ov.querySelector('#usageClose'); if(c) c.focus();
      }
    }, 0);
  });

  // 全局事件委托：卡片里的 📖 用法 / 📋 安装 按钮（兼容视图重渲染）
  document.body.addEventListener('click', e => {
    if(e.target.closest('a, .license-badge')) return;   // 链接 + 协议徽章（含"未声明" span）不触发卡片用法
    const b = e.target.closest('[data-act]');
    if(!b) return;
    if(b.dataset.act === 'copy') return copyText(b.dataset.cmd || '', b);
    // 卡片本体触发：用户在选文字时不打断（按钮/标签不受此限）
    if(b.classList.contains('card') && window.getSelection && window.getSelection().toString().length > 3) return;
    if(b.dataset.act === 'usage') openUsage(b.dataset);
  });

  // 键盘可达：Enter/Space 触发聚焦的 skill 标签（span 默认不响应键盘）
  document.body.addEventListener('keydown', e => {
    if(e.key !== 'Enter' && e.key !== ' ') return;
    const b = e.target.closest && e.target.closest('.skill-tag.has-doc[data-act="usage"]');
    if(b){ e.preventDefault(); openUsage(b.dataset); }
  });

  async function openUsage(d){
    usageReturnFocus = document.activeElement;
    const myReq = ++usageReq;
    ov.classList.remove('hidden');
    document.documentElement.style.overflow = 'hidden';   // 锁背景滚动
    const closeBtn = ov.querySelector('#usageClose'); if(closeBtn) closeBtn.focus();
    sub.textContent = d.skill ? `${d.skill} · ${d.author}/${d.repo}` : `${d.author}/${d.repo}`;
    repoLink.href = d.url || `https://github.com/${d.author}/${d.repo}`;
    const v = DATA.vendors[d.name];
    const inst = (v && v.install) || {};
    const cmd = inst.command || '';
    copyBtn.style.display = cmd ? '' : 'none';
    copyBtn.onclick = () => copyText(cmd, copyBtn);
    const lm = licMeta(d.license);
    if(d.license){
      licEl.textContent = lm.label + (lm.cls === 'restrict' ? ' ⚠' : '');
      licEl.className = 'license-badge ' + lm.cls;
      licEl.title = lm.note;
      licEl.href = `${d.url || ('https://github.com/' + d.author + '/' + d.repo)}/blob/${d.branch || 'main'}/LICENSE`;
      licEl.style.display = '';
    } else licEl.style.display = 'none';
    if(cmd){
      let ih = `<div class="ui-cmd"><code>${escapeHtml(cmd)}</code><button class="src-act" data-act="copy" data-cmd="${escapeAttr(cmd)}">${LANG === 'en' ? '📋 Copy' : '📋 复制'}</button></div>`;
      ih += '<div class="ui-prereq">' + escapeHtml(installPrereq(cmd)) + '</div>';
      ih += `<div class="ui-use">▶ <b>${LANG === 'en' ? 'Use it' : '用法'}:</b> ${LANG === 'en' ? 'in Claude Code run <code>skills list</code> to confirm, then call it as a <code>/slash-command</code>.' : '在 Claude Code 里运行 <code>skills list</code> 确认，再以 <code>/斜杠命令</code> 调用。'}</div>`;
      if(inst.note) ih += '<div class="ui-note">ℹ️ ' + escapeHtml(inst.note) + '</div>';
      if(inst.alt) ih += `<details class="ui-alt"><summary>${LANG === 'en' ? 'Alternative command' : '备选命令'}</summary><code>${escapeHtml(inst.alt)}</code> <button class="src-act" data-act="copy" data-cmd="${escapeAttr(inst.alt)}">${LANG === 'en' ? 'Copy' : '复制'}</button></details>`;
      installEl.innerHTML = ih;
      installEl.style.display = '';
    } else installEl.style.display = 'none';
    body.innerHTML = `<div class="usage-state">${LANG === 'en' ? 'Loading…' : '加载中…'}</div>`;
    try{
      const { text, path } = await fetchDoc(d);
      if(myReq !== usageReq) return;                       // 期间又点开了别的 → 丢弃过期响应
      body.innerHTML = renderMarkdown(text).trim() || `<div class="usage-state">${t('usage_empty')}</div>`;
      sub.textContent = `${d.skill ? d.skill + ' · ' : ''}${d.author}/${d.repo} · ${path}`;
    }catch(err){
      if(myReq !== usageReq) return;
      const gh = d.url || `https://github.com/${d.author}/${d.repo}`;
      body.innerHTML = `<div class="usage-state">${t('usage_notfound')}<br>` +
        `<a href="${escapeAttr(gh)}" target="_blank" rel="noopener">${t('usage_viewgh')}</a></div>`;
    }
  }
}

