function hueOf(h1Title){ return CAT_HUE[h1Title] != null ? CAT_HUE[h1Title] : 220; }
function toneOf(h1Title){ return CAT_TONE[h1Title] || "neutral"; }

function slugify(s){
  return s.replace(/[^\w\u4e00-\u9fff]+/g,'-').replace(/^-|-$/g,'');
}
function escapeHtml(s){
  return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
function escapeAttr(s){
  return escapeHtml(s).replace(/"/g,'&quot;');
}
function formatStars(n){
  if(n == null) return '';
  if(n < 1000) return n.toString();
  if(n < 10000) return (n/1000).toFixed(1).replace(/\.0$/, '') + 'k';
  if(n < 1000000) return Math.round(n/1000) + 'k';
  return (n/1000000).toFixed(1) + 'M';
}
function highlightText(text, query){
  if(!query) return escapeHtml(text);
  const re = new RegExp('(' + query.replace(/[.*+?^${}()|[\]\\]/g,'\\$&') + ')','gi');
  return escapeHtml(text).replace(re, '<span class="highlight">$1</span>');
}

