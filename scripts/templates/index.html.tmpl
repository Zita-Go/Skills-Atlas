function resolveLang(){
  try{
    const u = new URLSearchParams(location.search).get('lang');
    if(u === 'en' || u === 'zh') return u;
    const s = localStorage.getItem('atlas:lang');
    if(s === 'en' || s === 'zh') return s;
  }catch(_){}
  return 'en';  // 默认英文；用户切到中文后 localStorage 记住，?lang 可覆盖
}
let LANG = resolveLang();
// chrome 文案：缺英文则回退中文
function t(key){ const v = (I18N[LANG] || {})[key]; return v != null ? v : (I18N.zh[key] || ''); }
// 数据文案：英文为空则回退中文（slug/id 永远用中文，保证锚点/跳转稳定）
function pickT(en, zh){ return (LANG === 'en' && en) ? en : zh; }
// 大类色：色相等距 + 亮度三档轮换，相邻大类既差色相又差明暗、更易区分
function catLight(i){ return [68, 58, 49][i % 3]; }
// 全站统一的大类配色：按序号等距色相 + 统一较浅饱和/亮度（柔和、协调；graph 与技能地图共用）
const CAT_SAT = 50, CAT_LIGHT = 71;
function catHue(i){ return Math.round((i * 360 / DATA.sections.length + 220) % 360); }
function catColor(i){ return `hsl(${catHue(i)}, ${CAT_SAT}%, ${CAT_LIGHT}%)`; }
// Hero 技能地图专用调色板（与 graph 解耦，可单独调好看）
let HERO_PALETTE = ['#7F3C8D','#11A579','#3969AC','#F2B701','#E73F74','#80BA5A','#E68310','#008695','#CF1C90','#F97B72','#4B4B8F'];
function hexLum(hex){ const m = hex.replace('#',''); const c = i => parseInt(m.slice(i, i+2), 16)/255;
  const f = v => v <= .03928 ? v/12.92 : Math.pow((v+.055)/1.055, 2.4); return .2126*f(c(0)) + .7152*f(c(2)) + .0722*f(c(4)); }
function applyChrome(){
  document.documentElement.lang = (LANG === 'en' ? 'en' : 'zh-CN');
  document.querySelectorAll('[data-i18n]').forEach(el => {
    const v = t(el.dataset.i18n); if(typeof v === 'string') el.textContent = v;
  });
  document.querySelectorAll('[data-i18n-ph]').forEach(el => {
    const v = t(el.dataset.i18nPh); if(typeof v === 'string') el.placeholder = v;
  });
  // 示例 chip 的查询词（data-q）也随语言切换
  document.querySelectorAll('[data-i18n-q]').forEach(el => {
    const v = t(el.dataset.i18nQ); if(typeof v === 'string') el.dataset.q = v;
  });
  // 悬浮提示 / 无障碍标签也随语言切换（静态 chrome 按钮）
  document.querySelectorAll('[data-i18n-title]').forEach(el => {
    const v = t(el.dataset.i18nTitle); if(typeof v === 'string') el.setAttribute('title', v);
  });
  document.querySelectorAll('[data-i18n-aria]').forEach(el => {
    const v = t(el.dataset.i18nAria); if(typeof v === 'string') el.setAttribute('aria-label', v);
  });
  // <head>：标题 + meta（无 JS 时静态中文兜底，有 JS 时按语言切）
  document.title = t('page_title');
  const setMeta = (sel, key) => {
    const el = document.querySelector(sel); if(!el) return;
    const v = t(key); if(typeof v === 'string') el.setAttribute('content', v);
  };
  setMeta('meta[name="description"]', 'meta_desc');
  setMeta('meta[property="og:title"]', 'og_title');
