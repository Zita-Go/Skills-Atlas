<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<title>Skills Atlas — AI Agent Skills by function</title>
<meta name="description" content="{{N_UNIQUE}} AI Agent Skills from {{N_REPOS}} GitHub repos, organized into {{N_CATS}} functional categories and {{N_GROUPS}} groups, with {{N_CHAINS}} ⛓ chained workflows.">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark light">

<!-- Open Graph / Twitter Card -->
<meta property="og:type" content="website">
<meta property="og:title" content="Skills Atlas — find AI Agent Skills by function">
<meta property="og:description" content="{{N_UNIQUE}} skills · {{N_REPOS}} repos · {{N_CATS}} categories · {{N_GROUPS}} groups · {{N_CHAINS}} chain workflows">
<meta property="og:image" content="https://zita-go.github.io/Skills-Atlas/og.svg">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Skills Atlas">
<meta name="twitter:description" content="AI Agent Skills, organized by function">

<!-- Inline SVG favicon: 紫蓝渐变菱形 + 中央点 -->
<link rel="icon" type="image/svg+xml" href='data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><defs><linearGradient id="g" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="%237c9cff"/><stop offset="1" stop-color="%23c479ff"/></linearGradient></defs><rect width="32" height="32" rx="7" fill="%230b0d10"/><path d="M16 5 L27 16 L16 27 L5 16 Z" fill="url(%23g)" opacity="0.95"/><circle cx="16" cy="16" r="3" fill="%230b0d10"/></svg>'>

<style>
/* 字体：Inter + JetBrains Mono（jsdelivr 国内可访问，body 已有 system-ui 兜底） */
@import url('https://cdn.jsdelivr.net/npm/@fontsource/inter@5.0.0/index.css');
@import url('https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.0.0/index.css');

:root{
  --bg:#13161d; --bg-elev:#1b1f28; --bg-card:#222732;
  --border:#2e333e; --border-strong:#414855; --graph-node-stroke:rgba(255,255,255,.20); --graph-dot:rgba(255,255,255,.05);
  --fg:#e8ecf2; --fg-dim:#9aa3b2; --fg-muted:#6b7384;
  --accent:#7c9cff; --accent-2:#c479ff; --accent-3:#5dd6c5;
  --warn:#ffb86b; --chain:#ff7e9d;
  --link:#9ec1ff;
  --code-bg:#2a3039;
  --shadow:0 1px 0 rgba(255,255,255,.02), 0 8px 24px rgba(0,0,0,.35);
  --shadow-hover:0 0 0 1px rgba(124,156,255,.20), 0 12px 32px rgba(124,156,255,.10), 0 2px 6px rgba(0,0,0,.4);
  --grad: linear-gradient(135deg, #7c9cff 0%, #c479ff 100%);
  --grad-soft: linear-gradient(135deg, rgba(124,156,255,.12) 0%, rgba(196,121,255,.08) 100%);
  --radius:12px;
  --sidebar-w: 320px;
  --jump-offset: 80px;  /* 锚点跳转留白，JS 按 sticky toolbar 实际高度动态更新（换行变高时也不被遮挡） */
  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Microsoft YaHei", Helvetica, Arial, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, "SF Mono", Menlo, Monaco, Consolas, monospace;
}
html.light{
  --bg:#fafbfd; --bg-elev:#ffffff; --bg-card:#ffffff;
  --border:#e6e8ec; --border-strong:#cdd2da; --graph-node-stroke:rgba(0,0,0,.18); --graph-dot:rgba(0,0,0,.06);
  --fg:#0f1218; --fg-dim:#475063; --fg-muted:#7a8190;
  --accent:#5b6cff; --accent-2:#a855f7; --accent-3:#0ca678;
  --warn:#d97706; --chain:#d6336c;
  --link:#3b5bdb;
  --code-bg:#f1f3f7;
  --shadow:0 1px 2px rgba(0,0,0,.04), 0 4px 12px rgba(0,0,0,.05);
  --shadow-hover:0 0 0 1px rgba(91,108,255,.20), 0 8px 24px rgba(91,108,255,.12);
  --grad: linear-gradient(135deg, #5b6cff 0%, #a855f7 100%);
  --grad-soft: linear-gradient(135deg, rgba(91,108,255,.06) 0%, rgba(168,85,247,.04) 100%);
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;background:var(--bg);color:var(--fg);
  font-family:var(--font-sans);
  font-size:14px;line-height:1.65;
  font-feature-settings:'cv02','cv03','cv04','cv11';
  -webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;
}
a{color:var(--link);text-decoration:none}
a:hover{text-decoration:underline}
code{background:var(--code-bg);padding:.1em .4em;border-radius:4px;font-size:.92em;
  font-family:ui-monospace,"SF Mono",Menlo,Monaco,Consolas,monospace}

/* Layout */
.app{display:grid;grid-template-columns:var(--sidebar-w) 1fr;min-height:100vh;
  transition:grid-template-columns .28s cubic-bezier(.4,0,.2,1)}
.app.sidebar-collapsed{grid-template-columns:0 1fr}
.sidebar{
  position:sticky;top:0;height:100vh;overflow-y:auto;
  background:var(--bg-elev);border-right:1px solid var(--border);
  padding:18px 14px 80px;
  transition:transform .28s cubic-bezier(.4,0,.2,1), opacity .2s;
  will-change:transform
}
.app.sidebar-collapsed .sidebar{
  transform:translateX(-100%);opacity:0;pointer-events:none}

/* sidebar 顶部的折叠/展开按钮（桌面） */
.sidebar-head{display:flex;align-items:flex-start;justify-content:space-between;
  gap:8px;margin-bottom:6px}
.sidebar-toggle{display:flex;align-items:center;justify-content:center;
  width:26px;height:26px;background:transparent;border:1px solid var(--border);
  border-radius:6px;color:var(--fg-muted);cursor:pointer;flex-shrink:0;
  transition:background .12s, color .12s, border-color .12s;
  font-size:13px;line-height:1;padding:0}
.sidebar-toggle:hover{background:var(--bg-card);color:var(--fg);
  border-color:var(--border-strong)}
.sidebar-toggle svg{width:14px;height:14px;fill:none;stroke:currentColor;
  stroke-width:2;stroke-linecap:round;stroke-linejoin:round}

/* 收起后吸附在左边缘的召回轨道 */
.sidebar-rail{display:none;position:fixed;left:0;top:50%;
  transform:translateY(-50%);
  width:22px;height:64px;
  background:var(--bg-elev);
  border:1px solid var(--border);border-left:none;
  border-top-right-radius:8px;border-bottom-right-radius:8px;
  cursor:pointer;z-index:20;color:var(--fg-muted);
  align-items:center;justify-content:center;
  transition:width .15s, color .12s, background .12s, box-shadow .15s;
  box-shadow:2px 2px 12px rgba(0,0,0,.18)}
.app.sidebar-collapsed .sidebar-rail{display:flex}
.sidebar-rail:hover{width:28px;color:var(--fg);
  background:var(--bg-card);box-shadow:4px 4px 16px rgba(0,0,0,.28)}
.sidebar-rail svg{width:13px;height:13px;fill:none;stroke:currentColor;
  stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.sidebar h1{font-size:17px;margin:0 0 6px;letter-spacing:-0.01em;font-weight:700;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent}
.sidebar .subtitle{color:var(--fg-muted);font-size:11.5px;margin-bottom:18px;
  letter-spacing:0.01em}
.sidebar .stat-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:16px}
/* 侧栏设置（仅移动端显示：语言/主题从顶栏移到汉堡菜单里）*/
.sidebar-settings{display:none;gap:8px;margin:4px 0 14px}
.sidebar-settings .theme-toggle{flex:1;text-align:center}
.sidebar .stat{background:var(--bg-card);border:1px solid var(--border);
  border-radius:6px;padding:5px 9px;font-size:11px;color:var(--fg-dim);
  font-family:var(--font-mono);font-weight:500}
.sidebar .stat b{color:var(--fg);font-weight:700}

.search-wrap{position:relative;margin-bottom:8px}
.search-wrap input{
  width:100%;padding:10px 60px 10px 32px;background:var(--bg-card);
  border:1px solid var(--border);border-radius:8px;color:var(--fg);
  font-size:13px;outline:none;font-family:var(--font-sans);
  transition:border .15s, box-shadow .15s
}
.search-wrap input:focus{border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(124,156,255,.15)}
.search-wrap input::placeholder{color:var(--fg-muted)}
.search-wrap .search-icon{position:absolute;left:10px;top:50%;
  transform:translateY(-50%);color:var(--fg-muted);font-size:13px;
  pointer-events:none}
.search-wrap .kbd-hint{position:absolute;right:10px;top:50%;
  transform:translateY(-50%);font-family:var(--font-mono);font-size:10.5px;
  color:var(--fg-muted);background:var(--bg-elev);
  border:1px solid var(--border);padding:2px 6px;border-radius:4px;
  pointer-events:none;font-weight:600;letter-spacing:.5px}
.search-wrap .clear-btn{position:absolute;right:8px;top:50%;
  transform:translateY(-50%);cursor:pointer;color:var(--fg-muted);
  background:var(--bg-elev);border:1px solid var(--border);
  font-size:14px;padding:0;display:none;
  width:22px;height:22px;border-radius:50%;line-height:1}
.search-wrap .clear-btn:hover{color:var(--fg);border-color:var(--border-strong)}
.search-result-count{font-size:11px;color:var(--fg-muted);
  margin-bottom:14px;padding-left:2px;min-height:14px;
  font-family:var(--font-mono);letter-spacing:.02em}
.share-link-btn{display:inline-flex;align-items:center;gap:5px;margin:-6px 0 14px;
  background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-dim);
  font-size:11px;padding:5px 10px;border-radius:8px;cursor:pointer;transition:all .12s;font-family:inherit}
.share-link-btn:hover{border-color:var(--accent);color:var(--accent)}

.nav-section{margin-bottom:6px}
.nav-h1{display:flex;align-items:center;gap:8px;padding:8px 10px;
  border-radius:6px;cursor:pointer;font-weight:600;font-size:13px;
  user-select:none;transition:background .12s}
.nav-h1:hover{background:var(--bg-card)}
.nav-h1.active{color:var(--accent);background:rgba(124,156,255,.08)}
.nav-h1 .icon{font-size:14px;flex-shrink:0}
.nav-h1 .nav-h1-title{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-h1 .count{margin-left:auto;background:var(--bg-card);color:var(--fg-muted);
  font-size:10px;padding:1px 6px;border-radius:9px;font-weight:500;flex-shrink:0}
.nav-h1 .caret{display:inline-block;width:14px;text-align:center;
  font-size:10px;color:var(--fg-muted);transition:transform .15s;flex-shrink:0;
  cursor:pointer;padding:2px;border-radius:3px}
.nav-h1 .caret:hover{background:var(--bg-card);color:var(--fg)}
.nav-section.expanded .nav-h1 .caret{transform:rotate(90deg)}
.nav-h2-wrap{margin-left:19px;padding-left:9px;border-left:1px solid var(--border);display:none}
.nav-section.expanded .nav-h2-wrap{display:block}
.nav-h2{display:flex;align-items:center;gap:6px;padding:5px 9px;border-radius:5px;
  color:var(--fg-dim);font-size:12px;cursor:pointer;text-decoration:none;
  transition:background .12s,color .12s;position:relative}
.nav-h2-name{flex:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-h2-count{color:var(--fg-muted);font-size:10px;font-family:var(--font-mono);flex-shrink:0}
.nav-h2:hover{background:var(--bg-card);color:var(--fg);text-decoration:none}
.nav-h2.active{color:var(--accent);background:rgba(124,156,255,.08);font-weight:500}
.nav-h2.active::before{content:'';position:absolute;left:-10px;top:6px;bottom:6px;width:2px;background:var(--accent);border-radius:2px}
.nav-h2.active .nav-h2-count{color:var(--accent)}

/* Main */
/* overflow-x:clip 而非 hidden —— hidden 会把 overflow-y 逼成 auto，使 .main 变成滚动容器、
   废掉子级 .toolbar 的 position:sticky（工具栏会跟着内容滑走）。clip 同样裁横向溢出但不建滚动容器，sticky 正常。 */
.main{padding:32px 40px 80px;max-width:none;overflow-x:clip}
.toolbar{display:flex;gap:8px;align-items:center;flex-wrap:wrap;
  margin-bottom:28px;padding:8px 0 18px;border-bottom:1px solid var(--border);
  position:sticky;top:0;z-index:20;
  background:linear-gradient(var(--bg) 60%, transparent 100%);
  backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px)}
.toolbar .pill{background:var(--bg-card);border:1px solid var(--border);
  padding:5px 12px;border-radius:99px;font-size:12px;color:var(--fg-dim);
  cursor:pointer;transition:all .15s;user-select:none;font-weight:500;
  font-family:var(--font-sans)}
.toolbar .pill:hover{border-color:var(--border-strong);color:var(--fg);
  background:var(--bg-elev)}
.toolbar .pill.active{background:var(--grad);color:#fff;border-color:transparent;
  box-shadow:0 2px 12px rgba(124,156,255,.25);font-weight:600}
.toolbar .spacer{flex:1}
.toolbar .theme-toggle{background:var(--bg-card);border:1px solid var(--border);
  padding:5px 12px;border-radius:99px;color:var(--fg);cursor:pointer;font-size:12.5px;
  font-family:var(--font-sans);font-weight:500;transition:all .15s}
.toolbar .theme-toggle:hover{border-color:var(--border-strong);background:var(--bg-elev)}

/* 视图切换器 */
.view-switch{display:inline-flex;background:var(--bg-card);
  border:1px solid var(--border);border-radius:99px;padding:2px;gap:0}
.view-btn{display:inline-flex;align-items:center;gap:6px;
  background:transparent;border:0;color:var(--fg-muted);
  cursor:pointer;padding:5px 12px;border-radius:99px;font-size:13px;
  transition:all .15s;line-height:1;font-family:var(--font-sans)}
.view-btn:hover{color:var(--fg);background:var(--bg-elev)}
.view-btn.active{background:var(--grad);color:#fff;
  box-shadow:0 2px 8px rgba(124,156,255,.25)}
.view-btn .vb-emoji{font-size:15px;line-height:1;flex-shrink:0;
  font-family:"Segoe UI Emoji","Apple Color Emoji","Noto Color Emoji",sans-serif}
/* 顶栏分组分隔线：把"视图切换"和"筛选"两组在视觉上分开 */
.tb-divider{width:1px;align-self:stretch;min-height:20px;
  background:var(--border);margin:2px 4px;flex:0 0 auto}
.tb-filters{display:flex;align-items:center;gap:8px}
.tb-sort{display:inline-flex;align-items:center;gap:4px;font-size:11.5px}
.tb-sort .tb-sort-label{color:var(--fg-muted);margin-right:2px}
.tb-sort .cs-btn{border:1px solid var(--border);background:var(--bg-card);color:var(--fg-dim);
  font-size:11.5px;font-family:inherit;padding:4px 10px;border-radius:99px;cursor:pointer;transition:all .12s}
.tb-sort .cs-btn:hover{color:var(--fg);border-color:var(--border-strong)}
.tb-sort .cs-btn.active{background:var(--grad);color:#fff;border-color:transparent}
@media(max-width:760px){ .tb-sort{display:none} }

/* AI 推荐按钮 */
.ai-btn{background:var(--grad);color:#fff;border:0;display:inline-flex;align-items:center;gap:5px;
  padding:6px 14px;border-radius:99px;cursor:pointer;font-size:12.5px;
  font-family:var(--font-sans);font-weight:600;letter-spacing:.01em;
  box-shadow:0 2px 12px rgba(124,156,255,.30);transition:all .15s}
.ai-btn:hover{transform:translateY(-1px);
  box-shadow:0 4px 16px rgba(124,156,255,.45)}
.ai-kbd{background:rgba(255,255,255,.20);padding:1px 6px;border-radius:4px;
  font-family:var(--font-mono);font-size:10px;font-weight:700;
  margin-left:4px;letter-spacing:.02em;vertical-align:middle}
@media(max-width:760px){
  .ai-btn .ai-kbd{display:none}
  /* 窄屏不再隐藏视图切换器（否则仓库/网络视图无法进入），改为只留图标 */
  .vb-label{display:none}
  .view-btn{padding:8px 11px}
  .view-btn .vb-emoji{font-size:18px}
  .tb-divider{display:none}
  /* 窄屏精简顶栏：搜索只留放大镜图标；语言/主题移入侧栏（汉堡菜单），腾出竖向空间 */
  #spotlightBtn [data-i18n="btn_search"],#spotlightBtn .ai-kbd{display:none}
  #spotlightBtn{padding-left:10px;padding-right:10px}
  #langToggle,#themeToggle{display:none}
  .toolbar{gap:6px}
  .sidebar-settings{display:flex}
  /* 过滤 pills 收成一条可横滑的行，移到操作按钮下方，不再到处换行 */
  .toolbar .spacer{display:none}
  .tb-filters{order:20;flex-basis:100%;overflow-x:auto;flex-wrap:nowrap;
    -webkit-overflow-scrolling:touch;scrollbar-width:none}
  .tb-filters::-webkit-scrollbar{display:none}
  .tb-filters .pill{flex:0 0 auto}
}

/* === 力导向图视图（动态） === */
.graph-view{width:100%;height:calc(100vh - 140px);min-height:560px;
  background:radial-gradient(ellipse at center, rgba(124,156,255,.04) 0%, transparent 60%),
    var(--bg-card);
  border:1px solid var(--border);border-radius:var(--radius);
  position:relative;overflow:hidden;cursor:grab}
.graph-view.is-panning{cursor:grabbing}
.graph-view svg{width:100%;height:100%;display:block;
  user-select:none;-webkit-user-select:none}
.graph-view .legend{position:absolute;top:14px;left:14px;
  background:rgba(11,13,16,.78);backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  border:1px solid var(--border);border-radius:10px;padding:11px 14px;
  font-size:11.5px;color:var(--fg-dim);max-width:240px;line-height:1.7;
  z-index:5;pointer-events:none}
html.light .graph-view .legend{background:rgba(255,255,255,.85)}
.graph-view .legend b{color:var(--fg);font-weight:600;letter-spacing:-0.01em}
.graph-view .legend .swatch{display:inline-block;width:10px;height:10px;
  border-radius:50%;margin-right:5px;vertical-align:middle}
/* 视图坞：策展预设 + 已保存视图（商用差异化③） */
.graph-view .views-dock{position:absolute;left:14px;bottom:14px;z-index:6;
  display:flex;flex-direction:column;gap:7px;max-width:min(62%,560px)}
.views-dock .vd-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px}
.views-dock .vd-label{font-size:10px;font-weight:700;letter-spacing:.09em;
  color:var(--fg-muted);text-transform:uppercase;margin-right:1px;user-select:none}
.views-dock .vd-chip{display:inline-flex;align-items:center;gap:5px;cursor:pointer;
  background:rgba(11,13,16,.78);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);
  border:1px solid var(--border);border-radius:99px;padding:5px 11px;
  font-size:11.5px;line-height:1;color:var(--fg-dim);white-space:nowrap;
  transition:border-color .15s,color .15s,background .15s,transform .08s}
html.light .views-dock .vd-chip{background:rgba(255,255,255,.85)}
.views-dock .vd-chip:hover{color:var(--fg);border-color:var(--border-strong)}
.views-dock .vd-chip:active{transform:scale(.96)}
.views-dock .vd-chip.active{color:#fff;background:var(--grad);border-color:transparent}
.views-dock .vd-chip.vd-save{color:var(--fg-dim);border-style:dashed}
.views-dock .vd-chip.vd-save:hover{color:var(--accent);border-color:var(--accent)}
.views-dock .vd-chip .vd-x{font-size:13px;line-height:1;color:var(--fg-muted);
  margin:-1px -3px -1px 1px;padding:0 2px;border-radius:50%}
.views-dock .vd-chip .vd-x:hover{color:var(--danger,#e5484d)}
.views-dock .vd-empty{font-size:11px;color:var(--fg-muted);align-self:center}
@media(max-width:760px){
  .graph-view .views-dock{max-width:calc(100% - 28px);bottom:10px}
  .views-dock .vd-saved{display:none}   /* 移动端只留策展预设，省空间 */
}
.graph-view .tooltip{position:absolute;pointer-events:none;
  background:var(--bg-card);border:1px solid var(--border-strong);
  border-radius:6px;padding:6px 10px;font-size:11.5px;color:var(--fg);
  box-shadow:var(--shadow);max-width:280px;z-index:10;
  transition:opacity .12s;opacity:0}
.graph-view .tooltip.visible{opacity:1}

/* 控制面板 */
.graph-controls{position:absolute;top:14px;right:14px;display:flex;
  flex-direction:column;gap:6px;z-index:6}
.graph-controls .gc-btn{display:flex;align-items:center;justify-content:center;
  gap:6px;width:36px;height:36px;
  background:rgba(11,13,16,.78);backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
  border:1px solid var(--border);border-radius:8px;color:var(--fg-dim);
  cursor:pointer;font-size:14px;font-weight:600;
  transition:background .12s, color .12s, transform .08s, border-color .12s}
html.light .graph-controls .gc-btn{background:rgba(255,255,255,.85)}
.graph-controls .gc-btn:hover{color:var(--fg);
  border-color:var(--border-strong);transform:translateY(-1px);
  background:rgba(124,156,255,.10)}
.graph-controls .gc-btn.active{color:var(--accent);
  border-color:rgba(124,156,255,.45);background:rgba(124,156,255,.12)}
.graph-controls .gc-btn .gc-icon{width:16px;height:16px;
  fill:none;stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;
  pointer-events:none;display:block}
.graph-controls .gc-zoom{width:auto;padding:0 10px;
  font-family:var(--font-mono);font-size:11px;letter-spacing:.02em}
.graph-zoom-row{display:flex;gap:4px}
.graph-zoom-row .gc-btn{width:32px;height:32px;font-size:13px}
.graph-zoom-row .gc-btn .gc-icon{width:14px;height:14px}

/* 节点 / 边 */
.graph-view .node{cursor:pointer}
.graph-view .node circle{transition:stroke-width .15s, r .25s, filter .15s}
.graph-view .node:hover circle{stroke-width:2.5;
  filter:drop-shadow(0 0 6px currentColor)}
.graph-view .node.dragging{cursor:grabbing}
.graph-view .node.dim{opacity:.15}
.graph-view .node.dim circle{filter:none}
.graph-view .node.highlight circle{stroke:var(--accent);stroke-width:3;
  filter:drop-shadow(0 0 8px rgba(124,156,255,.6))}
.graph-view .link{stroke-opacity:.5;stroke-linecap:round;fill:none;
  transition:stroke-opacity .15s}
.graph-view .link.dim{stroke-opacity:.05}
.graph-view .link.chain{stroke:var(--chain);stroke-opacity:.8;stroke-width:1.8}
.graph-view .link.chain.dim{stroke-opacity:.08}
.graph-view .link.highlight{stroke-opacity:1;stroke:var(--accent);
  stroke-width:2.5}
/* 亮色主题：连线在白底上加点对比 */
html.light .graph-view .link{stroke-opacity:.62}
html.light .graph-view .link.dim{stroke-opacity:.07}
.graph-view .label{fill:var(--fg-dim);font-family:var(--font-mono);
  font-size:9.5px;pointer-events:none;user-select:none;
  paint-order:stroke;stroke:var(--bg);stroke-width:3;stroke-linejoin:round;
  opacity:0;transition:opacity .15s}
.graph-view .label.always{opacity:.85}
.graph-view .node:hover .label,
.graph-view .node.highlight .label{opacity:1;fill:var(--fg)}
.graph-view .cluster-halo{fill:none;stroke:none;pointer-events:none}
.graph-view .graph-bg{pointer-events:none}
.graph-view .node-hi{pointer-events:none}
/* 入场淡入 */
.graph-view .viewport{transition:opacity .55s ease}
.graph-view.entering .viewport{opacity:0}
/* 聚焦/hover 的高亮节点发光（仅少量节点，避免掉帧）*/
.graph-view .node.highlight circle{filter:url(#nodeGlow)}
/* chain 边流光：把视线引向强绑定关系（reduced-motion 下被全局规则停掉）*/
.graph-view .link.chain{stroke-dasharray:7 7;animation:chainflow 1.5s linear infinite}
@keyframes chainflow{to{stroke-dashoffset:-14}}
/* 回到顶部悬浮按钮：cards/repo 视图向下滚动后出现（图谱视图不显示） */
.to-top{position:fixed;right:20px;bottom:20px;z-index:60;width:42px;height:42px;border-radius:50%;
  border:1px solid var(--border-strong);background:var(--bg-card);color:var(--fg-dim);
  cursor:pointer;display:flex;align-items:center;justify-content:center;
  box-shadow:var(--shadow);opacity:0;transform:translateY(12px) scale(.92);pointer-events:none;
  transition:opacity .2s,transform .2s,border-color .15s,color .15s}
.to-top.show{opacity:1;transform:none;pointer-events:auto}
.to-top:hover{border-color:var(--accent);color:var(--accent);transform:translateY(-2px)}
.to-top:active{transform:translateY(0) scale(.95)}
.to-top svg{width:18px;height:18px}
@media(max-width:760px){ .to-top{right:14px;bottom:14px;width:46px;height:46px} }

/* 节点详情侧抽屉 */
.graph-drawer{position:absolute;top:0;right:0;height:100%;width:300px;max-width:82%;
  background:var(--bg-elev);border-left:1px solid var(--border);
  box-shadow:-8px 0 28px rgba(0,0,0,.28);
  transform:translateX(100%);transition:transform .22s cubic-bezier(.4,0,.2,1);
  display:flex;flex-direction:column;z-index:8;overflow:hidden}
.graph-drawer.open{transform:none}
/* 抽屉打开时把右上角控件左移，避免互相遮挡 */
.graph-drawer.open ~ .graph-controls{transform:translateX(-308px);transition:transform .22s}
@media(max-width:760px){ .graph-drawer.open ~ .graph-controls{transform:translateX(-268px)} }
.graph-drawer .gd-head{padding:16px 16px 12px;border-bottom:1px solid var(--border)}
.graph-drawer .gd-close{position:absolute;top:10px;right:10px;width:26px;height:26px;
  border:0;background:var(--bg-card);color:var(--fg-muted);border-radius:6px;cursor:pointer;font-size:15px}
.graph-drawer .gd-close:hover{color:var(--fg)}
.graph-drawer .gd-eyebrow{font-size:10px;letter-spacing:.12em;text-transform:uppercase;color:var(--accent);font-weight:700}
.graph-drawer .gd-title{font-family:var(--font-mono);font-size:16px;font-weight:700;color:var(--fg);
  word-break:break-word;padding-right:28px;letter-spacing:-.01em;margin-top:2px}
.graph-drawer .gd-sub{font-size:11.5px;color:var(--fg-muted);margin-top:4px}
.graph-drawer .gd-what{font-size:12.5px;color:var(--fg-dim);line-height:1.65;
  background:var(--bg-card);border:1px solid var(--border);border-radius:8px;padding:9px 11px}
.graph-drawer .gd-body{padding:12px 16px 16px;overflow-y:auto;flex:1;font-size:12.5px}
.graph-drawer .gd-sec{margin:0 0 14px}
.graph-drawer .gd-sec h4{margin:0 0 6px;font-size:10.5px;text-transform:uppercase;letter-spacing:.06em;
  color:var(--fg-muted);font-weight:600}
.graph-drawer .gd-chips{display:flex;flex-wrap:wrap;gap:5px}
.graph-drawer .gd-chip{font-family:var(--font-mono);font-size:11px;padding:2px 8px;border-radius:6px;
  background:rgba(124,156,255,.10);color:var(--accent);border:1px solid rgba(124,156,255,.22);cursor:pointer;transition:all .12s}
.graph-drawer .gd-chip:hover{background:rgba(124,156,255,.2)}
.graph-drawer .gd-group{position:relative;padding:7px 8px;margin:0 -8px;border-bottom:1px dashed var(--border);line-height:1.5;color:var(--fg-dim);cursor:pointer;border-radius:6px;transition:background .12s,color .12s}
.graph-drawer .gd-group:hover{background:rgba(124,156,255,.08);color:var(--fg)}
.graph-drawer .gd-group:last-child{border-bottom:0}
.graph-drawer .gd-group .gd-cat{color:var(--fg-muted);font-size:10.5px}
.graph-drawer .gd-group .gd-go{position:absolute;right:8px;top:7px;color:var(--accent);opacity:0;transition:opacity .12s}
.graph-drawer .gd-group:hover .gd-go{opacity:1}
.graph-drawer .gd-chip.gd-repo{cursor:pointer}
.graph-drawer .gd-chip.gd-repo.no-link{cursor:default;background:var(--bg-card);color:var(--fg-dim);border-color:var(--border)}
.graph-drawer .gd-foot{padding:12px 16px;border-top:1px solid var(--border);display:flex;gap:8px}
.graph-drawer .gd-btn{flex:1;text-align:center;padding:8px 10px;border-radius:8px;font-size:12px;cursor:pointer;
  border:1px solid var(--border);background:var(--bg-card);color:var(--fg);font-family:inherit;transition:all .12s}
.graph-drawer .gd-btn.primary{background:var(--grad);color:#fff;border-color:transparent;font-weight:600}
.graph-drawer .gd-btn:hover{transform:translateY(-1px)}
@media(max-width:760px){ .graph-drawer{width:260px} }

/* 大类色块图例 */
.graph-view .legend-cats{margin-top:8px;display:flex;flex-direction:column;
  gap:1px;pointer-events:auto}
.graph-view .legend-cat{display:flex;align-items:center;gap:6px;min-width:0;
  font-size:10.5px;color:var(--fg-dim);line-height:1.35;
  cursor:pointer;padding:3px 6px;margin:0 -4px;border-radius:5px;
  transition:background .12s,color .12s;user-select:none}
.graph-view .legend-cat:hover{background:rgba(124,156,255,.12);color:var(--fg)}
.graph-view .legend-cat.active{background:rgba(124,156,255,.2);color:var(--fg);font-weight:600}
.graph-view .legend-cat span:last-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.graph-view .legend-cat .swatch{display:inline-block;width:9px;height:9px;
  border-radius:50%;flex-shrink:0;
  box-shadow:0 0 5px currentColor}
.graph-view .legend .legend-hint{margin-top:7px;font-size:10px;color:var(--fg-muted);pointer-events:none}

/* AI 推荐抽屉 */
.ai-overlay{position:fixed;inset:0;background:rgba(0,0,0,.6);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  z-index:200;display:flex;align-items:flex-start;justify-content:center;
  padding:80px 20px 20px;animation:fadeIn .2s}
@keyframes fadeIn{from{opacity:0}to{opacity:1}}
.ai-modal{background:var(--bg-card);border:1px solid var(--border);
  border-radius:16px;width:100%;max-width:720px;max-height:80vh;
  overflow-y:auto;box-shadow:0 20px 60px rgba(0,0,0,.4);
  animation:slideUp .25s cubic-bezier(.4,0,.2,1)}
@keyframes slideUp{from{opacity:0;transform:translateY(20px)}
  to{opacity:1;transform:translateY(0)}}
.ai-header{display:flex;justify-content:space-between;align-items:flex-start;
  padding:24px 28px 16px;border-bottom:1px solid var(--border)}
.ai-title{font-size:20px;font-weight:700;letter-spacing:-0.02em;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent;margin-bottom:4px}
.ai-subtitle{color:var(--fg-muted);font-size:12.5px}
.ai-close{background:transparent;border:1px solid transparent;color:var(--fg-muted);
  font-size:22px;cursor:pointer;width:36px;height:36px;flex-shrink:0;line-height:1;
  display:flex;align-items:center;justify-content:center;border-radius:8px}
.ai-close:hover{color:var(--fg);background:var(--bg-elev)}
.ai-close:focus-visible{outline:none;border-color:var(--accent);color:var(--fg);background:rgba(124,156,255,.12)}
.ai-model-picker{display:flex;align-items:center;gap:10px;padding:12px 28px 0;
  flex-wrap:wrap}
.ai-model-label{font-family:var(--font-mono);font-size:11px;
  color:var(--fg-muted);letter-spacing:.04em}
.ai-model-chips{display:flex;flex-wrap:wrap;gap:6px}
.ai-model-chip{background:var(--bg-elev);border:1px solid var(--border);
  color:var(--fg-dim);padding:5px 11px;border-radius:99px;
  font-size:11.5px;cursor:pointer;font-weight:500;
  transition:all .15s;white-space:nowrap;font-family:var(--font-mono)}
.ai-model-chip:hover{border-color:var(--accent);color:var(--accent)}
.ai-model-chip[data-active="true"]{background:rgba(124,156,255,.12);
  border-color:var(--accent);color:var(--accent)}
.ai-model-chip-hint{font-size:10px;opacity:.65;margin-left:4px}
.ai-input-wrap{padding:14px 28px 20px}
.ai-input-wrap textarea{width:100%;background:var(--bg-elev);
  border:1px solid var(--border);border-radius:10px;
  color:var(--fg);font-family:var(--font-sans);font-size:14px;
  padding:14px;resize:vertical;outline:none;line-height:1.6;
  transition:border .15s,box-shadow .15s}
.ai-input-wrap textarea:focus{border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(124,156,255,.15)}
.ai-input-foot{display:flex;align-items:flex-start;justify-content:space-between;
  gap:14px;margin-top:12px;flex-wrap:wrap}
.ai-suggestions{display:flex;flex-wrap:wrap;gap:6px;flex:1;min-width:0}
.ai-submit{display:inline-flex;align-items:center;gap:8px;
  background:var(--grad);color:#fff;border:0;font-weight:600;
  padding:7px 14px;border-radius:99px;cursor:pointer;font-size:12.5px;
  flex-shrink:0;transition:all .15s;white-space:nowrap}
.ai-submit:hover{filter:brightness(1.1);transform:translateY(-1px)}
.ai-submit:active{transform:translateY(0)}
.ai-submit:disabled{opacity:.55;cursor:not-allowed;transform:none}
.ai-submit-kbd{font-family:var(--font-mono);font-size:10.5px;
  background:rgba(255,255,255,.18);padding:2px 6px;border-radius:5px;
  letter-spacing:.04em}
.ai-tag{background:var(--bg-elev);border:1px solid var(--border);
  padding:5px 12px;border-radius:99px;font-size:12px;color:var(--fg-dim);
  cursor:pointer;transition:all .15s}
.ai-tag:hover{border-color:var(--accent);color:var(--accent);
  background:rgba(124,156,255,.08)}
.ai-results{padding:0 28px 24px}
.ai-result-card{background:var(--bg-elev);border:1px solid var(--border);
  border-radius:10px;padding:14px 16px;margin-bottom:10px;
  cursor:pointer;transition:all .15s}
.ai-result-card:hover{border-color:var(--accent);
  background:rgba(124,156,255,.05);transform:translateX(2px)}
.ai-result-head{display:flex;justify-content:space-between;align-items:flex-start;
  gap:10px;margin-bottom:6px}
.ai-result-skills{display:flex;flex-wrap:wrap;gap:4px}
.ai-result-score{font-family:var(--font-mono);font-size:10.5px;
  color:var(--accent);background:rgba(124,156,255,.10);
  padding:2px 8px;border-radius:99px;font-weight:600;flex-shrink:0}
.ai-result-group{font-size:11px;color:var(--fg-muted);margin-bottom:4px}
.ai-result-desc{font-size:12.5px;color:var(--fg-dim);line-height:1.6;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;
  overflow:hidden}
.ai-empty{color:var(--fg-muted);text-align:center;padding:40px 0;font-size:13px}

.ai-title{display:inline-flex;align-items:center;gap:8px;flex-wrap:wrap}
.ai-mode-badge{font-family:var(--font-mono);font-size:10px;font-weight:600;
  padding:2px 8px;border-radius:99px;letter-spacing:.04em;
  -webkit-text-fill-color:initial;background-clip:initial;-webkit-background-clip:initial}
.ai-mode-badge[data-mode="local"]{background:rgba(124,156,255,.10);color:var(--accent);
  border:1px solid rgba(124,156,255,.25)}
.ai-mode-badge[data-mode="llm"]{background:rgba(196,121,255,.12);color:#c479ff;
  border:1px solid rgba(196,121,255,.30)}
.ai-header-actions{display:flex;gap:6px;align-items:center}
.ai-icon-btn{background:transparent;border:1px solid var(--border);color:var(--fg-muted);
  width:30px;height:30px;border-radius:8px;cursor:pointer;font-size:14px;
  display:inline-flex;align-items:center;justify-content:center;line-height:1;
  transition:all .15s}
.ai-icon-btn:hover{border-color:var(--accent);color:var(--accent);
  background:rgba(124,156,255,.08)}
.ai-icon-btn.active{border-color:var(--accent);color:var(--accent);
  background:rgba(124,156,255,.10)}
.ai-settings{padding:14px 28px;border-bottom:1px solid var(--border);
  background:rgba(124,156,255,.04)}
.ai-settings-head{display:flex;flex-direction:column;gap:4px;margin-bottom:10px}
.ai-settings-head strong{font-size:13px;color:var(--fg)}
.ai-settings-hint{font-size:11.5px;color:var(--fg-muted);line-height:1.55}
.ai-settings-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
.ai-settings-row label{font-family:var(--font-mono);font-size:11px;
  color:var(--fg-muted);width:70px;flex-shrink:0;text-align:right}
.ai-settings-row input{flex:1;background:var(--bg-elev);border:1px solid var(--border);
  border-radius:8px;color:var(--fg);font-family:var(--font-mono);font-size:12px;
  padding:7px 10px;outline:none;transition:border .15s,box-shadow .15s}
.ai-settings-row input:focus{border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(124,156,255,.12)}
.ai-settings-foot{display:flex;justify-content:space-between;align-items:center;
  flex-wrap:wrap;gap:10px;margin-top:6px}
.ai-settings-presets{font-size:11px;color:var(--fg-muted)}
.ai-settings-presets a{color:var(--accent);text-decoration:none;
  margin-left:6px;cursor:pointer}
.ai-settings-presets a:hover{text-decoration:underline}
.ai-settings-btns{display:flex;gap:6px}
.ai-btn-primary,.ai-btn-secondary{font-size:11.5px;padding:6px 12px;
  border-radius:8px;cursor:pointer;font-weight:600;transition:all .15s;
  border:1px solid var(--border);background:var(--bg-elev);color:var(--fg-dim)}
.ai-btn-secondary:hover{border-color:var(--accent);color:var(--accent)}
.ai-btn-primary{background:var(--grad);color:#fff;border:0}
.ai-btn-primary:hover{filter:brightness(1.1)}
.ai-settings-status{font-family:var(--font-mono);font-size:11px;
  margin-top:8px;min-height:14px}
.ai-settings-status[data-state="ok"]{color:var(--ok,#3ddc97)}
.ai-settings-status[data-state="err"]{color:var(--err,#ff6b6b)}
.ai-settings-status[data-state="info"]{color:var(--fg-muted)}
.ai-status{padding:8px 28px;font-family:var(--font-mono);font-size:11px;
  color:var(--fg-muted);display:flex;align-items:center;gap:8px}
.ai-status .ai-spin{display:inline-block;width:11px;height:11px;
  border:1.5px solid var(--accent);border-top-color:transparent;
  border-radius:50%;animation:ai-spin .7s linear infinite}
@keyframes ai-spin{to{transform:rotate(360deg)}}
.ai-result-source{font-family:var(--font-mono);font-size:10.5px;
  color:var(--fg-muted);margin-top:6px;line-height:1.5}
.ai-result-source strong{color:var(--fg-dim);font-weight:600}

.section-h1{position:relative;margin:48px 0 12px;font-size:26px;font-weight:700;
  display:flex;align-items:center;gap:12px;scroll-margin-top:var(--jump-offset);
  letter-spacing:-0.02em;padding-left:14px}
.section-h1::before{content:'';position:absolute;left:0;top:50%;
  transform:translateY(-50%);width:4px;height:28px;border-radius:2px;
  background:var(--grad)}
.section-h1 .h1-icon{font-size:26px;font-family:"Segoe UI Emoji","Apple Color Emoji","Noto Color Emoji",sans-serif}
.section-h1:first-of-type{margin-top:8px}
.section-h2{margin:30px 0 14px;font-size:15px;font-weight:600;color:var(--fg);
  scroll-margin-top:var(--jump-offset);letter-spacing:-0.01em;
  padding:1px 0 1px 12px;border-left:3px solid hsla(var(--cat-hue,220),65%,60%,.7)}
.section-h2 .anchor{color:var(--fg-muted);font-size:13px;margin-left:8px;
  font-weight:400;opacity:0;transition:opacity .15s;text-decoration:none}
.section-h2:hover .anchor{opacity:1}
.section-h2 .anchor:hover{color:var(--accent)}

.cards{display:grid;grid-template-columns:repeat(auto-fill, minmax(min(100%, 430px), 1fr));
  align-items:start;gap:16px}
.card{position:relative;background:var(--bg-card);border:1px solid var(--border);
  border-radius:var(--radius);padding:18px 20px;
  box-shadow:var(--shadow);
  transition:transform .18s cubic-bezier(.4,0,.2,1), box-shadow .18s, border-color .18s;
  will-change:transform}
.card:hover{transform:translateY(-2px);box-shadow:var(--shadow-hover);
  border-color:rgba(124,156,255,.3)}
html.light .card:hover{border-color:rgba(91,108,255,.4)}
.card.chain{border-left:3px solid transparent;
  background-image:linear-gradient(180deg,
      hsla(var(--cat-hue, 220), 60%, 60%, .04) 0%,
      transparent 60%),
    linear-gradient(var(--bg-card),var(--bg-card)),
    linear-gradient(180deg, var(--chain) 0%,
      hsl(var(--cat-hue, 220), 65%, 60%) 100%);
  background-origin:padding-box, border-box, border-box;
  background-clip:padding-box, padding-box, border-box}
html.light .card.chain{
  background-image:linear-gradient(180deg,
      hsla(var(--cat-hue, 220), 60%, 55%, .035) 0%,
      transparent 60%),
    linear-gradient(var(--bg-card),var(--bg-card)),
    linear-gradient(180deg, var(--chain) 0%,
      hsl(var(--cat-hue, 220), 60%, 55%) 100%);
  background-origin:padding-box, border-box, border-box;
  background-clip:padding-box, padding-box, border-box}
.card-head{display:flex;flex-direction:column;align-items:stretch;gap:9px;
  margin-bottom:10px}
.card-skills{display:flex;flex-wrap:wrap;gap:6px;min-width:0}
.skill-tag{background:rgba(124,156,255,.10);color:var(--accent);
  border:1px solid rgba(124,156,255,.20);padding:3px 9px;border-radius:6px;
  font-size:11px;font-family:var(--font-mono);font-weight:500;
  white-space:nowrap;letter-spacing:-0.01em;
  transition:all .15s}
.card:hover .skill-tag{border-color:rgba(124,156,255,.35);
  background:rgba(124,156,255,.14)}
html.light .skill-tag{background:rgba(91,108,255,.08);color:var(--accent);
  border-color:rgba(91,108,255,.18)}
html.light .card:hover .skill-tag{background:rgba(91,108,255,.14)}
.card-group{display:flex;align-items:center;gap:8px;color:var(--fg);
  font-size:14.5px;font-weight:600;letter-spacing:-0.01em;
  min-width:0}
.card-group > span{min-width:0;line-height:1.35}
.chain-badge{background:linear-gradient(135deg, var(--chain) 0%, var(--accent-2) 100%);
  color:#fff;padding:2px 8px;border-radius:5px;
  font-size:10px;font-weight:700;letter-spacing:.5px;
  box-shadow:0 2px 8px rgba(255,126,157,.25)}
.card-desc{color:var(--fg-dim);font-size:13.5px;line-height:1.75;
  margin:8px 0 12px;word-break:break-word;max-width:72ch}
.card-desc code{font-size:.88em;font-family:var(--font-mono)}
.card-sources{display:flex;flex-direction:column;gap:7px;margin-top:12px;
  padding-top:12px;border-top:1px solid var(--border)}
.source-link{display:inline-flex;align-items:center;gap:5px;
  background:transparent;border:1px solid var(--border);
  padding:4px 10px;border-radius:99px;font-size:11.5px;
  color:var(--fg-dim);text-decoration:none;transition:all .15s;
  font-family:var(--font-mono);font-weight:500}
.source-link:hover{border-color:var(--accent);color:var(--accent);
  text-decoration:none;background:rgba(124,156,255,.08);
  transform:translateY(-1px)}
.source-link svg{width:11px;height:11px;flex-shrink:0;opacity:.7}
.source-link:hover svg{opacity:1}
.source-stars{font-size:10.5px;color:var(--warn);font-weight:600;
  margin-left:2px;letter-spacing:.02em;
  display:inline-flex;align-items:center;gap:3px}
.source-stars svg{width:11px;height:11px;flex-shrink:0;opacity:1}
.source-link:hover .source-stars{color:#ffd86b}
/* 用法 / 一键安装：每个来源独占一整行（左=链接+动作，右=协议/更新元信息）*/
.source-row{display:flex;width:100%;align-items:center;gap:6px;flex-wrap:wrap}
.source-meta{display:inline-flex;align-items:center;gap:6px;margin-left:auto}
.card.clickable{cursor:pointer}
.card-desc,.card-skills,.card .skill-tag{user-select:text}
.card-uc{font-size:12.5px;color:var(--fg);margin:6px 0 10px;line-height:1.6;display:flex;flex-wrap:wrap;gap:6px;align-items:center;user-select:text}
.card-when{color:var(--fg-muted);font-size:11.5px}
.persona-chip{font-size:11px;padding:1px 8px;border-radius:99px;background:var(--bg-elev);color:var(--fg-dim);border:1px solid var(--border)}
.license-badge.ok{background:rgba(110,200,140,.12);color:#7fd99b;border-color:rgba(110,200,140,.3)}
.license-badge.copyleft{background:rgba(255,180,90,.12);color:#ffc46b;border-color:rgba(255,180,90,.3)}
.license-badge.restrict{background:rgba(255,110,120,.14);color:#ff8b94;border-color:rgba(255,110,120,.4);font-weight:700}
.stale-badge{font-family:var(--font-mono);font-size:10px;padding:2px 7px;border-radius:99px;white-space:nowrap;
  background:rgba(255,180,90,.10);color:#e0a85a;border:1px solid rgba(255,180,90,.25)}
.hero-start{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:16px}
.hero-start-q{font-size:12.5px;color:var(--fg-dim)}
.start-chip{background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-dim);
  padding:7px 14px;border-radius:99px;font-size:12.5px;cursor:pointer;transition:all .15s}
.start-chip:hover{border-color:var(--accent);color:var(--accent);background:rgba(124,156,255,.08);transform:translateY(-1px)}
/* 新手入口：高亮一档（强调色描边底色），引导第一次来的人先看 */
.start-chip-learn{color:var(--accent);border-color:rgba(124,156,255,.45);background:rgba(124,156,255,.10);font-weight:600}
/* AI 推荐：最强 CTA（渐变实心），新手最省力的入口 */
.start-chip-ai{background:var(--grad);color:#fff;border-color:transparent;font-weight:600;
  box-shadow:0 2px 10px rgba(124,156,255,.28)}
.start-chip-ai:hover{color:#fff;background:var(--grad);border-color:transparent;
  box-shadow:0 4px 14px rgba(124,156,255,.42);transform:translateY(-1px)}
/* hero 定义行：标题下的一句话「这是什么」 */
.hero-definition{margin:8px 0 0;color:var(--fg);font-size:14px;line-height:1.6;max-width:600px;font-weight:500}
.hero-definition code{font-family:var(--font-mono);font-size:.9em;background:var(--bg-elev);padding:1px 5px;border-radius:4px}
/* 页脚：归属 / 信任 / 去深读 */
.site-footer{display:flex;flex-wrap:wrap;align-items:center;gap:6px 10px;margin:40px 0 24px;
  padding:16px 4px 0;border-top:1px solid var(--border);font-size:12px;color:var(--fg-muted);line-height:1.7}
.site-footer .sf-brand{font-weight:600;color:var(--fg-dim)}
.site-footer a{color:var(--fg-dim);text-decoration:none;border-bottom:1px solid transparent}
.site-footer a:hover{color:var(--accent);border-bottom-color:var(--accent)}
.site-footer .sf-sep{color:var(--border-strong)}
.site-footer .sf-note{flex-basis:100%;color:var(--fg-muted);font-size:11.5px;margin-top:2px}
/* 新手必看弹窗正文 */
.howto-body{padding:6px 28px 26px;font-size:13.5px;line-height:1.7;color:var(--fg-dim)}
.howto-body .howto-lead{color:var(--fg);margin:6px 0 14px}
.howto-body .howto-steps{margin:0 0 14px;padding-left:0;list-style:none;counter-reset:ht}
.howto-body .howto-steps li{position:relative;padding:7px 0 7px 34px;border-bottom:1px dashed var(--border)}
.howto-body .howto-steps li:last-child{border-bottom:0}
.howto-body .howto-steps li::before{counter-increment:ht;content:counter(ht);position:absolute;left:0;top:7px;
  width:22px;height:22px;border-radius:50%;background:var(--grad);color:#fff;font-size:11px;font-weight:700;
  display:flex;align-items:center;justify-content:center}
.howto-body code{font-family:var(--font-mono);font-size:.88em;background:var(--bg-elev);padding:1px 6px;border-radius:4px;color:var(--fg)}
.howto-body .howto-note{color:var(--fg-muted);font-size:12.5px;margin:0 0 12px}
.howto-body .howto-more{margin:0;font-size:12.5px}
.howto-body .howto-more a{color:var(--accent);text-decoration:none}
@media(max-width:480px){ .howto-body{padding-left:16px;padding-right:16px} }
/* 性能：屏外卡片不渲染（首屏更快） */
.card{content-visibility:auto;contain-intrinsic-size:auto 200px}
/* 键盘焦点环（可访问性） */
.skill-tag.has-doc:focus-visible,.src-act:focus-visible,.start-chip:focus-visible,.license-badge:focus-visible{outline:2px solid var(--accent);outline-offset:2px;border-radius:6px}
/* 移动端触摸目标放大 */
@media (max-width:760px){
  .src-act,.source-link,.pill,.view-btn,.start-chip{min-height:44px;padding-top:11px;padding-bottom:11px;padding-left:12px;padding-right:12px}
  .skill-tag{min-height:34px;padding-top:6px;padding-bottom:6px;display:inline-flex;align-items:center}
}
.hero-start-eg{font-size:11px;color:var(--fg-muted);flex-basis:100%;margin-top:2px}
/* 右侧「技能地图」treemap（面积∝大类规模，点击跳分类） */
.hero-viz{display:flex;flex-direction:column;gap:8px;align-items:stretch;width:384px;flex-shrink:0}
.hero-map{position:relative;width:100%;height:244px;border-radius:12px;overflow:hidden;
  background:transparent}   /* 无边框无底色：材质色块直接浮在 hero 卡上，间隙透出卡片底色 */
.hm-tile{position:absolute;border:0;border-radius:8px;cursor:pointer;overflow:hidden;
  display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:3px;
  padding:6px 9px;text-align:left;font-family:inherit;line-height:1;
  /* 质感：底色上叠一层 顶部高光→底部微暗 的渐变，营造柔和材质层次 */
  background:linear-gradient(170deg, rgba(255,255,255,.22) 0%, rgba(255,255,255,.04) 34%, rgba(0,0,0,.07) 100%), var(--tile);
  box-shadow:0 1px 2px rgba(0,0,0,.16), inset 0 1px 0 rgba(255,255,255,.34), inset 0 0 0 1px rgba(0,0,0,.04);
  transition:filter .14s,transform .12s,box-shadow .14s}
.hm-tile:hover{filter:brightness(1.05) saturate(1.05);z-index:3;transform:translateY(-1px);
  box-shadow:0 4px 14px rgba(0,0,0,.22), inset 0 1px 0 rgba(255,255,255,.5), inset 0 0 0 1.5px rgba(255,255,255,.7)}
html.light .hm-tile{box-shadow:0 1px 3px rgba(20,30,60,.12), inset 0 1px 0 rgba(255,255,255,.45), inset 0 0 0 1px rgba(0,0,0,.05)}
.hm-tile .hm-ic{font-size:15px;line-height:1;filter:drop-shadow(0 1px 1px rgba(0,0,0,.4))}
.hm-tile .hm-ic.tiny{font-size:11px}
.hm-tile .hm-nm{font-size:10px;line-height:1.15;color:var(--txt);font-weight:700;
  overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:100%;letter-spacing:-0.01em}
.hm-tile .hm-ct{font-size:13px;font-weight:800;color:var(--txt);font-family:var(--font-mono)}
.hm-tile .hm-ct.sm{font-size:11px}
/* 又宽又矮的色块：横排 图标 名称 …… 数量，避免三行纵向挤压/重叠 */
.hm-tile.row{flex-direction:row;align-items:center;gap:7px}
.hm-tile.row .hm-nm{flex:1 1 auto;min-width:0}
.hm-tile.row .hm-ct{flex:0 0 auto;margin-left:auto}
.hero-map-cap{font-size:11px;color:var(--fg-muted);text-align:center;letter-spacing:.01em}
/* hero 收起 */
.hero{position:relative;transition:padding .2s}
.hero-toggle{position:absolute;top:10px;right:12px;background:var(--bg-elev);border:1px solid var(--border);color:var(--fg-muted);width:26px;height:26px;border-radius:7px;cursor:pointer;font-size:13px;line-height:1;display:flex;align-items:center;justify-content:center;transition:all .15s;z-index:2}
.hero-toggle:hover{border-color:var(--accent);color:var(--accent)}
.hero.collapsed .hero-toggle{transform:rotate(180deg)}
.hero.collapsed > .hero-text > p,.hero.collapsed .hero-start,.hero.collapsed > .hero-viz{display:none}
.hero.collapsed{padding-top:12px;padding-bottom:8px}
.hero.collapsed h2{font-size:18px;margin-bottom:8px}
.hero.collapsed .hero-stats{margin-top:0}
.usage-install{padding:6px 28px 0;font-size:12.5px;line-height:1.65}
.usage-install .ui-note{color:var(--fg-dim);margin:4px 0}
.usage-install .ui-prereq{color:var(--fg-muted);margin:4px 0}
.usage-install .ui-use{color:var(--fg);margin:6px 0 2px}
.usage-install .ui-use code{font-family:var(--font-mono);background:var(--bg-elev);padding:1px 5px;border-radius:4px;font-size:.9em}
.usage-install .ui-alt{margin:6px 0;color:var(--fg-dim)}
.usage-install .ui-alt summary{cursor:pointer;color:var(--accent);font-size:12px}
.usage-install code{font-family:var(--font-mono);background:var(--bg-elev);padding:2px 6px;border-radius:4px;font-size:11.5px}
.usage-install .ui-cmd{display:flex;gap:8px;align-items:center;margin:2px 0 6px}
.usage-install .ui-cmd code{flex:1;overflow-x:auto;padding:7px 10px;white-space:nowrap}
.src-act{display:inline-flex;align-items:center;gap:4px;cursor:pointer;
  background:transparent;border:1px solid var(--border);
  padding:4px 9px;border-radius:99px;font-size:11px;color:var(--fg-dim);
  font-family:var(--font-mono);font-weight:500;transition:all .15s;white-space:nowrap}
.src-act:hover{border-color:var(--accent);color:var(--accent);
  background:rgba(124,156,255,.08);transform:translateY(-1px)}
.src-act:active{transform:translateY(0)}
.license-badge{font-family:var(--font-mono);font-size:10px;font-weight:600;
  padding:2px 7px;border-radius:99px;letter-spacing:.02em;text-decoration:none;
  background:rgba(124,156,255,.10);color:var(--accent);
  border:1px solid rgba(124,156,255,.25)}
.license-badge:hover{filter:brightness(1.12)}
.license-badge.unknown{background:var(--bg-elev);color:var(--fg-muted);
  border-color:var(--border);cursor:default}
/* 用法弹窗正文（运行时拉取的 Markdown，安全渲染） */
.usage-toolbar{display:flex;gap:8px;flex-wrap:wrap;padding:14px 28px 0}
.usage-body{padding:18px 28px 26px;font-size:13.5px;line-height:1.75;
  color:var(--fg-dim);word-break:break-word;overflow-wrap:anywhere}
.usage-body h1,.usage-body h2,.usage-body h3{color:var(--fg);
  margin:18px 0 8px;line-height:1.3;font-weight:700}
.usage-body h1{font-size:19px}.usage-body h2{font-size:16px}.usage-body h3{font-size:14px}
.usage-body p{margin:8px 0}
.usage-body ul{margin:8px 0;padding-left:20px}.usage-body li{margin:3px 0}
.usage-body a{color:var(--accent);text-decoration:none}
.usage-body a:hover{text-decoration:underline}
.usage-body code{font-family:var(--font-mono);font-size:.88em;
  background:var(--bg-elev);padding:1px 5px;border-radius:4px}
.usage-body pre{background:var(--bg-elev);border:1px solid var(--border);
  border-radius:8px;padding:12px 14px;overflow-x:auto;margin:10px 0;max-width:100%}
.usage-body pre code{background:transparent;padding:0;font-size:12px;line-height:1.6;display:block}
.usage-state{color:var(--fg-muted);text-align:center;padding:40px 20px;font-size:13px}
.usage-state a{color:var(--accent)}
/* 窄屏：弹窗内边距收紧、代码再小一档，避免横向溢出 */
@media(max-width:480px){
  .usage-toolbar,.usage-install{padding-left:16px;padding-right:16px}
  .usage-body{padding-left:16px;padding-right:16px}
  .ai-overlay{padding:56px 12px 12px}
  .usage-body pre code{font-size:11px}
}
.usage-state a{color:var(--accent)}

/* 点按时的轻微回弹，给"按下"的触感 */
.toolbar .pill:active,.view-btn:active,.toolbar .theme-toggle:active{transform:scale(.96)}
.ai-btn:active{transform:translateY(0);box-shadow:0 1px 6px rgba(124,156,255,.3)}
.source-link:active{transform:translateY(0)}

/* 键盘聚焦统一用品牌色描边（仅 Tab 键触发，鼠标点击不显示，不干扰日常观感） */
a:focus-visible,button:focus-visible,input:focus-visible,
.pill:focus-visible,.view-btn:focus-visible,.source-link:focus-visible,
[tabindex]:focus-visible{outline:2px solid var(--accent);outline-offset:2px;
  border-radius:6px}

/* 尊重系统"减少动态效果"偏好：关掉位移/动画，避免眩晕 */
@media (prefers-reduced-motion: reduce){
  *,*::before,*::after{transition-duration:.001ms !important;
    animation-duration:.001ms !important;animation-iteration-count:1 !important;
    scroll-behavior:auto !important}
  .card:hover,.ai-btn:hover,.source-link:hover{transform:none}
}

.empty-state{padding:60px 20px;text-align:center;color:var(--fg-muted)}
.empty-state .big{font-size:48px;opacity:.4;margin-bottom:12px}

/* Highlight match */
.highlight{background:rgba(255,184,107,.25);color:var(--warn);
  padding:0 2px;border-radius:2px}
html.light .highlight{background:rgba(217,118,6,.18)}

/* Hidden via filter */
.hidden{display:none !important}

/* Mobile */
@media(max-width:900px){
  .app{grid-template-columns:1fr}
  .app.sidebar-collapsed{grid-template-columns:1fr}
  .app.sidebar-collapsed .sidebar{transform:none;opacity:1;pointer-events:auto}
  .sidebar{position:fixed;left:-100%;width:280px;z-index:100;
    transition:left .25s;box-shadow:0 0 40px rgba(0,0,0,.5)}
  .sidebar.open{left:0}
  .main{padding:18px 18px 80px}
  .menu-btn{display:flex !important}
  /* 移动端抽屉里保留收起按钮（桌面是折叠，移动端点它关抽屉，见 JS） */
  .sidebar-toggle{display:flex}
  .app.sidebar-collapsed .sidebar-rail{display:none}
  .toolbar{position:sticky;top:0;background:var(--bg);z-index:10;
    padding-top:8px;margin-top:-18px}
  /* 抽屉打开时显示遮罩，点遮罩关闭（见 JS） */
  .sidebar.open ~ .sidebar-backdrop{opacity:1;pointer-events:auto}
}
/* 移动端抽屉背景遮罩：默认不可见，仅移动端抽屉打开时由上面的规则点亮 */
.sidebar-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:90;
  opacity:0;pointer-events:none;transition:opacity .25s}
.menu-btn{display:none;background:var(--bg-card);border:1px solid var(--border);
  border-radius:6px;padding:6px 10px;color:var(--fg);cursor:pointer}
.menu-btn svg{width:20px;height:20px;display:block}
#spotlightBtn .tb-search-ico{width:14px;height:14px;vertical-align:-2.5px;margin-right:3px}

/* Scrollbar */
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:var(--border-strong);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--fg-muted)}
::-webkit-scrollbar-track{background:transparent}

/* Hero 区域 */
.hero{position:relative;margin-bottom:32px;padding:32px 36px;
  background:var(--bg-card);
  background-image:var(--grad-soft);
  border:1px solid var(--border);border-radius:16px;
  overflow:hidden;
  display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center}
.hero::before{content:'';position:absolute;top:-50%;right:-20%;width:60%;height:200%;
  background:radial-gradient(ellipse at center, rgba(124,156,255,.12) 0%, transparent 70%);
  pointer-events:none}
.hero::after{content:'';position:absolute;bottom:-40%;left:-10%;width:50%;height:160%;
  background:radial-gradient(ellipse at center, rgba(196,121,255,.10) 0%, transparent 70%);
  pointer-events:none}
html.light .hero{
  border-color:rgba(124,156,255,.22);
  box-shadow:0 1px 0 rgba(255,255,255,.6) inset,
    0 8px 28px rgba(124,156,255,.10),
    0 1px 3px rgba(0,0,0,.04)}
html.light .hero::before{
  background:radial-gradient(ellipse at center, rgba(124,156,255,.22) 0%, transparent 70%)}
html.light .hero::after{
  background:radial-gradient(ellipse at center, rgba(196,121,255,.18) 0%, transparent 70%)}
.hero-text{position:relative;z-index:1}
.hero h2{margin:0 0 10px;font-size:28px;font-weight:700;letter-spacing:-0.02em;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent}
.hero p{margin:0;color:var(--fg-dim);font-size:14px;max-width:560px;line-height:1.7}
.hero-stats{display:flex;flex-wrap:wrap;gap:24px;margin-top:20px}
.hero-stats > div{font-size:11px;color:var(--fg-muted);text-transform:uppercase;
  letter-spacing:0.08em;font-weight:500}
.hero-stats > div b{display:block;color:var(--fg);font-size:28px;font-weight:700;
  letter-spacing:-0.02em;margin-bottom:2px;
  background:var(--grad);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent}
.hero-viz{position:relative;z-index:1;flex-shrink:0;align-self:center}
@media(max-width:760px){
  .hero{grid-template-columns:1fr;padding:24px}
  .hero h2{font-size:21px;line-height:1.35;text-wrap:balance}
  .hero p{text-wrap:pretty}
  .hero-viz{display:none}
  /* 章节标题在窄屏缩一档，并禁止中文词内断行（只在空格/斜杠处折行） */
  .section-h1{font-size:20px;margin:32px 0 10px;word-break:keep-all;overflow-wrap:anywhere}
  .section-h2{font-size:14.5px;word-break:keep-all}
  /* 卡片右上分类标签换到下一行时给全宽，避免被过度省略 */
  .card-group{max-width:100%;margin-left:0}
}

/* No-result hint */
.no-result-hint{color:var(--fg-muted);font-size:13px;padding:8px 0}

/* === 类别色温（暖：营销 / 冷：工程） === */
/* 每个 .section-h1 / .cards 上由 JS 注入 style="--cat-hue: <hue>" */
.section-h1{--cat-hue:220}
.section-h1::before{
  background:linear-gradient(180deg,
    hsl(var(--cat-hue), 70%, 62%) 0%,
    hsl(calc(var(--cat-hue) + 30), 70%, 62%) 100%);
  box-shadow:0 0 14px hsla(var(--cat-hue), 70%, 62%, .25);
}
.section-h1 .h1-icon{
  filter:drop-shadow(0 0 6px hsla(var(--cat-hue), 70%, 60%, .35));
}
.cards{--cat-hue:220}
.card{
  background:linear-gradient(180deg,
    hsla(var(--cat-hue), 60%, 60%, .04) 0%,
    transparent 60%),
    var(--bg-card);
}
html.light .card{
  background:linear-gradient(180deg,
    hsla(var(--cat-hue), 60%, 55%, .035) 0%,
    transparent 60%),
    var(--bg-card);
}
.card:hover{
  border-color:hsla(var(--cat-hue), 70%, 60%, .35);
}
html.light .card:hover{
  border-color:hsla(var(--cat-hue), 60%, 50%, .45);
}
.card .skill-tag{
  background:hsla(var(--cat-hue), 70%, 60%, .10);
  color:hsl(var(--cat-hue), 65%, 72%);
  border-color:hsla(var(--cat-hue), 70%, 60%, .22);
}
/* Phase 2：有自己 SKILL.md 的 skill 标签可点开 */
.card .skill-tag.has-doc{cursor:pointer}
.card .skill-tag.has-doc .doc-cue{font-size:9px;opacity:.5;margin-left:3px}
.card .skill-tag.has-doc:hover{background:hsla(var(--cat-hue), 70%, 60%, .26);
  border-color:var(--accent);transform:translateY(-1px)}
html.light .card .skill-tag{
  background:hsla(var(--cat-hue), 60%, 50%, .08);
  color:hsl(var(--cat-hue), 55%, 42%);
  border-color:hsla(var(--cat-hue), 55%, 50%, .22);
}
.card:hover .skill-tag{
  background:hsla(var(--cat-hue), 70%, 60%, .16);
  border-color:hsla(var(--cat-hue), 70%, 60%, .38);
}
.section-h1 .h1-tone{
  display:inline-flex;align-items:center;gap:4px;
  margin-left:10px;padding:3px 10px;border-radius:99px;
  background:hsla(var(--cat-hue), 65%, 60%, .12);
  border:1px solid hsla(var(--cat-hue), 65%, 60%, .25);
  color:hsl(var(--cat-hue), 60%, 70%);
  font-family:var(--font-mono);font-size:11px;font-weight:600;letter-spacing:.05em;
  text-transform:uppercase;vertical-align:middle}
html.light .section-h1 .h1-tone{
  color:hsl(var(--cat-hue), 55%, 40%);
  background:hsla(var(--cat-hue), 55%, 50%, .10);
  border-color:hsla(var(--cat-hue), 55%, 50%, .28)}

/* H1 容器（仅用作 section 包裹） */
.h1-wrap{position:relative}

/* === 按仓库视图 === */
.repo-view{padding-top:8px}
.repo-type-group{margin-bottom:36px}
.repo-type-head{display:flex;align-items:center;gap:10px;
  margin:0 0 14px;font-size:18px;font-weight:700;letter-spacing:-0.01em;
  scroll-margin-top:var(--jump-offset)}
.repo-type-head .type-badge{font-family:var(--font-mono);font-size:11px;
  background:var(--bg-card);border:1px solid var(--border);
  padding:3px 10px;border-radius:99px;color:var(--fg-muted);font-weight:500;
  text-transform:lowercase;letter-spacing:.02em}
.repo-type-head .type-count{margin-left:auto;font-size:11px;
  font-weight:500;color:var(--fg-muted);font-family:var(--font-mono)}
.repo-grid{display:grid;grid-template-columns:repeat(auto-fill, minmax(260px, 1fr));
  gap:12px}
.repo-card{background:
    linear-gradient(180deg,
      hsla(var(--cat-hue, 220), 60%, 60%, .045) 0%,
      transparent 60%),
    var(--bg-card);
  border:1px solid var(--border);
  border-radius:var(--radius);padding:14px 16px;cursor:pointer;
  box-shadow:var(--shadow);
  transition:transform .18s, box-shadow .18s, border-color .18s;
  position:relative;overflow:hidden}
.repo-card::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:linear-gradient(180deg,
    hsla(var(--cat-hue, 220), 70%, 60%, .85),
    hsla(var(--cat-hue, 220), 70%, 60%, .15));
  opacity:0;transition:opacity .18s}
.repo-card:hover{transform:translateY(-2px);box-shadow:var(--shadow-hover);
  border-color:hsla(var(--cat-hue, 220), 65%, 55%, .45)}
.repo-card:hover::before{opacity:1}
.repo-card-head{display:flex;align-items:flex-start;justify-content:space-between;
  gap:8px;margin-bottom:6px}
.repo-card-name{font-family:var(--font-mono);font-size:13px;font-weight:600;
  color:var(--fg);word-break:break-all;line-height:1.4}
.repo-card-name .author{color:var(--fg-muted);font-weight:400}
.repo-card-stars{font-family:var(--font-mono);font-size:11px;color:var(--warn);
  font-weight:600;flex-shrink:0;white-space:nowrap;
  display:inline-flex;align-items:center;gap:3px}
.repo-card-stars svg{width:12px;height:12px;flex-shrink:0}
.repo-card-meta{display:flex;flex-wrap:wrap;gap:6px;margin-top:8px}
.repo-card-tag{font-family:var(--font-mono);font-size:10.5px;
  background:hsla(var(--cat-hue, 220), 60%, 55%, .12);
  color:hsl(var(--cat-hue, 220), 60%, 72%);
  padding:2px 8px;border-radius:5px;
  border:1px solid hsla(var(--cat-hue, 220), 60%, 55%, .22);
  font-weight:500}
html.light .repo-card-tag{
  color:hsl(var(--cat-hue, 220), 55%, 38%);
  background:hsla(var(--cat-hue, 220), 55%, 50%, .08);
  border-color:hsla(var(--cat-hue, 220), 55%, 50%, .22)}
.repo-card-tag.tag-hot{
  background:linear-gradient(135deg, hsla(340, 80%, 60%, .15), hsla(20, 80%, 60%, .15));
  border-color:hsla(340, 80%, 60%, .35);
  color:hsl(340, 80%, 75%)}
html.light .repo-card-tag.tag-hot{color:hsl(340, 65%, 45%)}
.repo-card-link{display:inline-flex;align-items:center;gap:5px;font-size:11px;
  color:var(--fg-muted);font-family:var(--font-mono);margin-top:10px;
  padding:3px 8px;border-radius:5px;border:1px solid transparent;
  transition:color .12s, border-color .12s, background .12s}
.repo-card-link svg{width:11px;height:11px}
.repo-card:hover .repo-card-link{color:var(--accent);
  border-color:rgba(124,156,255,.25);background:rgba(124,156,255,.08)}
.repo-card-link:hover{color:var(--accent);text-decoration:none;
  border-color:rgba(124,156,255,.45) !important}
/* 仓库卡片：一句话描述（2 行截断）+ 协议/更新时间页脚 —— 更专业的目录卡 */
.repo-card-desc{font-size:12px;line-height:1.55;color:var(--fg-dim);margin-top:3px;
  display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.repo-card-foot{display:flex;align-items:center;gap:7px;margin-top:11px;padding-top:10px;
  border-top:1px solid var(--border);font-size:10.5px;font-family:var(--font-mono);
  color:var(--fg-muted);min-height:20px}
.repo-card-foot .rc-lic{padding:1px 7px;border-radius:99px;border:1px solid var(--border);
  background:var(--bg-elev);color:var(--fg-dim);font-weight:600;letter-spacing:.02em;flex-shrink:0}
.repo-card-foot .rc-upd{display:inline-flex;align-items:center;gap:3px;white-space:nowrap}
.repo-card-foot .rc-upd svg{width:11px;height:11px}
.repo-card-foot .rc-upd.fresh{color:#2ea043}
html.light .repo-card-foot .rc-upd.fresh{color:#1a7f37}
.repo-card-foot .repo-card-link{margin-top:0;margin-left:auto;flex-shrink:0}
/* 仓库目录汇总条 + 排序段控件 */
.repo-summary{display:flex;align-items:center;flex-wrap:wrap;gap:10px 18px;
  margin:0 0 22px;padding:12px 16px;border:1px solid var(--border);border-radius:var(--radius);
  background:var(--bg-card)}
.repo-summary .rs-stats{display:flex;align-items:center;flex-wrap:wrap;gap:18px}
.repo-summary .rs-stat{font-size:12px;color:var(--fg-muted);display:inline-flex;align-items:baseline;gap:5px}
.repo-summary .rs-stat b{font-size:18px;font-weight:700;color:var(--fg);letter-spacing:-0.02em;font-family:var(--font-mono)}
.repo-summary .rs-star{color:var(--warn);display:inline-flex;align-self:center}
.repo-summary .rs-star svg{width:12px;height:12px}
.repo-summary .rs-sort{margin-left:auto;display:flex;align-items:center;gap:8px}
.repo-summary .rs-sort-label{font-size:11px;color:var(--fg-muted)}
.rs-sort-pills{display:inline-flex;gap:2px;background:var(--bg-elev);
  border:1px solid var(--border);border-radius:99px;padding:3px}
.rs-sort-pills button{display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;
  color:var(--fg-dim);font-size:11.5px;font-family:var(--font-sans);font-weight:500;cursor:pointer;
  padding:5px 11px;border-radius:99px;transition:background .14s,color .14s;white-space:nowrap}
.rs-sort-pills button:hover{color:var(--fg)}
.rs-sort-pills button.active{background:var(--grad);color:#fff}
.rs-sort-pills button svg{width:12px;height:12px;flex-shrink:0}
.rs-sort-pills button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
@media(max-width:760px){
  .repo-summary{gap:12px}
  .repo-summary .rs-stats{gap:14px}
  .repo-summary .rs-stat b{font-size:16px}
  .repo-summary .rs-sort{margin-left:0;width:100%}
  .rs-sort-pills{flex:1}
  .rs-sort-pills button{flex:1;min-width:0;overflow:hidden;justify-content:center;padding:7px 6px}
  .rs-sort-pills button span{overflow:hidden;text-overflow:ellipsis}
}

/* sidebar 仓库导航 */
.nav-repo-type{margin-bottom:6px}
.nav-repo-type-head{display:flex;align-items:center;gap:8px;padding:7px 10px;
  border-radius:6px;font-weight:600;font-size:12.5px;color:var(--fg);
  cursor:pointer;user-select:none;transition:background .12s}
.nav-repo-type-head:hover{background:var(--bg-card)}
.nav-repo-type-head .badge{margin-left:auto;background:var(--bg-card);
  color:var(--fg-muted);font-size:10px;padding:1px 6px;border-radius:9px;
  font-weight:500;font-family:var(--font-mono)}
.nav-repo-list{padding-left:14px;display:none}
.nav-repo-type.expanded .nav-repo-list{display:block}
.nav-repo-type-head .caret{display:inline-block;width:12px;font-size:10px;
  color:var(--fg-muted);transition:transform .15s}
.nav-repo-type.expanded .nav-repo-type-head .caret{transform:rotate(90deg)}
.nav-repo-item{display:block;padding:4px 10px;border-radius:5px;
  color:var(--fg-dim);font-size:11.5px;cursor:pointer;text-decoration:none;
  font-family:var(--font-mono);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.nav-repo-item:hover{background:var(--bg-card);color:var(--fg);
  text-decoration:none}
.nav-repo-item.active{color:var(--accent);background:rgba(124,156,255,.08)}

/* === ⌘K Spotlight === */
.spotlight-overlay{position:fixed;inset:0;background:rgba(0,0,0,.55);
  backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);
  z-index:300;display:flex;align-items:flex-start;justify-content:center;
  padding:90px 20px 20px;animation:fadeIn .15s}
.spotlight-modal{background:var(--bg-card);border:1px solid var(--border-strong);
  border-radius:14px;width:100%;max-width:640px;max-height:72vh;
  box-shadow:0 24px 64px rgba(0,0,0,.5);overflow:hidden;
  display:flex;flex-direction:column;
  animation:slideUp .2s cubic-bezier(.4,0,.2,1)}
.spotlight-input-wrap{position:relative;border-bottom:1px solid var(--border)}
.spotlight-input-wrap input{width:100%;background:transparent;border:0;
  padding:18px 56px 18px 50px;font-family:var(--font-sans);font-size:16px;
  color:var(--fg);outline:none;letter-spacing:-0.01em}
.spotlight-input-wrap input::placeholder{color:var(--fg-muted)}
.spotlight-input-wrap .icon{position:absolute;left:18px;top:50%;
  transform:translateY(-50%);font-size:18px;color:var(--fg-muted);
  pointer-events:none}
.spotlight-input-wrap .esc-hint{position:absolute;right:14px;top:50%;
  transform:translateY(-50%);font-family:var(--font-mono);font-size:11px;
  color:var(--fg-muted);background:var(--bg-elev);
  border:1px solid var(--border);padding:2px 8px;border-radius:5px;
  font-weight:600;letter-spacing:.04em}
.spotlight-list{overflow-y:auto;padding:6px;flex:1}
.spotlight-empty{padding:40px 24px;text-align:center;color:var(--fg-muted);
  font-size:13px}
.spotlight-section-label{font-family:var(--font-mono);font-size:10.5px;
  color:var(--fg-muted);padding:10px 12px 4px;letter-spacing:.05em;
  text-transform:uppercase;font-weight:600}
.spotlight-result{display:flex;align-items:center;gap:12px;
  padding:10px 12px;border-radius:8px;cursor:pointer;
  transition:background .08s}
.spotlight-result.active,.spotlight-result:hover{
  background:var(--grad-soft);
  outline:1px solid hsla(var(--cat-hue, 220), 60%, 60%, .25)}
.spotlight-result .sp-icon{flex-shrink:0;width:30px;height:30px;
  border-radius:7px;display:flex;align-items:center;justify-content:center;
  background:hsla(var(--cat-hue, 220), 60%, 55%, .15);
  border:1px solid hsla(var(--cat-hue, 220), 60%, 55%, .25);
  font-size:14px}
.spotlight-result .sp-body{flex:1;min-width:0}
.spotlight-result .sp-title{font-size:13.5px;font-weight:600;color:var(--fg);
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  letter-spacing:-0.01em}
.spotlight-result .sp-title .match{color:var(--accent);font-weight:700}
.spotlight-result .sp-meta{font-size:11px;color:var(--fg-muted);
  margin-top:2px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;
  font-family:var(--font-mono)}
.spotlight-result .sp-kind{flex-shrink:0;font-family:var(--font-mono);
  font-size:10px;color:var(--fg-muted);background:var(--bg-elev);
  border:1px solid var(--border);padding:2px 8px;border-radius:99px;
  font-weight:600;text-transform:uppercase;letter-spacing:.04em}
.spotlight-footer{display:flex;align-items:center;gap:14px;
  padding:8px 14px;border-top:1px solid var(--border);
  font-family:var(--font-mono);font-size:10.5px;color:var(--fg-muted);
  background:var(--bg-elev)}
.spotlight-footer kbd{background:var(--bg-card);border:1px solid var(--border);
  padding:1px 6px;border-radius:4px;font-size:10px;font-weight:600;
  color:var(--fg-dim)}

@media(max-width:640px){
  .spotlight-overlay{padding:40px 12px 12px}
  .spotlight-modal{max-height:84vh}
}
</style>
</head>
<body>
<div class="app" id="app">
<aside class="sidebar" id="sidebar">
  <div class="sidebar-head">
    <h1>🗺️ Skills Atlas</h1>
    <button class="sidebar-toggle" id="sidebarToggle" title="收起目录" aria-label="收起目录" data-i18n-title="tt_sidebar_collapse" data-i18n-aria="tt_sidebar_collapse">
      <svg viewBox="0 0 24 24"><polyline points="15 6 9 12 15 18"/></svg>
    </button>
  </div>
  <div class="subtitle" data-i18n="subtitle">按功能分类 · AI Agent Skills 全景</div>
  <div class="sidebar-settings">
    <button class="theme-toggle js-theme" id="themeToggleSb"></button>
    <button class="theme-toggle js-lang" id="langToggleSb" title="Switch language">EN</button>
  </div>
  <div class="stat-row" id="statRow"></div>
  <div class="search-wrap">
    <span class="search-icon">⌕</span>
    <input id="search" placeholder="搜 skill / 描述 / 仓库" data-i18n-ph="searchPh" autocomplete="off" />
    <span class="kbd-hint" id="kbdHint">/</span>
    <button class="clear-btn" id="clearBtn" aria-label="clear">×</button>
  </div>
  <div class="search-result-count" id="searchResultCount"></div>
  <button class="share-link-btn hidden" id="shareLink" data-i18n="btn_share" data-i18n-title="tt_share" title="复制当前筛选结果的链接">🔗 复制结果链接</button>
  <nav id="nav"></nav>
</aside>
<button class="sidebar-rail" id="sidebarRail" title="展开目录" aria-label="展开目录" data-i18n-title="tt_sidebar_expand" data-i18n-aria="tt_sidebar_expand">
  <svg viewBox="0 0 24 24"><polyline points="9 6 15 12 9 18"/></svg>
</button>
<div class="sidebar-backdrop" id="sidebarBackdrop" aria-hidden="true"></div>

<main class="main">
  <div class="toolbar">
    <button class="menu-btn" id="menuBtn" aria-label="菜单" data-i18n-aria="tt_menu"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
    <div class="view-switch" id="viewSwitch">
      <button class="view-btn active" data-view="cards" title="按功能视图" data-i18n-title="tt_view_cards"><span class="vb-emoji" aria-hidden="true">🗂️</span><span class="vb-label" data-i18n="view_cards">功能</span></button>
      <button class="view-btn" data-view="repo" title="按仓库视图" data-i18n-title="tt_view_repo"><span class="vb-emoji" aria-hidden="true">📦</span><span class="vb-label" data-i18n="view_repo">仓库</span></button>
      <button class="view-btn" data-view="graph" title="网络视图" data-i18n-title="tt_view_graph"><span class="vb-emoji" aria-hidden="true">🌐</span><span class="vb-label" data-i18n="view_graph">网络</span></button>
    </div>
    <span class="tb-divider" aria-hidden="true"></span>
    <div class="tb-filters">
      <span class="pill active" data-filter="all" data-i18n="f_all">全部</span>
      <span class="pill" data-filter="chain" data-i18n="f_chain" data-i18n-title="tt_chain" title="强绑定：需按顺序串起来用">⛓ 强绑定</span>
    </div>
    <div class="tb-sort" id="cardSort" role="group" aria-label="排序">
      <span class="tb-sort-label" data-i18n="sort_label">排序</span>
      <button class="cs-btn active" data-sort="default" data-i18n="sort_default">默认</button>
      <button class="cs-btn" data-sort="stars" data-i18n="sort_stars">最热</button>
      <button class="cs-btn" data-sort="recent" data-i18n="sort_recent">最近更新</button>
    </div>
    <div class="spacer"></div>
    <button class="theme-toggle" id="spotlightBtn" title="Spotlight 搜索 (⌘K / Ctrl+K)" data-i18n-title="tt_search"><svg class="tb-search-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg><span data-i18n="btn_search">搜索</span> <kbd class="ai-kbd">⌘K</kbd></button>
    <button class="ai-btn" id="aiBtn" title="AI 推荐" data-i18n-title="tt_ai"><span class="aib-emoji" aria-hidden="true">✨</span><span class="aib-lbl" data-i18n="btn_ai">AI 推荐</span></button>
    <button class="theme-toggle js-lang" id="langToggle" title="Switch language">EN</button>
    <button class="theme-toggle js-theme" id="themeToggle">🌙 暗色</button>
  </div>
  <div class="hero">
    <div class="hero-text">
      <h2 data-i18n="hero_h2">按功能分类的 AI Agent Skills 全景</h2>
      <p class="hero-definition" data-i18n="hero_def">Agent Skill 是 Claude Code 里可复用的「能力包」——装一次，之后像 /写PRD 这样按斜杠命令调用。</p>
      <p data-i18n="hero_p">按「我要做什么」找到对的 AI Agent Skill —— 点开即看完整 SKILL.md、一键复制安装命令。⛓ 标记的是必须串起来用的工作流。</p>
      <div class="hero-stats">
        <div><b id="heroSkillCount">—</b><span data-i18n="stat_skill">独立 skill</span></div>
        <div><b id="heroGroupCount">—</b><span data-i18n="stat_group">功能分组</span></div>
        <div><b id="heroVendorCount">—</b><span data-i18n="stat_vendor">源仓库</span></div>
        <div><b id="heroChainCount">—</b><span data-i18n="stat_chain">强绑定工作流</span></div>
      </div>
      <div class="hero-start">
        <span class="hero-start-q" data-i18n="hs_q">不知从哪开始？</span>
        <button class="start-chip start-chip-learn" data-start="learn" data-i18n="hs_learn">👋 新手必看</button>
        <button class="start-chip start-chip-ai" data-start="ai" data-i18n="hs_ai">✨ 描述需求，AI 推荐</button>
        <button class="start-chip" data-start="browse" data-i18n="hs_browse">📂 浏览全部大类</button>
        <span class="hero-start-eg" data-i18n="hs_eg">例：「快速搭 SaaS 落地页」「给项目写 PRD」「自动化网页抓取」</span>
      </div>
    </div>
    <div class="hero-viz">
      <div id="heroMap" class="hero-map" role="img" aria-label="Skills by category"></div>
      <div class="hero-map-cap" data-i18n="map_cap">按领域浏览 · 点击色块跳到该分类</div>
    </div>
    <button id="heroToggle" class="hero-toggle" aria-label="collapse" title="收起 / 展开" data-i18n-title="tt_hero_toggle">▾</button>
  </div>
  <div id="content"></div>
  <div id="repoView" class="hidden repo-view"></div>
  <div id="graphView" class="hidden graph-view"></div>
  <div class="empty-state hidden" id="emptyState">
    <div class="big" aria-hidden="true">🤔</div>
    <div data-i18n="empty">没有匹配的 skill，试试别的关键词</div>
  </div>
  <footer class="site-footer">
    <span class="sf-brand">🗺️ Skills Atlas</span>
    <span class="sf-sep" aria-hidden="true">·</span>
    <span data-i18n="footer_tag">社区整理的 AI Agent Skills 目录，非官方</span>
    <span class="sf-sep" aria-hidden="true">·</span>
    <a class="sf-learn" href="#" data-i18n="footer_learn">新手必看：什么是 Skill</a>
    <span class="sf-sep" aria-hidden="true">·</span>
    <a href="https://github.com/Zita-Go/Skills-Atlas" target="_blank" rel="noopener">GitHub ↗</a>
    <span class="sf-sep" aria-hidden="true">·</span>
    <span class="sf-note" data-i18n="footer_license">站点 MIT；每个 skill 保留其上游许可证，安装前请在卡片上核对</span>
  </footer>
</main>

<button id="toTop" class="to-top" aria-label="回到顶部" title="回到顶部">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V6M6 12l6-6 6 6"/></svg>
</button>

<!-- 新手必看：Agent Skill 是什么 / 怎么用 -->
<div class="ai-overlay hidden" id="howtoOverlay">
