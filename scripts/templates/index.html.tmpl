// === 锚点跳转 / 浏览器历史 ===
// hash 里是 URL 编码的中文 slug，必须 decode 才能匹配元素 id / data-target
function hashId(){
  try{ return decodeURIComponent((location.hash || '').slice(1)); }
  catch(_){ return (location.hash || '').slice(1); }
}
// 把一次跳转写入浏览器历史（同一目标不重复入栈），供 nav / spotlight 调用
function pushHash(id){
  if(hashId() !== id){ history.pushState(null, '', '#' + id); }
}
function jumpOffsetPx(){
  return parseInt(getComputedStyle(document.documentElement).getPropertyValue('--jump-offset')) || 80;
}
// 跳转到某元素，落点对齐 sticky 顶栏下方（--jump-offset）。
// 关键：不能用原生 scrollIntoView / scrollTo({behavior:'smooth'}) —— 平滑动画跨多帧，而
// 动画途中布局会变（hero 折叠的 padding 过渡、Web 字体回流、scroll-spy 展开侧栏），原生平滑
// 锁定的是动画开始时算好的旧目标偏移，于是过冲 / 不到位（实测落点偏差可达数千 px，标题被划出
// 视口或埋到顶栏后；深链路径用 'auto' 瞬时跳所以一直是对的）。
// 解法：自实现 rAF 平滑，每帧用元素「实时」位置重算目标、跟住布局变化，收尾再精确吸附。
function smoothScrollToEl(el, behavior){
  if(!el) return;
  const hero = document.querySelector('.hero');
  const willCollapse = hero && !hero.classList.contains('collapsed') && !hero.classList.contains('hidden');
  if(willCollapse) hero.classList.add('collapsed');
  const targetY = () => Math.max(0, el.getBoundingClientRect().top + window.scrollY - jumpOffsetPx());
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(behavior === 'auto' || reduce){
    requestAnimationFrame(() => window.scrollTo(0, targetY()));   // 等 hero 收起的回流定下来再瞬时定位
    return;
  }
  const startY = window.scrollY, dur = 380;
  let startT = null;
  function frame(now){
    if(startT === null) startT = now;
    const p = Math.min(1, (now - startT) / dur);
    const e = p < 0.5 ? 2*p*p : 1 - Math.pow(-2*p + 2, 2) / 2;   // easeInOutQuad
    window.scrollTo(0, startY + (targetY() - startY) * e);        // 目标逐帧重算
    if(p < 1) requestAnimationFrame(frame);
    else window.scrollTo(0, targetY());                           // 收尾精确吸附
  }
  requestAnimationFrame(frame);
}
// 滚到当前 hash 对应的小节（前进/后退、深链都走这里）
function scrollToHashTarget(behavior){
  const id = hashId();
  if(!id){ window.scrollTo({top:0, behavior: behavior || 'auto'}); return; }
  const el = document.getElementById(id);
  if(!el) return;
  const navH2 = document.querySelector(`.nav-h2[data-target="${id}"]`);
  if(navH2){
    const section = navH2.closest('.nav-section');
    if(section) section.classList.add('expanded');
  }
  smoothScrollToEl(el, behavior || 'auto');
}
// 自己管理滚动，避免浏览器默认恢复跟 JS 平滑滚动打架
if('scrollRestoration' in history){ history.scrollRestoration = 'manual'; }
// 前进/后退：滚回对应小节（这就是"按后退回到刚才看的小节"）
window.addEventListener('popstate', () => scrollToHashTarget('smooth'));
// 深链 / 刷新：进页面后定位到 hash 小节
if(location.hash){ requestAnimationFrame(() => scrollToHashTarget('auto')); }

// 图视图深链还原：?view=graph/repo & gfilter=... & gnode=...（可分享/刷新保持）
(function restoreGraphFromURL(){
  const sp = new URLSearchParams(location.search);
  const v = sp.get('view'), gf = sp.get('gfilter'), gn = sp.get('gnode'), q = sp.get('q');
  if(gf === 'chain'){
    const pill = document.querySelector(`.toolbar .pill[data-filter="chain"]`);
    if(pill) pill.click();   // 设过滤 + 应用（卡片或图）
  }
  if(v === 'graph' || v === 'repo'){
    const btn = document.querySelector(`#viewSwitch .view-btn[data-view="${v}"]`);
    if(btn) btn.click();     // 切视图（graph 会 buildGraph 并设置 graphOpenNodeFn）
  }
  if(q){   // 还原搜索词（分享链接），走与输入框一致的检索管道
    const inp = document.getElementById('search');
    if(inp){ inp.value = q; inp.dispatchEvent(new Event('input', { bubbles: true })); }
  }
  if(v === 'graph' && gn){
    requestAnimationFrame(() => { if(graphOpenNodeFn) graphOpenNodeFn(gn); });
  }
})();
